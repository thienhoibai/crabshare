# Git tự chuẩn hoá xuống dòng cho file văn bản
* text=auto

# Nội dung đã băm SHA-256 trong V002 → phải giữ LF để hash không đổi giữa các máy
database/reference/*.md text eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf
*.sln  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.onnx binary
