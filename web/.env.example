# Chép file này thành .env.local rồi sửa nếu API chạy ở cổng khác
VITE_API_URL=http://localhost:5233
# Email liên hệ mà nhóm đã chọn công khai ở chân trang.
VITE_TEAM_CONTACT_EMAIL=
# Mô hình 3D nhúng ở mục Công nghệ của trang chủ; để trống thì dùng bản đã triển khai.
VITE_TWIN_URL=
# OAuth 2.0 Web Client ID trên Google Cloud Console; để trống thì ẩn nút đăng nhập Google.
VITE_GOOGLE_CLIENT_ID=
