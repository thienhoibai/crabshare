w=block;endFill=1;strokeColor=#64748b;fontColor=#64748b;dashed=1;dashPattern=6 4;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.8473;exitY=0.8597;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8685;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sys" target="customer"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f36" value="Identity Evidence" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.3095;exitY=0.9623;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2105;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sys" target="ekyc"><mxGeometry x="0.0465" relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="1060"/><mxPoint x="330" y="1060"/></Array></mxGeometry></mxCell><mxCell id="f37" value="Identity Verification Result" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.6842;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3524;entryY=0.9777;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ekyc" target="sys"><mxGeometry x="-0.1327" relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="1082"/><mxPoint x="698" y="1082"/></Array></mxGeometry></mxCell><mxCell id="f38" value="Contract Document" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.3952;exitY=0.9889;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2143;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sys" target="dss"><mxGeometry x="0.2808" relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="1104"/><mxPoint x="545" y="1104"/></Array></mxGeometry></mxCell><mxCell id="f39" value="Signed Contract" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.5952;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4381;entryY=0.9962;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dss" target="sys"><mxGeometry x="-0.4777" relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="1126"/><mxPoint x="734" y="1126"/></Array></mxGeometry></mxCell><mxCell id="f40" value="Batch Account &amp;amp; Payment Requests" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.5238;exitY=0.9994;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2083;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sys" target="psp"><mxGeometry x="0.3467" relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="1126"/><mxPoint x="990" y="1126"/></Array></mxGeometry></mxCell><mxCell id="f41" value="Transaction &amp;amp; Payout Results" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5667;entryY=0.9955;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="psp" target="sys"><mxGeometry x="-0.2153" relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1104"/><mxPoint x="788" y="1104"/></Array></mxGeometry></mxCell><mxCell id="f42" value="Disbursement, Payout &amp;amp; Refund Instructions" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.6095;exitY=0.9879;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7917;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sys" target="psp"><mxGeometry x="0.1139" relative="1" as="geometry"><Array as="points"><mxPoint x="806" y="1082"/><mxPoint x="1130" y="1082"/></Array></mxGeometry></mxCell><mxCell id="f43" value="Box Photos, Feeding &amp;amp; Box Events «planned»" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#64748b;fontColor=#64748b;dashed=1;dashPattern=6 4;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;exitX=0.2069;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6524;entryY=0.9762;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dev" target="sys"><mxGeometry x="-0.0314" relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="1060"/><mxPoint x="824" y="1060"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Notes&lt;/b&gt; — DFD level 0, drawn as in the team's hand drawing. Solid arrow: information package handled by the current code. Dashed grey arrow or box with «planned»: in Register v1.4, not built yet; &quot;(… «planned»)&quot; marks the part of a package that is not built yet. Each arrow is one direction and one information package; packages never connect two external entities. &lt;b&gt;Packages&lt;/b&gt;: Production &amp;amp; Evidence Data = daily logs, box events, live photos, explanations · Approval Decisions = operator, Batch (Standard Cost, floor price, remuneration tiers), KYC exception, milestone tranche · Alerts, Capture Requests &amp;amp; Evidence Notices = production alerts, random capture requests, flagged-evidence notices · Pre-order Book &amp;amp; Statements = bulk pre-orders to deliver, disbursement and settlement statements · Receipt, Return, Complaint &amp;amp; Rating = receipt confirmation, return request, complaint, order rating · Batch Proposal = Standard Cost, box rows of the Batch (grouped by the boxes' row codes, one investor per row), price per kg, floor price, survival threshold with remuneration tiers, delivery radius · Deposit Refund &amp;amp; Forfeit Advice = every deposit refunded when the Batch does not open; a deposit forfeited when the Customer cancelled after paying and the Batch opened, or refuses delivery or does not pay the balance. The full Entity – Information Sent – Information Received table is in the SRS. The farm devices and cameras are simulated and post their data through one common data channel; there is no per-farm software integration. The Price Dataset (interviewed farm, dated press reports, simulated data) feeds the price module, which shows the Operator a price range with a warning and never an expected return; who loads it is assumed (Platform Administrator) and needs confirmation. Farmers, carriers and the committed buyer of the final order exchange nothing directly with CrabShare, so they are not drawn.&lt;br&gt;&lt;b&gt;Removed in v1.4 (still in code)&lt;/b&gt;: Offtake Commitment, Offtake Claim, Product Listing, Product Catalogue, retail Order, Tag Scan and tag-scan packing; the Farm Management System is replaced by the simulated devices.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1226" width="1470" height="174" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>