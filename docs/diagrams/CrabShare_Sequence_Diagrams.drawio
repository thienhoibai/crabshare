row=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="555" y="550" as="sourcePoint"/><mxPoint x="345" y="550" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="36" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="970" y="612" width="10" height="22" as="geometry"/></mxCell><mxCell id="37" value="&lt;font style=&quot;font-size:11px&quot;&gt;Calculate(input) — SettlementInput(actualRevenue, lockedStandardCost, operatorSharePct, taxWithholdingPct, shares[]) + survivalRatePct, remunerationTiers «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="616" as="sourcePoint"/><mxPoint x="975" y="616" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="38" value="&lt;font style=&quot;font-size:11px&quot;&gt;RemunerationPct(survivalRatePct, tiers) — full % at or above the threshold, cut by tier below it «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;edgeStyle=orthogonalEdgeStyle;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="644" as="sourcePoint"/><mxPoint x="980" y="668" as="targetPoint"/><Array as="points"><mxPoint x="1035" y="644"/><mxPoint x="1035" y="668"/></Array></mxGeometry></mxCell><mxCell id="39" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strok