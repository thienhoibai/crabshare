ffset"/></mxGeometry></mxCell><mxCell id="18" value="&lt;font style=&quot;font-size:11px&quot;&gt;400 trace.invalid_code | 404 trace.not_found «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="555" y="354" as="sourcePoint"/><mxPoint x="345" y="354" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="19" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="416" width="10" height="22" as="geometry"/></mxCell><mxCell id="20" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;CrabItem&amp;gt;().Where(OrderId).Include(SlotAllocation).ToListAsync() — the boxes of the order «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="420" as="sourcePoint"/><mxPoint x="765" y="420" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="21" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="10" height="22" as="geometry"/></mxCell><mxCell id="22" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;HarvestRecord&amp;gt;().Where(crabs of the order).ToListAsync() — weight, grade, shell condition, recorded_at «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="448" as="sourcePoint"/><mxPoint x="765" y="448" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="23" value="&lt;font style=&quot;font-size:11px&quot;&gt;OrderTraceResponse (farm, Batch, boxes, harvest record; no personal data, no prices) — 200, no-store «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="555" y="476" as="sourcePoint"/><mxPoint x="345" y="476" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="24" value="&lt;b&gt;Figure 4.53 – Sequence Diagram: UC33 Trace Order by QR Code — farm, Batch, boxes and harvest record of a delivered order (public)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · new «planned» · replaces v2.0 Figure 4.56 (removed in v1.4) · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1020" height="42" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC33 · owner: Viên · new «planned»&lt;br&gt;• UC33 «planned» in v1.4: one QR per delivery order, issued when the Operator prepares the delivery note (Figure 4.57); the boxes are found through CrabItem.OrderId «planned». Traceability is still pending confirmation by Viên and Nhân.&lt;br&gt;• Removed in v1.4 (still in code): per-crab tag trace — TraceController.Get(tag) → TraceService.GetAsync(code) over crab_tag, tag_scan and v_traceability (v2.0 Figure 4.56)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="594" width="1000" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC49 Price range suggestion" id="UC49_Price_range_suggestion"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Operator Owner" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="646" as="geometry"/></mxCell><mxCell id="c3" value="«controller» «planned»&lt;br&gt;&lt;b&gt;:PriceSuggestionsController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;dashed=1;strokeColor=#64748b;fontColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="190" height="646" as="geometry"/></mxCell><mxCell id="c4" value="«service» «planned»&lt;br&gt;&lt;b&gt;:PriceSuggestionService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeC