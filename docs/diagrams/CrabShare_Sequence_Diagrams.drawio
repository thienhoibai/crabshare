try></mxCell><mxCell id="23" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="760" y="512" width="10" height="22" as="geometry"/></mxCell><mxCell id="24" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — batch → Funding (window, fee tier, platform fee, approved_at / by); cost version → Locked (locked_at)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="345" y="516" as="sourcePoint"/><mxPoint x="765" y="516" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="25" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="540" width="10" height="22" as="geometry"/></mxCell><mxCell id="26" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — PricePerKgVnd and FloorPriceVnd locked with the Standard Cost «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="345" y="544" as="sourcePoint"/><mxPoint x="765" y="544" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="27" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="550" y="568" width="10" height="22" as="geometry"/></mxCell><mxCell id="28" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;batch&quot;, id, &quot;approve&quot;, before, after, now)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="345" y="572" as="sourcePoint"/><mxPoint x="555" y="572" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="550" y="596" width="10" height="22" as="geometry"/></mxCell><mxCell id="30" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;batch_account&quot;, id, &quot;create&quot;) — only when opened now&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="345" y="600" as="sourcePoint"/><mxPoint x="555" y="600" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="31" value="&lt;font style=&quot;font-size:11px&quot;&gt;AdminBatchResponse (Funding)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="628" as="sourcePoint"/><mxPoint x="135" y="628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="RequestRevision(code, req) → Draft with a reason; Reject(code, req) → Rejected. TrancheScheduleJob later resolves relative tranche dates." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="676" width="950" height="34" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;Figure 4.46 (2/2) – Sequence Diagram: UC08 Review and Approve Batch — lock Standard Cost with price per kg and floor price, approve tiers, open batch account, plan tranches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.50 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1070" height="61" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC08 · owner: Viên · modified for v1.4&lt;br&gt;• v1.4: the Standard Cost is locked when funding opens, together with the price per kg and the floor price; the admin approves the floor price and the remuneration tiers. ApproveSalesTerms and the locked sales terms are «planned».&lt;br&gt;• Removed in v1.4 (still in code): the per-grade offtake price required at approval (422 batch.offtake_price_required).&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="1050" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC09 Explore offerings" id="UC09_Explore_offerings"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="