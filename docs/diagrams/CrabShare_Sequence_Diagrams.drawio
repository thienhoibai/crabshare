le="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="760" y="238" width="10" height="22" as="geometry"/></mxCell><mxCell id="11" value="&lt;font style=&quot;font-size:11px&quot;&gt;CompleteDueAsync() — every minute&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="242" as="sourcePoint"/><mxPoint x="765" y="242" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="130" y="266" width="10" height="22" as="geometry"/></mxCell><mxCell id="13" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;SalesOrder&amp;gt;().Where(Delivered, return window ended, no active complaint).ToListAsync() — at most 200&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="270" as="sourcePoint"/><mxPoint x="135" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="332" width="10" height="22" as="geometry"/></mxCell><mxCell id="15" value="&lt;font style=&quot;font-size:11px&quot;&gt;LockAsync()&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="336" as="sourcePoint"/><mxPoint x="345" y="336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="130" y="360" width="10" height="22" as="geometry"/></mxCell><mxCell id="17" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;SalesOrder&amp;gt;().Where(id, Delivered).ExecuteUpdateAsync(Completed, completed_at) — DeliveredOrder revenue (Figure 4.40)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="765" y="364" as="sourcePoint"/><mxPoint x="135" y="364" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="18" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="388" width="10" height="22" as="geometry"/></mxCell><mxCell id="19" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;sales_order&quot;, id, &quot;complete&quot;)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="392" as="sourcePoint"/><mxPoint x="345" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="&lt;b&gt;Figure 4.57 (4/4) – Sequence Diagram: UC29, UC30 Deliver Order and Record Weighed Quantity; Confirm Receipt and Pay Balance — delivery note with the order QR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.61 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1020" height="61" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC29, UC30 · owner: Nhân · modified for v1.4&lt;br&gt;• Not on develop @ 420a379 («planned»): AssignBoxesAsync, IssueOrderQrAsync (QR issued when the Operator prepares the delivery note), the weighed DeliverAsync(orderNo, req), IssueBalanceAsync and the weighed columns; boxes are linked by CrabItem.OrderId. Today DeliverAsync(orderNo) has no weight and PreOrderBalanceHandler turns DepositPaid into Paid.&lt;br&gt;• Balance = weighedKg × price per kg − deposit (example: 15 kg × 420,000 = 6,300,000 VND of goods, minus the deposit); weighedKg counts only the live crabs the Customer accepts, transitLossKg is recorded but not subtracted again, and a negative result is refunded.&lt;br&gt;• Removed in v1.4 (still in code): PackAsync(orderNo, tagCodes) — packing by scanning crab tags — and the balance issued at harvest by PreorderBalanceService (v2.0 Figure 4.61). Vehicle dispatch is out of scope: only the delivered status is recorded.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1000" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC55 UC54 Cancel &amp; forfeit deposit (1 of 3)" id="UC55_UC54_Cancel__amp__forfeit_deposit__1_of_3_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" 