="1" relative="1" as="geometry"><mxPoint x="345" y="794" as="sourcePoint"/><mxPoint x="135" y="794" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="41" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="842" width="1180" height="32" as="geometry"/></mxCell><mxCell id="42" value="&lt;font style=&quot;font-size:11px&quot;&gt;continues in part 3/3 of Figure 4.40&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="844" width="1100" height="28" as="geometry"/></mxCell><mxCell id="43" value="&lt;b&gt;Figure 4.40 (2/3) – Sequence Diagram: UC38 Run Settlement Calculation — four revenue sources, Revenue Pool, survival rate and remuneration tier, largest-remainder lines, loss cap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.44 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="61" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC38 Run settlement calculation (3 of 3)" id="UC38_Run_settlement_calculation__3_of_3_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Platform Administrator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="282" as="geometry"/></mxCell><mxCell id="c3" value="«controller»&lt;br&gt;&lt;b&gt;:AdminSettlementsController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="190" height="282" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;alt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="236" width="400" height="72" as="geometry"/></mxCell><mxCell id="5" value="&lt;font style=&quot;font-size:11px&quot;&gt;[ok] (continued)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="116" y="236" width="120" height="24" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="520" height="32" as="geometry"/></mxCell><mxCell id="7" value="&lt;font style=&quot;font-size:11px&quot;&gt;continued from part 2/3 of Figure 4.40&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="440" height="28" as="geometry"/></mxCell><mxCell id="8" value="&lt;font style=&quot;font-size:11px&quot;&gt;200 — amounts only, never an expected return or yield (BR-49)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="345" y="280" as="sourcePoint"/><mxPoint x="135" y="280" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="9" value="&lt;b&gt;Figure 4.40 (3/3) – Sequence Diagram: UC38 Run Settlement Calculation — four revenue sources, Revenue Pool, survival rate and remuneration tier, largest-remainder lines, loss cap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.44 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1020" height="61" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC38 · owner: Thiện · modified for v1.4&lt;br&gt;• Worked example (Register v1.4): revenue 300,000,000 = delivered 190,000,000 + invoiced sale (low-grade) 10,000,000 + forfeited deposit 6,000,000 + final order 94,000,000; locked Standard Cost 100,000,000 → Pool 200,000,000; survival 90 % ≥ 85 % → remuneration 10 % = 20,000,000; A 42,000,000, B 42,000,000, C 196,000,000. At 80 % survival the remuneration halves to 10,000,000.&lt;br&gt;• Not on develop @ 420a379: RevenueLine, RemunerationTier, RevenueLinesAsync, SurvivalRateAsync and RemunerationPct («planned»); the code applies a fixed operator_share_pct (5–10 %) and reads one total from v_batch_actual_revenue. RevenueLine type InvoicedSale covers both the low-grade sale and the resale after a forfeit (saleReason LowGrade | ForfeitResale).&lt;br&gt;• Survival rate = 1 − deaths in the cycle ÷ crabs first stocked in the funded boxes (restocked crabs that die count as deaths; transit deaths only lower revenue) and picks the remuneration tier; settlement always subtracts the full locked Standard Cost of the funded boxes — savings, including the unused mortality reserve, stay with the Operator and are not added to the Pool; unspent capital is returned only on early liquidation.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="1000" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC37 UC35 UC36 Proposal &amp; feedback (1 of 2)" id="UC37_UC35_UC36_Proposal__amp__feedback__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Platform Administrator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="838" as="geometry"/></mxCell><mxCell id="c3" value="Investor" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="325" y="96" width="40" height="838" as="geometry"/></mxCell><mxCell id="c4" value="«controller»&lt;br&gt;&lt;b&gt;:SettlementsController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="190" height="838" as="geometry"/></mxCell><mxCell id="c5" value="«service»&lt;br&gt;&lt;b&gt;:SettlementReviewService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="96" width="190" height="838" as="geometry"/></mxCell><mxCell id="c6" value="«service»&lt;br&gt;&lt;b&gt;:SettlementService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="96" width="190" height="838" as="geometry"/></mxCell><mxCell id="c7" value="«persistence»&lt;br&gt;&lt;b&gt;:AppDbContext&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#f1f5f9;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="96" width="190" height="838" as="geometry"/></mxCell><mxCell id="c8" val