48b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="280" as="sourcePoint"/><mxPoint x="765" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="550" y="342" width="10" height="22" as="geometry"/></mxCell><mxCell id="19" value="&lt;font style=&quot;font-size:11px&quot;&gt;RefuseDelivery(orderNo, req) · POST /api/orders/{orderNo}/refused {reason} «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="345" y="346" as="sourcePoint"/><mxPoint x="555" y="346" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="20" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="10" height="22" as="geometry"/></mxCell><mxCell id="21" value="&lt;font style=&quot;font-size:11px&quot;&gt;ForfeitAsync(orderNo, &quot;refused_delivery&quot;) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="374" as="sourcePoint"/><mxPoint x="765" y="374" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="22" value="ForfeitAsync(orderNo, reason) runs the same steps for both callers; an unpaid or already forfeited deposit is refused (409 order.already_forfeited «planned»)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="422" width="1160" height="34" as="geometry"/></mxCell><mxCell id="23" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="970" y="470" width="10" height="22" as="geometry"/></mxCell><mxCell id="24" value="&lt;font style=&quot;font-size:11px&quot;&gt;InTransactionAsync(work) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="474" as="sourcePoint"/><mxPoint x="975" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1180" y="498" width="10" height="22" as="geometry"/></mxCell><mxCell id="26" value="&lt;font style=&quot;font-size:11px&quot;&gt;LockAsync() «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="502" as="sourcePoint"/><mxPoint x="1185" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="970" y="526" width="10" height="22" as="geometry"/></mxCell><mxCell id="28" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;SalesOrder&amp;gt;().Include(PaymentRequests).SingleOrDefaultAsync(orderNo) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="765" y="530" as="sourcePoint"/><mxPoint x="975" y="530" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="970" y="554" width="10" height="22" as="geometry"/></mxCell><mxCell id="30" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — order → Forfeited, ForfeitedAt; the deposit stays in the batch account; a Pending balance request → Cancelled «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="765" y="558" as="sourcePoint"/><mxPoint x="975" y="558" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="31" value="&lt;font style=&quot;font-size:11px&quot;&gt;ReleaseBoxesForResaleAsync(order) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;edgeStyle=orthogonalEdgeStyle;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="624" as="sourcePoint"/><mxPoint x="770" y="648" as="targetPoint"/><Array as="points"><mxPoint x="825" y="624"/><mxPoint x="825" y="648"/></Array></mxGeometry></mxCell><mxCell id="32" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="622" width="10" height="30" as="geometry"/></mxCell><mxCell id="33" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="970" y="662" width="10" height="22" as="geometry"/></mxCell><mxCell id="34" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;CrabItem&amp;gt;().Where(order, Packed).ExecuteUpdateAsync(InStock, OrderId cleared) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="765" y="666" as="sourcePoint"/><mxPoint x="975" y="666" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="35" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="714" width="1180" height="32" as="geometry"/></mxCell><mxCell id="36" value="&lt;font style=&quot;font-size:11px&quot;&gt;continues in part 3/3 of Figure 4.58&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="716" width="1100" height="28" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;Figure 4.58 (2/3) – Sequence Diagram: UC55, UC54 Cancel Bulk Pre-order and Forfeit Deposit («extend» of UC27 / UC30) — (d) cancelled before paying · (a) cancelled after paying, the Batch opens · (b) the Batch does not open · (c) delivery refused or balance unpaid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · new «planned» · new for Register v1.4 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="61" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC55 UC54 Cancel &amp; forfeit deposit (3 of 3)" id="UC55_UC54_Cancel__amp__forfeit_deposit__3_of_3_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="«service» «planned»&lt;br&gt;&lt;b&gt;:DepositForfeitService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;dashed=1;strokeColor=#64748b;fontColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="190" height="294" as="geometry"/></mxCell><mxCell id="c3" value="«interface»&lt;br&gt;&lt;b&gt;:IAuditLog&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#fef3c7;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="190" height="294" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="520" height="32" as="geometry"/></mxCell><mxCell id="5" value="&lt;font style=&quot;font-size:11px&quot;&gt;continued from part 2/3 of Figure 4.58&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="440" height="28" as="geometry"/></mxCell><mxCell id="6" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="340" y="238" width="10" height="22" as="geometry"/></mxCell><mxCell id="7" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;sales_order&quot;, id, &quot;forfeit&quot;) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="135" y="242" as="sourcePoint"/><mxPoint x="345" y="242" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="8" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="520" height="50" as="geometry"/></mxCell><mxCell id="9" value="&lt;font style=&quot;font-size:11px&quot;&gt;(c) the released crabs are resold through an invoiced sale with saleReason ForfeitResale (UC50, Figure 4.59); every forfeited deposit counts once as ForfeitedDeposit revenue (Figure 4.40)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="272" width="440" height="46" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Figure 4.58 (3/3) – Sequence Diagram: UC55, UC54 Cancel Bulk Pre-order and Forfeit Deposit («extend» of UC27 / UC30) — (d) cancelled before paying · (a) cancelled after paying, the Batch opens · (b) the Batch does not open · (c) delivery refused or balance unpaid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · new «planned» · new for Register v1.4 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1020" height="61" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC55, UC54 · owner: Nhân · new «planned»&lt;br&gt;• Deposit cases: (a) a Customer who cancels after paying the deposit loses it once the Batch opens, and the deposit becomes Batch revenue (RevenueLine ForfeitedDeposit); (b) if the Batch does not open, every deposit is refunded, including those of cancelled orders; (c) a Customer who refuses the delivery or does not pay the balance loses the deposit and the crabs are resold through an InvoicedSale (saleReason ForfeitResale); (d) cancelling before paying the deposit (PendingPayment) costs nothing.&lt;br&gt;• UC55 Cancel Bulk Pre-order (Customer or Investor; the code already cancels through OrderCancellationService) covers cases (d) and (a); UC54 Forfeit Deposit extends UC27 / UC30 and is the outcome of a late cancellation (UC55) or of a refused delivery or unpaid balance (UC30). DepositForfeitService, RefuseDelivery, the Forfeited status, ForfeitedAt and cancelling a DepositPaid order are «planned»; code @ 420a379 cancels only PendingPayment and Paid orders and has no pre-order forfeiture (v_batch_actual_revenue counts only offtake deposits with deposit_status = Forfeited, which no code path writes).&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1000" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC50 Invoiced sale (1 of 2)" id="UC50_Invoiced_sale__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Operator Owner" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="726" as="geometry"/></mxCell><mxCell id="c3" value="«controller» «planned»&lt;br&gt;&lt;b&gt;:InvoicedSalesController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;dashed=1;strokeColor=#64748b;fontColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="190" height="726" as="geometry"/></mxCell><mxCell id="c4" value="«service» «planned»&lt;br&gt;&lt;b&gt;:InvoicedSaleService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;dashed=1;strokeColor=#64748b;fontColor=#64748b;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="190" height="726" as="geometry"/></mxCell><mxCell id="c5" value="«interface»&lt;br&gt;&lt;b&gt;:IFileStorage&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#fef3c7;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="96" width="190" height="726" as="geometry"/></mxCell><mxCell id="c6" value="«service»&lt;br&gt;&lt;b&gt;:PaymentRequestService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="96" width="190" height="726" as="geometry"/></mxCell><mxCell id="c7" value="«persistence»&lt;br&gt;&lt;b&gt;:AppDbContext&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#f1f5f9;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="96" width="190" height="726" as="geometry"/></mxCell><mxCell id="c8" v