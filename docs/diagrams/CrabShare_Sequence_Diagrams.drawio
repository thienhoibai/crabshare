dgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="392" as="sourcePoint"/><mxPoint x="135" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="130" y="416" width="10" height="22" as="geometry"/></mxCell><mxCell id="25" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — RowAllocation Held → Allocated «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="420" as="sourcePoint"/><mxPoint x="135" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="444" width="10" height="22" as="geometry"/></mxCell><mxCell id="27" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;contribution&quot;, id, &quot;confirm&quot;)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="448" as="sourcePoint"/><mxPoint x="345" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="130" y="510" width="10" height="22" as="geometry"/></mxCell><mxCell id="29" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — provider transaction LatePayment; refund instruction by RefundService.CreateRefundAsync&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="514" as="sourcePoint"/><mxPoint x="135" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="558" width="10" height="22" as="geometry"/></mxCell><mxCell id="31" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;provider_transaction&quot;, id, &quot;receive&quot;)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="562" as="sourcePoint"/><mxPoint x="345" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="&lt;font style=&quot;font-size:11px&quot;&gt;WebhookResult(Matched)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="590" as="sourcePoint"/><mxPoint x="765" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="&lt;font style=&quot;font-size:11px&quot;&gt;200&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="618" as="sourcePoint"/><mxPoint x="555" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="the page polls PaymentsController.Get(id) → PaymentRequestService.GetMineAsync(id) and moves to &quot;Done&quot; when Paid. A transfer with a different amount stays Unmatched for manual reconciliation." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="646" width="1160" height="34" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;Figure 4.36 (5/5) – Sequence Diagram: UC10, UC11, UC12 Reserve Box Rows and Commit Capital — risk acknowledgement, reservation, contract step, VietQR, webhook confirmation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.40 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="61" as="geometry"/></mxCell><mxCell id="36" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC10, UC11, UC12 · owner: Thiện · modified for v1.4&lt;br&gt;• Wizard order in code (ContributePage): Risk → Amount → Contract → VietQR → Done. The contract step (Figure 4.37) and the payment can finish in either order; stocking needs both a Confirmed contribution and a fully signed contract.&lt;br&gt;• v1.4: investors pick box rows when reserving and later see box details only for their own rows (UC53, Figure 4.50); payment is made in full once, before the Batch opens. Contribution by box rows: amount = Σ (boxes of the row × Standard Cost per box); the minimum contribution is one row (the admin minimum stays as a floor for row capital, checked in UC07); each BoxRow belongs to the Batch, groups the allocated boxes by Box.RowCode and has no status of its own; it has at most one Held or Allocated RowAllocation — Held during the 30-minute reservation, Allocated when the contribution is Confirmed, Released when it expires or is refunded. Not on develop @ 420a379: rowCodes, BoxRow / RowAllocation, AllocateRowsAsync and the row errors («planned»).&lt;br&gt;• The reservation lasts Funding:ReservationMinutes = 30 (appsettings.json), capped at the funding deadline.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="1260" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC14 Sign contract (1 of 4)" id="UC14_Sign_contract__1_of_4_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Investor" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="708" as="geometry"/></mxCell><mxCell id="c3" value="«controller»&lt;br&gt;&lt;b&gt;:ContractsController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y