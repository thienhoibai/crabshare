ue="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — harvest → Completed, completed_at / by, revision + 1&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="672" as="sourcePoint"/><mxPoint x="975" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="760" y="696" width="10" height="22" as="geometry"/></mxCell><mxCell id="34" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;harvest&quot;, id, &quot;complete&quot;, before, after)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="700" as="sourcePoint"/><mxPoint x="765" y="700" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="35" value="&lt;font style=&quot;font-size:11px&quot;&gt;HarvestResponse (grade summaries)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="728" as="sourcePoint"/><mxPoint x="345" y="728" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="&lt;b&gt;Figure 4.52 (3/3) – Sequence Diagram: UC22 Record Harvest per Box — open a session, weigh and grade each box, complete and reconcile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.54 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1070" height="42" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC22 · owner: Viên · modified for v1.4&lt;br&gt;• v1.4: harvested boxes are assigned to delivery orders (UC29, Figure 4.57) and the order QR traces the Batch and its boxes (UC33, Figure 4.53). Each crab lives in its own numbered box, so one record per box = one record per crab.&lt;br&gt;• Removed in v1.4 (still in code): RecordAsync also prints a per-crab tag (IHarvestTagCodeGenerator.NewCode → crab_tag Printed, crab_item_event TagPrinted; harvest_record.tag_id / tag_code NOT NULL in V016) and CompleteAsync calls CatalogService.SyncHarvestStockAsync to refresh listings." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="1050" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC33 Trace order by QR" id="UC33_Trace_order_by_QR"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="478" as="geometry"/></mxCell><mxCe