as="offset"/></mxGeometry></mxCell><mxCell id="15" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="970" y="342" width="10" height="22" as="geometry"/></mxCell><mxCell id="16" value="&lt;font style=&quot;font-size:11px&quot;&gt;ReleaseExpiredAsync() — every minute&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="346" as="sourcePoint"/><mxPoint x="975" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="130" y="370" width="10" height="22" as="geometry"/></mxCell><mxCell id="18" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;PaymentRequest&amp;gt;().Where(PreOrderDeposit, Pending, expired).ToListAsync()&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="374" as="sourcePoint"/><mxPoint x="135" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="130" y="398" width="10" height="22" as="geometry"/></mxCell><mxCell id="20" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;SalesOrder&amp;gt;().Where(id, PendingPayment).ExecuteUpdateAsync(Cancelled, payment_timeout)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="402" as="sourcePoint"/><mxPoint x="135" y="402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="130" y="426" width="10" height="22" as="geometry"/></mxCell><mxCell id="22" value="&lt;font style=&quot;font-size:11px&quot;&gt;Set&amp;lt;PreOrderHold&amp;gt;().Where(order, Active).ExecuteUpdateAsync(Released) — the crabs return to the quota; nothing is lost (case d of UC55) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="430" as="sourcePoint"/><mxPoint x="135" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="454" width="10" height="22" as="geometry"/></mxCell><mxCell id="24" value="&lt;font style=&quot;font-size:11px&quot;&gt;WriteAsync(&quot;sales_order&quot;, id, &quot;cancel&quot;)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="458" as="sourcePoint"/><mxPoint x="345" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="506" width="970" height="36" as="geometry"/></mxCell><mxCell id="26" value="&lt;font style=&quot;font-size:11px&quot;&gt;Funding close (Figure 4.38) — Batch opens: DepositPaid → Confirmed, orders cancelled after paying → Forfeited «planned»; Batch does not open: every paid deposit refunded, pending deposit QRs cancelled «planned»&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="508" width="890" height="32" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;Figure 4.56 (3/3) – Sequence Diagram: UC27, UC12 Place Bulk Pre-order with Deposit — by number of crabs from a minimum quantity, while the Batch is funding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · code: develop @ 420a379 · classes: Figure 4.71 onwards · modified for v1.4 · was v2.0 Figure 4.60 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1070" height="61" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;Notes&lt;/b&gt; · use case: UC27, UC12 · owner: Nhân · modified for v1.4&lt;br&gt;• v1.4: pre-orders are taken only while the Batch is funding, by number of crabs (or by kg) from a minimum quantity, at the price per kg fixed on the Batch (delivery included); an Investor may pre-order like a Customer, except the Operator of the Batch and related parties. The money is the weighed kg × price per kg (Figure 4.57).&lt;br&gt;• Code @ 420a379: the pre-order is placed on a listing while the Batch is InProduction, priced from price_history, deposit % from batch.offtake_deposit_pct, cap from v_batch_commitment_cap. Removed in v1.4 (still in code): the listing path and the balance issued at harvest (PreorderBalanceService).&lt;br&gt;• The pre-order quota and the 15-minute holds are PreOrderQuota (batch_preorder_quota) and PreOrderHold (preorder_hold), «planned»; the code caps kg through v_batch_commitment_cap.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1050" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC29 UC30 Delivery &amp; balance (1 of 4)" id="UC29_UC30_Delivery__amp__balance__1_of_4_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Operator (mobile)" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;size=54;fontSize=12;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="115" y="96" width="40" height="642" as="geometry"/></mxCell><mxCell id="c3" value="«controller»&lt;br&gt;&lt;b&gt;:OperatorOrdersController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;fillColor=#e0f2fe;size=54;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="190" height="642" as="geometry"/></mxCell><mxCell id="c4" value="«service»&lt;br&gt;&lt;b&gt;:OrderPackingService&lt;/b&gt;" style="shape=umlLif