 | Proposed | Disputed]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="657" width="228.95479999999992" height="18" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;alt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="236" width="1240" height="586" as="geometry"/></mxCell><mxCell id="17" value="&lt;font style=&quot;font-size:11px&quot;&gt;[ok] (continued)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="116" y="236" width="120" height="24" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="1180" height="32" as="geometry"/></mxCell><mxCell id="19" value="&lt;font style=&quot;font-size:11px&quot;&gt;continued from part 1/3 of Figure 4.40&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="1100" height="28" as="geometry"/></mxCell><mxCell id="20" value="&lt;font style=&quot;font-size:11px&quot;&gt;shares that sum exactly to the distributable amount&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" pare