" y="462" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="550" y="486" width="10" height="22" as="geometry"/></mxCell><mxCell id="30" value="&lt;font style=&quot;font-size:11px&quot;&gt;CancelAsync(orderNo, req)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="490" as="sourcePoint"/><mxPoint x="555" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="760" y="514" width="10" height="22" as="geometry"/></mxCell><mxCell id="32" value="&lt;font style=&quot;font-size:11px&quot;&gt;SaveChangesAsync() — DepositPaid → Cancelled; the deposit stays in the batch account until funding close (code: 422 order.cannot_cancel) «planned»&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;strokeColor=#64748b;fontColor=#64748b;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="555" y="518" as="sourcePoint"/><mxPoint x="765" y="518" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="33" value="&lt;b&gt;ref&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=#ffffff;width=40;height=20;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="546" width="970" height="36" as="geometry"/></mxCell><mxCell id="34" value="&lt;font style=&quot;font-size:11px&quot;&gt;Funding close (Figure 4.38): (a) the Batch opens → ForfeitCancelledDepositsAsync: order → Forfeited, the deposit becomes ForfeitedDeposit revenue; (b) the Batch does not open → the deposit is refunded with every other deposit&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="548" width="890" height="32" as="geometry"/></mxCell><mxCell id="35" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="340" y="636" width="10" height="22" as="geometry"/></mxCell><mxCell id="36" value="&lt;font style=&quot;font-size:11px&quot;&gt;Cancel(orderNo, req) · POST /api/orders/{orderNo}/cancel {reason}&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="135" y="640" as="sourcePoint"/><mxPoint x="345" y="640" as="targetPoint"/><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="37" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="550" y="664" width="10" height="22" as="geometry"/></mxCell><mxCell id="38" value="&lt;font style=&quot;font-size:11px&quot;&gt;CancelAsync(orderNo, req)&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="668" as="sourcePoint"/><mxPoint x="555" y="668" as=