olor=#64748b;exitX=1;exitY=0.756;exitDx=0;exitDy=0;entryX=0;entryY=0.471;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="740"/><mxPoint x="560" y="702"/></Array></mxGeometry></mxCell><mxCell id="117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERzeroToMany;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=0;exitY=0.588;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="968" y="862"/><mxPoint x="968" y="921.2"/></Array></mxGeometry></mxCell><mxCell id="118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#334155;exitX=0;exitY=0.483;exitDx=0;exitDy=0;entryX=1;entryY=0.603;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c54"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="926"/><mxPoint x="595" y="907.3333333333334"/></Array></mxGeometry></mxCell><mxCell id="119" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#334155;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.476;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c54"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="208" y="648"/><mxPoint x="208" y="902"/></Array></mxGeometry></mxCell><mxCell id="120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERzeroToMany;strokeColor=#334155;exitX=1;exitY=0.349;exitDx=0;exitDy=0;entryX=0;entryY=0.467;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="553" y="896.6666666666666"/><mxPoint x="553" y="658"/></Array></mxGeometry></mxCell><mxCell id="121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#334155;exitX=1;exitY=0.731;exitDx=0;exitDy=0;entryX=0;entryY=0.467;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="982" y="940.4"/><mxPoint x="982" y="902"/></Array></mxGeometry></mxCell><mxCell id="122" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Areas: &lt;font color=&quot;#1d4ed8&quot;&gt;■&lt;/font&gt; A1 Identity, accounts, farm and boxes · &lt;font color=&quot;#b45309&quot;&gt;■&lt;/font&gt; A2 Batch, Standard Cost, funding and contracts · &lt;font color=&quot;#0369a1&quot;&gt;■&lt;/font&gt; A3 Production, evidence and alerts · &lt;font color=&quot;#0f766e&quot;&gt;■&lt;/font&gt; A4 Harvest, traceability and pricing · &lt;font color=&quot;#c2410c&quot;&gt;■&lt;/font&gt; A5 Bulk orders, invoices and complaints · &lt;font color=&quot;#b91c1c&quot;&gt;■&lt;/font&gt; A6 Payments, settlement and audit.&lt;br&gt;Crow's foot at both ends: | one · O zero · &amp;lt; many. Grey dashed box or line = «planned» (Register v1.4, not in code yet).&lt;br&gt;Main relationships only: actor links (User signs, judges, writes) and secondary references (evidence links, refunds, payment matching, capital-share snapshot, crab replacement) are drawn with their names on the area pages 3.3.1–3.3.6." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1044" width="1424" height="84" as="geometry"/></mxCell><mxCell id="123" value="&lt;b&gt;Notes – Register v1.4&lt;/b&gt;&lt;br&gt;• Removed from the business model (tables still used by code, so they stay in the Physical ERD, Figure 4.3): ProductListing, PriceHistory (Listing / Catalog); OrderLine, StockReservation (Cart / retail checkout); OfftakeCommitment (Offtake window); CrabTag, TagScan (printed per-crab tag); ProductionThreshold (water-quality thresholds: temperature, salinity and pH are not needed in v1.4).&lt;br&gt;• Technical logs appear only from the Logical level: IngestionMessage «planned» (simulator data), AuditRecord (hash-chained audit log), CrabHistory (per-crab event log).&lt;br&gt;• Traceability Conceptual → Logical → Physical and the code class of each entity: Table 4.2 in the Logical ERD file.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead (Batch opening condition, box rows, forfeited deposits, survival rate, weighed-kg balance, unused Standard Cost, InvoicedSale)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="1424" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A1 · Identity, accounts, farm and boxes" id="A1___Identity__accounts__farm_and_boxes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 3.3.1 – Conceptual ERD: Identity, accounts, farm and boxes (Register v1.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · crow's foot · 11 entities of A1 + 2 related entities of other areas (white boxes) · 15 relationships&lt;/font&gt;" style="text;html=1;align=left;verticalAlign