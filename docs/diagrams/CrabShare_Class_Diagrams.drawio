<mxfile host="CrabShare-generator" modified="2026-11-04T20:01:58.934Z" agent="crabshare-drawio-gen" version="24.7.17" type="device"><diagram name="Index of figures (1 of 2)" id="Index_of_figures__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Class Diagrams – index of Figures 4.71–4.87 (page 1 of 2) — 17 feature groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 (19 modules)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1480" height="42" as="geometry"/></mxCell><mxCell id="3" value="&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Figure&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Feature group&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Use cases&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Parts&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;v1.4 status&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Owner&lt;/th&gt;&lt;th align=&quot;left&quot; style=&quot;padding:2px 8px;border-bottom:1px solid #94a3b8&quot;&gt;Was (v2.0)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;&lt;b&gt;4.71&lt;/b&gt;&lt;/td&gt;&lt;td sty