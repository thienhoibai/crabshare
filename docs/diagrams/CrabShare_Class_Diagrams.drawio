ont style=&quot;font-size:11px&quot;&gt;row access «planned»&lt;/font&gt;" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.3567;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3538;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c2" target="c33"><mxGeometry x="-0.0902" relative="1" as="geometry"><Array as="points"><mxPoint x="431" y="160"/><mxPoint x="431" y="340"/></Array><mxPoint x="11" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="68" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=1;exitY=0.2100;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.2805;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c46"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="504"/><mxPoint x="915" y="142"/></Array></mxGeometry></mxCell><mxCell id="69" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="68"><mxGeometry x="-0.8780" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="70" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="68"><mxGeometry x="0.8780" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="71" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.2255;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.2805;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c52" target="c46"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="340"/><mxPoint x="1385" y="142"/></Array></mxGeometry></mxCell><mxCell id="72" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="71"><mxGeometry x="-0.8171" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="73" value="*" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="71"><mxGeometry x="0.8171" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="74" value="&lt;b&gt;Figure 4.77 (2/2) – Class Diagram: Production module — stocking, daily logs, box events, timeline, box details of own rows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 · modified for v1.4 · was v2.0 Figure 4.79 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="42" as="geometry"/></mxCell><mxCell id="75" value="&lt;b&gt;Notes&lt;/b&gt; · use cases: UC17, UC21, UC53 · owner: Viên · modified for v1.4&lt;br&gt;Box events are idempotent by (batch, request_id, request_hash); mortality and restock need an InAppCapture photo of the box; alive counts are reconciled after every event. v1.4: the device simulator posts logs and events through the Ingestion API (RecordFromApiAsync «planned», Source FarmApi); investors see box details only for their own rows (BoxDetailService «planned»), others see the Batch-level timeline. ERD names: SlotEvent = BoxEvent, SlotEventDetail = BoxEventDetail, SlotEventPolicyVersion = BoxEventPolicy, CrabItem = Crab. Removed in v1.4 (still in code): water-quality thresholds (ProductionThresholdVersion; ProductionLogsController.Thresholds / Configure → ProductionLogService.ThresholdsAsync / ConfigureAsync), the Ph / WaterTempC / SalinityPpt measurements and ThresholdVersionId of ProductionLog, the plausibility check Violations(request, thresholds) → OutOfRange and the WaterQuality alert; the v1.4 simulator sends only meaningful data (feeding, photos, box events) and TL-22 dropped alerts on environmental measurements.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="829" width="1280" height="99" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Ingestion API" id="Ingestion_API"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«controller» «planned»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;IngestionController&lt;/font&gt;&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f8fafc;strokeColor=#1e293b;swimlaneFillColor=#ffffff;fontSize=13;fontFamily=Segoe UI;fillColor=#f8fafc;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" 