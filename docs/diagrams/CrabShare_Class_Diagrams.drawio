calAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f8fafc;strokeColor=#1e293b;swimlaneFillColor=#ffffff;fontSize=13;fontFamily=Segoe UI;fillColor=#fff7ed;" vertex="1" parent="1"><mxGeometry x="510" y="344" width="340" height="70" as="geometry"/></mxCell><mxCell id="27" value="+ SaveAsync(stream, fileName, contentType, folder): StoredFile" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=1;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c26"><mxGeometry x="0" y="44" width="340" height="20" as="geometry"/></mxCell><mxCell id="28" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c8"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="513"/><mxPoint x="445" y="389"/></Array></mxGeometry></mxCell><mxCell id="29" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.4227;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c20"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="275"/><mxPoint x="915" y="143"/></Array></mxGeometry></mxCell><mxCell id="30" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7227;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c26" target="c20"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="901" y="379"/><mxPoint x="901" y="176"/></Array></mxGeometry></mxCell><mxCell id="31" value="&lt;b&gt;Figure 4.87 (2/2) – Class Diagram: Common and Infrastructure — audit hash chain, persistence, jobs, security, ports and adapters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 · modified for v1.4 · was v2.0 Figure 4.88 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="42" as="geometry"/></mxCell><mxCell id="32" value="&lt;b&gt;Notes&lt;/b&gt; · use cases: all · owner: Khôi / Thiện · modified for v1.4&lt;br&gt;Every external system sits behind an interface; Development and the demo use sandbox or fake adapters (no real money, signing or eKYC). In the Sequence Diagrams the «persistence» lifeline is AppDbContext and every message to it is one of the EF Core operations listed here (Set&amp;lt;T&amp;gt;() queries, Add, SaveChangesAsync, ExecuteUpdateAsync…), with the effect in a short comment. All audit writers share one TABLOCKX-serialised hash chain (TL-08). GlobalExceptionHandler maps AppException to ProblemDetails (404, 403, 409, 422). Removed in v1.4 (still in code): IAlertRaiser / AlertServiceRaiser (Catalog only)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="96" width="340" height="189" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>