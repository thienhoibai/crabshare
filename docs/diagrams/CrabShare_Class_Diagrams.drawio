5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.2706;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c23" target="c44"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="901" y="344"/><mxPoint x="901" y="705"/></Array></mxGeometry></mxCell><mxCell id="78" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="77"><mxGeometry x="-0.8706" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="79" value="*" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="77"><mxGeometry x="0.8706" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="80" value="&lt;font style=&quot;font-size:11px&quot;&gt;«planned»&lt;/font&gt;" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;exitX=1;exitY=0.2410;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.2486;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c23" target="c51"><mxGeometry x="0.1778" relative="1" as="geometry"><Array as="points"><mxPoint x="929" y="170"/><mxPoint x="929" y="142"/></Array></mxGeometry></mxCell><mxCell id="81" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="80"><mxGeometry x="-0.6190" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="82" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="80"><mxGeometry x="0.6190" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="83" value="&lt;b&gt;Figure 4.74 (2/2) – Class Diagram: Settlement module and SettlementEngine — four revenue sources, remuneration tiers, loss cap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 · modified for v1.4 · was v2.0 Figure 4.76 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="42" as="geometry"/></mxCell><mxCell id="84" value="&lt;b&gt;Notes&lt;/b&gt; · use cases: UC35–UC39 · owner: Thiện · modified for v1.4&lt;br&gt;Revenue Pool = actual Batch revenue − locked Standard Cost. Remuneration = floor(Pool × 5–10 %) only when Pool &amp;gt; 0, cut by tier when survival falls below the threshold set at Batch creation (RemunerationTier «planned»). Payouts by confirmed capital with largest-remainder rounding; losses capped at capital, the overrun stays with the Operator. LineType InvoicedSale covers both the low-grade sale and the resale after a forfeit (saleReason LowGrade | ForfeitResale). Survival rate = 1 − deaths in the cycle ÷ crabs first stocked in funded boxes, used to pick the tier. The full locked Standard Cost of the funded boxes is always subtracted; savings, including the unused mortality reserve, stay with the Operator. Attribute names follow the Logical ERD. The engine is a pure library for the research suites. Money is long / decimal(18,0) — integer VND.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="849" width="1280" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Operators &amp; Boxes (1 of 2)" id="Operators__amp__Boxes__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«controller»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;OperatorsController&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f8fafc;strokeColor=#1e293b;swimlaneFillColor=#ffffff;fontSize=13;fontFamily=Segoe UI;fillColor=#e0f2fe;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="340" height="218" as="geometry"/></mxCell><mxCell id="3" value="- operators: OperatorService" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=1;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c2"><mxGeometry x="0" y="44" width="340" height="20" as="geometry"/></mxCell><mxCell id="4" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#94a3b8;" vertex="1" parent="c2"><mxGeometry x="0" y="64" width="340" height="8" as="geometry"/></mxCell><mxCell id="5" value="+ Create(req): OperatorResponse" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft