abel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="27"><mxGeometry x="-0.8415" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="29" value="0..2" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="27"><mxGeometry x="0.8415" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="30" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.3067;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7380;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c21" target="c2"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="431" y="650"/><mxPoint x="431" y="281"/></Array></mxGeometry></mxCell><mxCell id="31" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="30"><mxGeometry x="-0.8727" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="32" value="*" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;" vertex="1" connectable="0" parent="30"><mxGeometry x="0.8727" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="33" value="&lt;b&gt;Figure 4.72 (2/2) – Class Diagram: Contracts module — sequential e-signing (UC14), offline-signed upload (UC15)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 · kept — refreshed against code · was v2.0 Figure 4.74 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="880" height="42" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;Notes&lt;/b&gt; · use cases: UC14, UC15 · owner: Thiện · kept — refreshed against code&lt;br&gt;A contract can be created while the contribution is Reserved (not expired) or Confirmed (IsActive); signing never blocks the VietQR payment, and stocking needs both a Confirmed contribution and a fully signed contract (ContributePage order: risk → amount → contract → VietQR → done). Each PDF version is content-addressed (contracts/{no}/{sha256}.pdf) and re-hashed on download (contract.file_tampered). Operator Owner signs first, then the Investor (contract.wrong_signing_order). v1.4: the loss rule, floor price and remuneration tiers go into the template before funding opens." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="96" width="340" height="189" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Payments (1 of 3)" id="Payments__1_of_3_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«controller»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PaymentWebhookController&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0