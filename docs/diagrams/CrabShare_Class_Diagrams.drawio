d style=&quot;padding:2px 8px&quot;&gt;UC04, UC05, UC44&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;modified for v1.4&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Viên&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;4.77&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;&lt;b&gt;4.76&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Batches&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;UC07, UC08, UC09, UC25&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;modified for v1.4&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Viên&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;4.78&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;&lt;b&gt;4.77&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Production&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;UC17, UC21, UC53&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;modified for v1.4&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Viên&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;4.79&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;&lt;b&gt;4.78&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Ingestion API&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;UC52&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:2px 8px;color:#64748b&quot;&gt;new «planned»&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Viên&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;&lt;b&gt;4.79&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;Harvest &amp; Traceability&lt;/td&gt;&lt;td style=&quot;padding:2px 8px&quot;&gt;UC22, UC33&lt;/td&gt