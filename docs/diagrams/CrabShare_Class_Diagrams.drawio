hen the Batch is saved; names follow the Logical ERD (TargetFrom/To, DataFrom/To, Source FarmInterview). Replaces the v2.0 Catalog page (removed in v1.4)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="96" width="340" height="174" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Orders – pre-order &amp; deposit (1 of 2)" id="Orders___pre_order__amp__deposit__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«controller»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PreordersController&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f8fafc;strokeColor=#1e293b;swimlaneFillColor=#ffffff;fontSize=13;fontFamily=Segoe UI;fillColor=#e0f2fe;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="340" height="98" as="geometry"/></mxCell><mxCell id="3" value="- preorders: PreorderService" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=1;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c2"><mxGeometry x="0" y="44" width="340" height="20" as="geometry"/></mxCell><mxCell id="4" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points