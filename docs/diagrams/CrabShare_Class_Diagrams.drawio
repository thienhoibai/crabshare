Geometry></mxCell><mxCell id="69" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="68"><mxGeometry x="-0.8854" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="70" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="68"><mxGeometry x="0.8854" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="71" value="&lt;font style=&quot;font-size:11px&quot;&gt;«planned»&lt;/font&gt;" style="html=1;edgeStyle=none;rounded=0;strokeColor=#334155;fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.5296;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c36" target="c54"><mxGeometry x="0.0606" relative="1" as="geometry"><Array as="points"><mxPoint x="929" y="611"/><mxPoint x="929" y="279"/></Array></mxGeometry></mxCell><mxCell id="72" value="1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="71"><mxGeometry x="-0.8701" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="73" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=11;fontFamily=Segoe UI;labelBackgroundColor=none;fontColor=#64748b;" vertex="1" connectable="0" parent="71"><mxGeometry x="0.8701" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-3"/></mxGeometry></mxCell><mxCell id="74" value="&lt;b&gt;Figure 4.78 – Class Diagram: Ingestion API «planned» — device and camera simulator data through one common API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · UML 2.5 · classes as on develop @ 420a379 · new «planned» · new for Register v1.4 · legend: Index page&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="42" as="geometry"/></mxCell><mxCell id="75" value="&lt;b&gt;Notes&lt;/b&gt; · use cases: UC52 · owner: Viên · new «planned»&lt;br&gt;UC52 «planned» (TP2): one common API replaces per-farm software and IoT / camera hardware (out of scope). The simulator sends only meaningful farm data — feeding, health, box events, daily logs, photos — not temperature or salinity; ProductionLogRequest must stop requiring Ph / WaterTempC / SalinityPpt for this path. Each message is idempotent by (OperatorId, ClientMessageId) and stamped with server time; device photos never count as live evidence (tranche gates must keep only InAppCapture). Attribute names follow the Logical ERD." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="893" width="1280" height="69" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Harvest &amp; Traceability (1 of 2)" id="Harvest__amp__Traceability__1_of_2_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«controller»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;HarvestController&lt;/