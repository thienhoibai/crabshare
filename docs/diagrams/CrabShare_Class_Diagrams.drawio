ther." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1430" y="70" width="300" height="160" as="geometry"/></mxCell><mxCell id="116" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;«controller» HTTP entry · «service» application logic · «interface» port to an external system or cross-cutting concern · «adapter» implementation · «entity» EF Core entity (table) · «background job» hosted service.&lt;br&gt;Open arrow = association (uses) · dashed = dependency · dashed triangle = realization · filled diamond = composition." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1430" y="250" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Contracts" id="Contracts"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.74 – Class Diagram – Contracts module (UC14 sequential e-signing, UC15 offline upload)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 · classes as on develop @ 22/10/2026 · attributes = injected dependencies / fields · operations = public API&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#64748b&quot;&gt;«controller»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ContractsController&lt;/b&gt;" style="swimlane