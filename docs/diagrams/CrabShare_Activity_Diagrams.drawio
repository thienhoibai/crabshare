mond = decision with guards (incl. [else]) · Bar = fork/join · Orange box = object node with state · Hourglass = time event · ⊙ = activity final · ✕ = flow final" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-02 Contribute and sign" id="WF_02_Contribute_and_sign"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.36 – Activity Diagram – WF-02 Contribute capital and sign the contract (Investor, Payment Service Provider, Operator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 activity with partitions · business level · one diagram per demo workflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Investor" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="1946" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="260" height="1946" as="geometry"/></mxCell><mxCell id="c5" value="Payment Service Provider" style="swimlane;html=1;startSize=30;horizontal=1;