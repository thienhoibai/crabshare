="290" width="210" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Check the crabs at the door" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="45" y="374" width="210" height="44" as="geometry"/></mxCell><mxCell id="c11" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="135" y="468" width="30" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;accept and pay the balance?&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=bottom;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="26" y="442" width="105" height="32" as="geometry"/></mxCell><mxCell id="c13" value="Pay the balance = weighed kg × price per kg − deposit (weighed kg = live crabs received)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;(weighed kg «planned»)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="45" y="529.5" width="210" height="75" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«planned»&lt;/font&gt;&lt;br&gt;Forfeit the deposit as Batch revenue; return the crabs to stock for the Batch's invoiced sale" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="535" y="522" width="210" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Notify the balance payment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="636.5" width="210" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«planned»&lt;/font&gt;&lt;br&gt;BulkPreOrder [Forfeited]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="535" y="636" width="210" height="45" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="628" y="705" width="24" height="24" as="geometry"/></mxCell><mxCell id="c18" value="Record the delivery; start the 72-hour return window" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="535" y="753" width="210" height="46" as="geometry"/></mxCell><mxCell id="c19" value="BulkPreOrder [Delivered]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="535" y="823" width="210" height="36" as="geometry"/></mxCell><mxCell id="c20" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="626" y="883" width="28" height="28" as="geometry"/></mxCell><mxCell id="21" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="320"/></Array></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="[yes]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value="[no: refuses or does not pay]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry x="-0.6113" relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="483"/></Array></mxGeometry></mxCell><mxCell id="27" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="567"/></Array></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="776"/></Array></mxGeometry></mxCell><mxCell id="31" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="32" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="&lt;b&gt;Notes&lt;/b&gt; — Delivery starts once the boxes are harvested (part 5). A refused delivery or an unpaid balance forfeits the deposit (Batch revenue ForfeitedDeposit) and ends this pre-order; its crabs go back to stock for the Batch's invoiced sale on part 5. Balance = weighed kg × price per kg − deposit, where weighed kg counts the live crabs received; the transit loss is only recorded, not deducted again, and a negative balance is refunded. Connector C continues on part 4.&lt;br&gt;Traceability, exception branches, «planned» items and states: see the notes on the last part.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1054" y="76" width="420" height="187" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1054" y="273" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-04 Bulk pre-sale and delivery (4 of 5)" id="WF_04_Bulk_pre_sale_and_delivery__4_of_5_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.34 – Activity Diagram: WF-04 Bulk pre-order, weighed delivery, invoiced and final orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Part 4 of 5: order QR, returns, complaints and completion (each pre-order)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1714" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="260" height="1127" as="geometry"/></mxCell><mxCell id="c4" value="Payment Service Provider" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneF