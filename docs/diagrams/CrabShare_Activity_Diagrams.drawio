elative="1" as="geometry"><Array as="points"><mxPoint x="395" y="723"/></Array></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="&lt;b&gt;Notes&lt;/b&gt; — An Investor may pre-order like a Customer (not the Batch's Operator or its members). Cancelling before paying (UC55) or letting the 15-minute QR expire costs nothing. Connector A continues on part 2.&lt;br&gt;Traceability, exception branches, «planned» items and states: see the notes on the last part.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="794" y="76" width="420" height="127" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="794" y="213" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-04 Bulk pre-sale and delivery (2 of 5)" id="WF_04_Bulk_pre_sale_and_delivery__2_of_5_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.34 – Activity Diagram: WF-04 Bulk pre-order, weighed delivery, invoiced and final orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Part 2 of 5: cancellation and Batch outcome (each pre-order)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1454" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="260" height="794" as="geometry"/></mxCell><mxCell id="c4" value="Payment Service Provider" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="76" width="230" height="794" as="ge