</mxCell><mxCell id="70" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Traceability: UC22, UC46, UC24, UC25, UC26, UC12, UC23 (PR #72), UC29, UC30, UC33, UC31, UC32, UC34. Exception branches: payment timeout; complaint and dispute. States: crab_item Growing → InStock → Packed → Sold; crab_tag Printed → Active; product_listing; sales_order PendingPayment → Paid → Packed → Shipping → Delivered → Completed/Returned; complaint." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="2118" width="1300" height="70" as="geometry"/></mxCell><mxCell id="71" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Green = human action · Blue = system action · Diamond = decision with guards (incl. [else]) · Bar = fork/join · Orange box = object node with state · Hourglass = time event · ⊙ = activity final · ✕ = flow final" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1350" y="70" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-05 Settle and close" id="WF_05_Settle_and_close"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.39 – Activity Diagram – WF-05 Settlement, feedback, payout and batch close (Administrator, Investor, Operator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 activity with partitions · business level · one diagram per demo workflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Platform Administrator" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="2110" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="260" height="2110" as="geometry"/></mxCell><mxCell id="c5" value="Investor" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="260" height="2110" as="geometry"/></mxCell><mxCell id="c6" value="Operator" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="260" height="2110" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="148" y="135" width="24" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Calculate settlement for the batch [Harvesting, sales done]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="202" width="200" height="54" as="geometry"/></mxCell><mxCell id="c9" value="Actual revenue = completed orders + forfeited deposits − refunds; Revenue Pool = revenue − locked Standard Cost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="284" width="200" height="54" as="geometry"/></mxCell><mxCell id="c10" value="Pool &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=10;fontFamily=Segoe UI;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="335" y="365" width="170" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Operator remuneration (%); split the rest pro rata by capital, largest-remainder rounding; tax shown per line" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="448" width="200" height="54" as="geometry"/></mxCell><mxCell id="c12" value="No remuneration; allocate loss pro rata, each capped at the investor's capital; excess loss stays with the Operator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="530" width="200" height="54" as="geometry"/></mxCell><mxCell id="c13" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="406" y="625" width="28" height="28" as="geometry"/></mxCell><mxCell id="c14" value="Settlement [Draft] with one line per investor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="701" width="200" height="40" as="geometry"/></mxCell><mxCell id="c15" value="Review draft statement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="776" width="200" height="54" as="geometry"/></mxCell><mxCell id="c16" value="recalculate?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=10;fontFamily=Segoe UI;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="75" y="857" width="170" height="56" as="geometry"/></mxCell><mxCell id="c17" value="Publish proposal with a 7–14 day feedback window" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="200" height="54" as="geometry"/></mxCell><mxCell id="c18" value="Review own statement line (capital, share, tax, net payout)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="1022" width="200" height="54" as="geometry"/></mxCell><mxCell id="c19" value="Review full statement (all lines, remuneration)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="840" y="1022" width="200" height="54" as="geometry"/></mxCell><mxCell id="c20" value="feedback?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=10;fontFamily=Segoe UI;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="595" y="1103" width="170" height="56" as="geometry"/></mxCell><mxCell id="c21" value="Submit feedback with grounds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="1186" width="200" height="54" as="geometry"/></mxCell><mxCell id="c22" value="Answer feedback (answered / unresolved)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="