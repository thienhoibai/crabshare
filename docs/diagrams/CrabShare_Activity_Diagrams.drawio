imeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="774"/></Array></mxGeometry></mxCell><mxCell id="35" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="36" value="&lt;b&gt;Notes&lt;/b&gt; — Cancellation after the deposit (UC55): when the Batch does not open every deposit is refunded, cancelled pre-orders included; when it opens, a pre-order cancelled after paying forfeits the deposit, which becomes Batch revenue (UC54). Connector B continues the kept pre-order on part 3.&lt;br&gt;Traceability, exception branches, «planned» items and states: see the notes on the last part.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1054" y="76" width="420" height="157" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1054" y="243" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-04 Bulk pre-sale and delivery (3 of 5)" id="WF_04_Bulk_pre_sale_and_delivery__3_of_5_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="970" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.34 – Activity Diagram: WF-04 Bulk pre-order, weighed delivery, invoiced and final orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Part 3 of 5: delivery and balance (each pre-order)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1454" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="260" height="861" as="geometry"/></mxCell><mxCell id="c4" value="Payment Service Provider" s