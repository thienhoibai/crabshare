dge="1" parent="1" source="c20" target="c21"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="872"/></Array></mxGeometry></mxCell><mxCell id="41" value="[yes]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c21" target="c24"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="42" value="[no: escalated]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry x="-0.6021" relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="960"/></Array></mxGeometry></mxCell><mxCell id="43" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="44" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="45" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="46" value="&lt;b&gt;Notes&lt;/b&gt; — Data come either from the Operator in the app or, «planned», from the simulated farm devices and cameras through one common data channel (no hardware). Alerts in v1.4: Mortality from box events, MilestoneDelay and DataSilence from the alert job, EvidenceFlag from an expired capture request. The cycle repeats every day until harvest (WF-04). Connector A continues on part 2.&lt;br&gt;Traceability, exception branches, «planned» items and states: see the notes on the last part.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1084" y="76" width="420" height="172" as="geometry"/></mxCell><mxCell id="47" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1084" y="258" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-03 Production and evidence (2 of 3)" id="WF_03_Production_and_evidence__2_of_3_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.33 – Activity Diagram: WF-03 Production data, alerts, evidence review and milestone disbursement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Part 2 of 3: capture request and evidence review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1494" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="swimlane;html=1;startSize=48;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="260" height="946" as="geometry"/></mxCell><mxCell id="c4" value="Platform Administrator (Evidence Reviewer)" style="swimlane;html=1;startSize=48;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="76" width="270" height="946" as="geometry"/></mxCell><mxCell id="c5" value="CrabShare System" style="swimlane;html=1;startSize=48;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="550" y="76" width="260" height="946" as="geometry"/></mxCell><mxCell id="c6" value="Investor" style="swimlane;html=1;startSize=48;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="810" y="76" width="260" height="946" as="geometry"/></mxCell><mxCell id="c7" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="666" y="140" width="28" height="28" as="geometry"/></mxCell><mxCell id="c8" value="Capture a live photo of the box in the app: server time, location, box number" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="45" y="192" width="210" height="61" as="geometry"/></mxCell><mxCell id="c9" value="Check the photo is genuine and score its risk&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;(crab detection «planned»)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="575" y="277" width="210" height="60" as="geometry"/></mxCell><mxCell id="c10" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="665" y="373" width="30" height="30" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;risk score?&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="699" y="361" width="105" height="18" as="geometry"/></mxCell><mxCell id="c12" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="137" y="427" width="26" height="26" as="geometry"/></mxCell><mxCell id="c13" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;stro