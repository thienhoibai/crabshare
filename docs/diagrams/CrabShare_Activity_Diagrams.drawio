<mxGeometry x="60" y="1350" width="200" height="54" as="geometry"/></mxCell><mxCell id="c28" value="Hand to carrier (ship) and mark delivered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="1432" width="200" height="54" as="geometry"/></mxCell><mxCell id="c29" value="Confirm receipt; scan the tag to trace the crab" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="1514" width="200" height="54" as="geometry"/></mxCell><mxCell id="c30" value="complaint within 72 h?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=10;fontFamily=Segoe UI;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="335" y="1595" width="170" height="56" as="geometry"/></mxCell><mxCell id="c31" value="Submit complaint (late, wrong grade, damaged, not received)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="1678" width="200" height="54" as="geometry"/></mxCell><mxCell id="c32" value="Respond to the complaint with evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="1760" width="200" height="54" as="geometry"/></mxCell><mxCell id="c33" value="Resolve dispute: refund, compensation, replacement or reject" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100" y="1842" width="200" height="54" as="geometry"/></mxCell><mxCell id="c34" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeCol