 = fork/join · Orange box = object node with state · Hourglass = time event · ⊙ = activity final · ✕ = flow final" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1090" y="70" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-04 Harvest, sell, deliver" id="WF_04_Harvest__sell__deliver"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.38 – Activity Diagram – WF-04 Harvest, tag, sell and deliver (Operator, Customer, Offtake Investor, Administrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 activity with partitions · business level · one diagram per demo workflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="2028" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="260" height="2028" as="geometry"/></mxCell><mxCell id="c5" value="Customer" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="260" height="2028" as="geometry"/></mxCell><mxCell id="c6" value="Investor (Offtake)" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="260" height="2028" as="geometry"/></mxCell><mxCell id="c7" value="Platform Administrator" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1070" y="70" width="260" height="2028" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="148" y="135" width="24" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Start harvest session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="202" width="200" height="54" as="geometry"/></mxCell><mxCell id="c10" value="Weigh and grade each crab; print its tag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="200" height="54" as="geometry"/></mxCell><mxCell id="c11" value="Activate tag with one confirmation photo of the crab" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="366" width="200" height="54" as="geometry"/></mxCell><mxCell id="c12" value="Complete harvest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="448" width="200" height="54" as="geometry"/></mxCell><mxCell id="c13" value="Sync listing stock per grade; price anomaly check on publish" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="530" width="200" height="54" as="geometry"/></mxCell><mxCell id="c14" value="Publish product listings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="612" width="200" height="54" as="geometry"/></mxCell><mxCell id="c15" value="" style="line;strokeWidth=6;html=1;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="320" y="717" width="200" height="8" as="geometry"/></mxCell><mxCell id="c16" value="Browse catalogue, add to cart, check out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="776" width="200" height="54" as="geometry"/></mxCell><mxCell id="c17" value="Reserve stock atomically (15 min), one order per batch, VietQR per order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="858" width="200" height="54" as="geometry"/></mxCell><mxCell id="c18" value="Pay by VietQR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="580" y="940" width="200" height="54" as="geometry"/></mxCell><mxCell id="c19" value="Confirm payment (webhook); order Paid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="1022" width="200" height="54" as="geometry"/></mxCell><mxCell id="c20" value="after 15 min unpaid" style="shape=hou