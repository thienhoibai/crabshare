parent="1" source="c23" target="c24"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="46" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="47" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="48" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="49" value="&lt;b&gt;Notes&lt;/b&gt; — A return in the window (Customer, or approved by the Operator) or a complaint resolved with a full refund returns the order; compensation, replacement or rejection keeps it Delivered until the return window ends (a partial refund also creates a refund instruction, not drawn). An active complaint blocks completion. Each pre-order ends at its own flow final.&lt;br&gt;Traceability, exception branches, «planned» items and states: see the notes on the last part." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1314" y="76" width="420" height="142" as="geometry"/></mxCell><mxCell id="50" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1314" y="228" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="WF-04 Bulk pre-sale and delivery (5 of 5)" id="WF_04_Bulk_pre_sale_and_delivery__5_of_5_"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1010" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.34 – Activity Diagram: WF-04 Bulk pre-order, weighed delivery, invoiced and final orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Part 5 of 5: harvest, invoiced sales and final order (once per Batch)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="964" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="260" height="699" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;startSize=32;horizontal=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="76" width="260" height="699" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="138" y="124" width="24" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Record the harvest per box: weight, grade" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="45" y="172" width="210" height="46" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=collate;html=1;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="139" y="243" width="22" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;sales window closed&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="165" y="242" width="109" height="32" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«planned»&lt;/font&gt;&lt;br&gt;Record the invoiced sales of low-grade crabs and of crabs from forfeited pre-orders (InvoicedSale)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="45" y="298" width="210" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="137" y="412" width="26" height="26" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«planned»&lt;/font&gt;&lt;br&gt;Record the final order for the leftover crabs to the committed buyer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="45" y="462" width="210" height="75" as="geometry"/></mxCell><mxCell id="c12" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="135" y="587" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;price ≥ floor price?&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="169" y="561" width="105" height="32" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;«planned»&lt;/font&gt;&lt;br&gt;FinalOrder [PendingPayment] with its invoice, one per Batch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="305" y="641" width="210" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="398" y="725" width="24" height="24" as="geometry"/></mxCell><mxCell id="16" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#