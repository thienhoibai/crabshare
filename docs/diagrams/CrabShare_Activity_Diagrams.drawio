illColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="395" y="475" width="30" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;all payouts succeeded?&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="429" y="449" width="105" height="32" as="geometry"/></mxCell><mxCell id="c13" value="Close the settlement and the Batch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="305" y="529" width="210" height="46" as="geometry"/></mxCell><mxCell id="c14" value="Resend the failed instruction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="45" y="530" width="210" height="44" as="geometry"/></mxCell><mxCell id="c15" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="398" y="599" width="24" height="24" as="geometry"/></mxCell><mxCell id="16" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="138"/></Array></mxGeometry></mxCell><mxCell id="17" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="206.5"/></Array></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="283"/></Array></mxGeometry></mxCell><mxCell id="19" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="402"/></Array></mxGeometry></mxCell><mxCell id="21" value="[yes]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="[no]" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry x="-0.8428" relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="490"/></Array></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c14" target="c9"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="34" y="552"/><mxPoint x="34" y="342"/></Array></mxGeometry></mxCell><mxCell id="25" value="&lt;b&gt;Notes&lt;/b&gt; — Approval locks the statement and creates one payment instruction per payee (Figure 4.12); the sandbox gateway answers at once (Created → Succeeded or Failed). The last successful payout closes the settlement and the Batch.&lt;br&gt;Traceability: UC38, UC37, UC35, UC36, UC39, UC40 (TP1 Thiện). Worked example (Register v1.4): Standard Cost 100,000,000 VND; revenue 300,000,000 VND → Pool 200,000,000 VND; survival 90% above an 85% threshold → remuneration 10% = 20,000,000 VND; A receives 15,000,000 + 27,000,000 = 42,000,000 VND, B the same, C 196,000,000 VND, so payouts plus remuneration equal the revenue; at 80% survival the remuneration halves. Exception branches: negative Revenue Pool (loss capped at capital, no capital call, no carry-over), recalculation, investor feedback, failed payout resent. «planned» in v1.4: revenue lines InvoicedSale (low-grade or resold crabs), ForfeitedDeposit and FinalOrder (the code counts completed orders and offtake forfeits), remuneration tiers by survival rate (the code uses one fixed percentage). Survival = 1 − deaths ÷ crabs stocked in the funded boxes; restocked crabs that die count, deaths in transit only lower revenue. Unused Standard Cost, including an unused mortality reserve, stays with the Operator; only an early liquidation returns unspent capital. Removed in v1.4 (still in code): offtake forfeits as revenue. States: settlement Draft → Proposed ⇄ Disputed → Approved → PaidOut → Closed (Figure 4.14); payment instruction Created → Succeeded / Failed (4.12); Batch Settlement → Closed (4.8).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="824" y="76" width="420" height="412" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5 activity with partitions, business level) — green rounded box = action (verb + object); orange box = object node [state]; small diamond = decision (guards in brackets) or merge; black bar = fork or join; hourglass = time event; circle with a letter = connector to another part of the same figure; filled dot = start; ringed dot = activity final; circle with a cross = flow final. Dashed grey with «planned» = in Register v1.4, not yet on develop @ 420a379; &quot;(… «planned»)&quot; = the step exists, that part does not." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="824" y="498" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>