mxCell id="c18" value="&lt;i&gt;Login (Figure 3.1a, 1 of 2) · PlatformAdmin | EvidenceReviewer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8fafc;strokeColor=#64748b;dashed=1;dashPattern=2 3;fontSize=12;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="226" height="54" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c18" target="c4"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="&lt;b&gt;Notes&lt;/b&gt; — Every screen of the console is reachable from the sidebar menu; arrows show the main task paths only. Evidence review pages need the EvidenceReviewer role; users and escalated alerts need PlatformAdmin. The settings page wires only the fee tiers today; minimum contribution and deposit ratio are set per Batch, the hold time in the server configuration (appsettings). Who imports the historical price dataset is an assumption to confirm.&lt;br&gt;&lt;b&gt;Removed in v1.4 (still in code)&lt;/b&gt;: Storefront moderation /admin/storefront (product listings).&lt;br&gt;&lt;b&gt;Legend&lt;/b&gt; (not UML; routes as in web/src/app/router.tsx and mobile/lib/app/routes.dart on develop @ 420a379) — box = screen (name, route); dashed grey with «planned» = screen in Register v1.4 with no route on develop; grey line &quot;v1.4: … «planned»&quot; = the screen exists, the v1.4 additions are not built yet; dotted rounded box = link to another figure or part." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="986" y="80" width="430" height="247" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Mobile screen flow" id="Mobile_screen_flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 3.2 – Screen Flow: Flutter app (go_router, StatefulShellRoute per role)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1040" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;no login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=0;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="316" height="518" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Investor tabs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;the tab bar reaches every screen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=0;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="316" height="886" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Operator tabs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;the tab bar reaches every screen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;f