ndFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="628" y="345"/><mxPoint x="628" y="553"/></Array></mxGeometry></mxCell><mxCell id="22" value="sign" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c14"><mxGeometry x="0.0549" relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="179.6"/><mxPoint x="660" y="553"/></Array></mxGeometry></mxCell><mxCell id="25" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value="own rows" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;fontColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry x="0.0000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry x="0.0000" relative="1" as="geometry"><Array as="points"><mxPoint x="928" y="253"/><mxPoint x="928" y="442.5"/></Array></mxGeometry></mxCell><mxCell id="28" value="&lt;b&gt;Notes&lt;/b&gt; — Every screen of the portal is reachable from its menu; arrows show the main task paths only. The notification bell (30 s poll) sits in the portal header. Batch detail → Contribute is the path in code today; v1.4 puts the box-row picker «planned» in between: each box row goes to one investor, the amount is the total capital of the chosen rows and the minimum is one row. The contribute wizard creates the contract before the VietQR transfer; signing does not block payment.&lt;br&gt;&lt;b&gt;Removed in v1.4 (still in code)&lt;/b&gt;: Investor offtake commitments (portal view &quot;offtake&quot;).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead.&lt;br&gt;&lt;b&gt;Legend&lt;/b&gt; (not UML; routes as in web/src/app/router.tsx and mobile/lib/app/routes.dart on develop @ 420a379) — box = screen (name, route); dashed grey with «planned» = screen in Register v1.4 with no route on develop; grey line &quot;v1.4: … «planned»&quot; = the screen exists, the v1.4 additions are not built yet; dotted rounded box = link to another figure or part." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="986" y="80" width="430" height="277" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Web 2 – Operator workspace" id="Web_2___Operator_workspace"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 3.1b – Screen Flow: web application – Operator workspace (role OperatorMember)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1040" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Operator workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;the sidebar menu reaches every screen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=0;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="616" height="1004" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;/operator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="