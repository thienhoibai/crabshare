tryDx=0;entryDy=0;" edge="1" parent="1" source="c80" target="c94"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="363" y="702"/><mxPoint x="363" y="336"/></Array></mxGeometry></mxCell><mxCell id="119" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.151;entryDx=0;entryDy=0;" edge="1" parent="1" source="c88" target="c94"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="373" y="904"/><mxPoint x="373" y="350"/></Array></mxGeometry></mxCell><mxCell id="120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERoneToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.029;entryDx=0;entryDy=0;" edge="1" parent="1" source="c96" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="343" y="376"/><mxPoint x="343" y="123.5"/></Array></mxGeometry></mxCell><mxCell id="121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERoneToMany;endArrow=ERmandOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.017;entryDx=0;entryDy=0;" edge="1" parent="1" source="c106" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="749" y="138"/><mxPoint x="749" y="113"/></Array></mxGeometry></mxCell><mxCell id="122" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK identifier · FK reference (the line starts at this row) · FK* also part of a composite FK that keeps both rows in the same Batch · U single-attribute business key · BK (…) composite business key · [0..1] optional · / derived or snapshot value.&lt;br&gt;Types are DBMS-independent: Integer, Money (integer VND), Decimal, Text, Date, DateTime, Boolean, UUID. Crow's foot: child end O&amp;lt; (many), | &amp;lt; (one or more) or O| (one-to-one); parent end | (required) or O| (optional).&lt;br&gt;Grey dashed = «planned» (Register v1.4, not in code); amber «changed» = meaning or values change in v1.4. White box = parent entity of another area or part, key only. Audit references to User are not drawn. Removed items: Notes of Figure 4.2." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1078" width="1052" height="114" as="geometry"/></mxCell><mxCell id="123" value="&lt;b&gt;Notes&lt;/b&gt; — Design decisions of 05/11/2026 applied here were confirmed by the lead (Batch opening condition, minimum contribution = capital of one box row)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1202" width="1052" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A2 (2 of 2) · Funding and contracts" id="A2__2_of_2____Funding_and_contracts"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.2.2 (2/2) – Logical ERD: Batch, Standard Cost, funding and contracts — Funding and contracts (Register v1.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · crow's foot · 8 entities + 4 parent entities of other areas or parts (white, key only) · lines start at the foreign-key row&lt;/font&gt;" style="text;html=1;align=left;vertical