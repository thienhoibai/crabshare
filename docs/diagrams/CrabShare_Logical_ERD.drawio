mily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERmandOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.594;entryDx=0;entryDy=0;" edge="1" parent="1" source="c73" target="c94"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="363" y="118"/><mxPoint x="363" y="588"/></Array></mxGeometry></mxCell><mxCell id="104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.164;entryDx=0;entryDy=0;" edge="1" parent="1" source="c81" target="c72"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="383" y="702"/><mxPoint x="383" y="105"/></Array></mxGeometry></mxCell><mxCell id="105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERmandOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.044;entryDx=0;entryDy=0;" edge="1" parent="1" source="c82" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="393" y="722"/><mxPoint x="393" y="136"/></Array></mxGeometry></mxCell><mxCell id="106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERmandOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.025;entryDx=0;entryDy=0;" edge="1" parent="1" source="c90" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="343" y="362"/><mxPoint x="343" y="122"/></Array></mxGeometry></mxCell><mxCell id="107" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK identifier · FK reference (the line starts at this row) · FK* also part of a composite FK that keeps both rows in the same Batch · U single-attribute business key · BK (…) composite business key · [0..1] optional · / derived or snapshot value.&lt;br&gt;Types are DBMS-independent: Integer, Money (integer VND), Decimal, Text, Date, DateTime, Boolean, UUID. Crow's foot: child end O&amp;lt; (many), | &amp;lt; (one or more) or O| (one-to-one); parent end | (required) or O| (optional).&lt;br&gt;Grey dashed = «planned» (Register v1.4, not in code); amber «changed» = meaning or values change in v1.4. White box = parent entity of another area or part, key only. Audit references to User are not drawn. Removed items: Notes of Figure 4.2." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="896" width="1066" height="114" as="geometry"/></mxCell><mxCell id="108" value="&lt;b&gt;Notes&lt;/b&gt; — Design decisions of 05/11/2026 applied here were confirmed by the lead (InvoicedSale with SaleReason, one Invoice per delivered order, balance on the weighed kg, forfeited deposits)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1066" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A6 · Payments, settlement and audit" id="A6___Payments__settlement_and_audit"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.2.6 – Logical ERD: Payments, settlement and audit (Register v1.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quo