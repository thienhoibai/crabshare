;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c72"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="383" y="352"/><mxPoint x="383" y="508"/></Array></mxGeometry></mxCell><mxCell id="87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.038;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="373" y="138"/><mxPoint x="373" y="272"/></Array></mxGeometry></mxCell><mxCell id="88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.068;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="403" y="696"/><mxPoint x="403" y="286"/></Array></mxGeometry></mxCell><mxCell id="89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.704;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c74"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="343" y="716"/><mxPoint x="343" y="794"/></Array></mxGeometry></mxCell><mxCell id="90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERzeroToOne;strokeColor=#334155;dashed=1;dashPattern=6 4;strokeColor=#64748b;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.704;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="363" y="712"/><mxPoint x="363" y="592"/></Array></mxGeometry></mxCell><mxCell id="91" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK identifier · FK reference (the line starts at this row) · FK* also part of a composite FK that keeps both rows in the same Batch · U single-attribute business key · BK (…) composite business key · [0..1] optional · / derived or snapshot value.&lt;br&gt;Types are DBMS-independent: Integer, Money (integer VND), Decimal, Text, Date, DateTime, Boolean, UUID. Crow's foot: child end O&amp;lt; (many), | &amp;lt; (one or more) or O| (one-to-one); parent end | (required) or O| (optional).&lt;br&gt;Grey dashed = «planned» (Register v1.4, not in code); amber «changed» = meaning or values change in v1.4. White box = parent entity of another area or part, key only. Audit references to User are not drawn. Removed items: Notes of Figure 4.2." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="1102" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A4 · Harvest, traceability and pricing" id="A4___Harvest__traceability_and_pricing"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.2.4 – Logical ERD: Harvest, traceability and pricing (Register v1.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · crow's foot · 6 entities + 4 parent entities of other areas or parts (white, key only) · lines start at the foreign-key row&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=