 checkout (listing stock hold))&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#6b7280&quot;&gt;—&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;stock_reservation&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;StockReservation&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#6b7280&quot;&gt;removed in v1.4 (code only)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#475569&quot;&gt;— technical log (hash-chained audit)&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;AuditRecord&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;audit_log&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;AuditLog&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PaymentInstruction&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PaymentInstruction&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;payment_instruction&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PaymentInstruction&lt;