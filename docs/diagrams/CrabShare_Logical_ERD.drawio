tlement&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Settlement&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;settlement&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Settlement&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;; + SurvivalRatePct, AppliedTierId &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;; &lt;font color=&quot;#b45309&quot;&gt;changed: OperatorSharePct&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementFeedback&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementFeedback&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;settlement_feedback&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementFeedback&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementLine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementLine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;settlement_line&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SettlementLine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;RevenueLine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;RevenueLine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;— (no table yet)&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;RevenueLine «planned»&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1104" height="857" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Table 4.2 (3 of 3) Value domains" id="Table_4_2__3_of_3__Value_domains"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Table 4.2 (3/3) – Traceability: value domains that change in Register v1.4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · every Conceptual entity is found in the Logical ERD; «planned» entities have no table or class in code yet&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="887" height="46" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Value domains that change in Register v1.4&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="900" height="20" as="geometry"/></mxCell><mxCell id="4" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:230px;&quot;&gt;Attribute&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:560px;&quot;&gt;Values in Register v1.4&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:314px;&quot;&gt;Allowed today by CHECK (V001–V017)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SalesOrder.OrderType&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;BulkPreOrder · InvoicedSale · FinalOrder&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Retail · PreOrder · Offtake &lt;font color=&quot;#c2410c&quot;&gt;&lt;i&gt;(not written by code)&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SalesOrder.SaleReason&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;LowGrade · ForfeitResale (InvoicedSale only) «planned»&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;SalesOrder.Status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;BulkPreOrder (Figure 4.17): PendingPayment · DepositPaid · Confirmed «planned» · Packed · Shipping · Delivered · Completed · Returned · Cancelled · Refunded «planned» · Forfeited «planned». InvoicedSale and FinalOrder (Figure 4.18): PendingPayment → Completed only; a cancel or expiry path is still an open point&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PendingPayment · DepositPaid · Paid · Packed · Shipping · Delivered · Completed · Cancelled · Returned&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PaymentRequest.Purpose&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Contribution · PreOrderDeposit · PreOrderBalance · OrderPayment, reused for InvoicedSale and FinalOrder «planned»&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Contribution · OrderPayment · PreOrderDeposit · PreOrderBalance · OfftakeDeposit · OfftakePayment &lt;font color=&quot;#c2410c&quot;&gt;&lt;i&gt;(not written by code)&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;RevenueLine.LineType&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;DeliveredOrder · InvoicedSale · ForfeitedDeposit · FinalOrder (each forfeited deposit counted once)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;— (revenue read from view v_batch_actual_revenue)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;RowAllocation.Status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Held (30-minute reservation) · Allocated (contribution Confirmed) · Released (expired or refunded)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PreOrderHold.Status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Active (holding crabs on the quota) · Deposited (deposit paid) · Released (expired or cancelled)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;IngestionMessage.MessageType / Status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;DailyLog · Feeding · Health · BoxEvent · Photo / Received · Accepted · Rejected · Duplicate&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;— (source FarmApi already allowed on ProductionLog, BoxEvent, Evidence)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PriceObservation.Source&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;FarmInterview · Press (dated report) · Simulated&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Settlement.OperatorSharePct&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;remuneration % after the survival tier (RemunerationTier.RemunerationPct, never higher when survival is lower)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;fixed Batch.OperatorSharePct&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="1104" height="312" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Reading the table&lt;/b&gt; — 53 Conceptual entities → 61 Logical entities (11 «planned», no table yet) → 60 physical tables, of which 10 are removed from the v1.4 business model but kept by code. Logical-only entities come from decomposing many-to-many relationships, from technical detail tables or from technical logs. The Code class column is the C# entity class (EF scaffold), so Class Diagrams that use code names (PhysicalSlot, SlotAllocation, CrabItem, KycCheck, AuditLog…) map to the business names here. Where code and Register v1.4 differ the Logical ERD follows v1.4 and the Physical ERD follows code; the differences are the &quot;Known Gaps&quot; of the Design Brief. Design decisions of 05/11/2026 applied here were confirmed by the lead (row allocation statuses, InvoicedSale with SaleReason, revenue line types)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1104" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>