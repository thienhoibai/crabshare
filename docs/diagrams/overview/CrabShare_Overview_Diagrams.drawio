a3b8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="442" as="sourcePoint"/><mxPoint x="1320" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="63" value="&lt;b&gt;3 · Produce&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fillColor=#f1f5f9;strokeColor=#94a3b8;rounded=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="862.2" width="130" height="108" as="geometry"/></mxCell><mxCell id="64" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="859.2" as="sourcePoint"/><mxPoint x="1320" y="859.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="65" value="&lt;b&gt;4 · Harvest and sell&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fillColor=#f1f5f9;strokeColor=#94a3b8;rounded=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="974.2" width="130" height="164" as="geometry"/></mxCell><mxCell id="66" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="971.2" as="sourcePoint"/><mxPoint x="1320" y="971.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="67" value="&lt;b&gt;5 · Settle&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fillColor=#f1f5f9;strokeColor=#94a3b8;rounded=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1142.2" width="130" height="276" as="geometry"/></mxCell><mxCell id="68" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1139.2" as="sourcePoint"/><mxPoint x="1320" y="1139.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="69" value="&lt;b&gt;Simplified view&lt;/b&gt; — the five demo workflows in one flow; each lane is an actor. Funding order follows the code: eKYC → risk acknowledgement → amount (box rows planned) and 30-minute reservation → contract (Operator signs first) and VietQR payment, which do not block each other → funding close: the batch opens when the minimum viable capital is reached and the pre-order ratio is at least the minimum (ratio planned); otherwise contributions and every deposit are refunded, and between the minimum and the target only the funded boxes are stocked. Phase 3 repeats daily until harvest. Money never passes through CrabShare: payments and payouts go through the batch account at the payment provider. Dashed grey or «planned» = in Register v1.4, not in code yet. Detailed workflows: Figures O.18–O.22 and Figures 4.31–4.35.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="1451.2" width="1150" height="87" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O18 Activity – WF-01" id="O18_Activity___WF_01"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.18 – Activity Diagram: WF-01 Create a batch by box rows, price it and open funding (Operator, Platform Administrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="300" height="922" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="340" y="66" width="300" height="922" as="geometry"/></mxCell><mxCell id="c5" value="Platform Administrator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="640" y="66" width="300" height="922" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="177" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c7" value="Register boxes with their row code and box number" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="240" height="48" as="geometry"/></mxCell><mxCell id="c8" value="Create a batch on chosen box rows" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="228" width="240" height="48" as="geometry"/></mxCell><mxCell id="c9" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="175" y="295" width="30" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Author the Standard Cost (items, mortality reserve, tranche plan)" style="rounded=1;whiteSpace=wrap;htm