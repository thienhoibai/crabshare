Funding · Contracts · Payments · Settlement · Portfolio · Production · Evidence · Alerts · Harvest · Orders · Admin · Health&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="530" y="206" width="400" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Price Module&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="950" y="206" width="210" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Ingestion&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="950" y="241" width="210" height="30" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Farm Map query&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="950" y="276" width="210" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;[C3.3]&lt;/b&gt; &lt;b&gt;Background jobs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;8 hosted jobs (v1.4)&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamil