x="1" parent="1"><mxGeometry x="836" y="332" width="244" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;UC55&lt;/b&gt; Cancel Bulk Pre-order&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;(forfeit once the Batch opens &lt;i&gt;«planned»&lt;/i&gt;)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="536" y="432" width="244" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;UC54&lt;/b&gt; Forfeit Deposit&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;fontSize=11;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="836" y="432" width="244" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SD5 · Settlement &amp;amp; Oversight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;UC35–UC43 · Figure 2.6&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;fontSize=13;fillColor=#f8fafc;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="520" y="532" width="576" height="128" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;UC35&lt;/b&gt; Review Settlement Statement" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="536" y="590" width="244" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;UC39&lt;/b&gt; Approve Settlement and Issue Payouts" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;fontSize=11;" vert