rder" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="312" as="sourcePoint"/><mxPoint x="755" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="VietQR deposit request" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="350" as="sourcePoint"/><mxPoint x="965" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="deposit QR code" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539" y="388" as="sourcePoint"/><mxPoint x="335" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="pay the deposit" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="426" as="sourcePoint"/><mxPoint x="965" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="payment webhook" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="464" as="sourcePoint"/><mxPoint x="551" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="order DepositPaid" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="502" as="sourcePoint"/><mxPoint x="755" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="At funding close the batch opens and the order becomes Confirmed &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;; otherwise every paid deposit is refunded, cancelled orders included. A Customer who cancels after paying (UC55) loses the deposit once the batch opens (UC54, Figure 4.58). Removed in v1.4 (still on develop): pre-orders on a listing while the batch is InProduction, with the balance asked for when harvesting starts." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="534" width="1090" height="46" as="geometry"/></mxCell><mxCell id="26" value="record harvest per box (UC22)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="598" as="sourcePoint"/><mxPoint x="551" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="prepare the delivery note &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="636" as="sourcePoint"/><mxPoint x="551" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="Packed; order QR code issued &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="674" as="sourcePoint"/><mxPoint x="755" y="674" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="deliver; record the weighed kg &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="712" as="sourcePoint"/><mxPoint x="551" y="712" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="balance = weighedKg × price − deposit &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="750" as="sourcePoint"/><mxPoint x="755" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="VietQR balance request" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="822" as="sourcePoint"/><mxPoint x="965" y="822" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="pay the balance (UC30)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="860" as="sourcePoint"/><mxPoint x="965" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="payment webhook" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="898" as="sourcePoint"/><mxPoint x="551" y="898" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="Delivered; return window starts" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="936" as="sourcePoint"/><mxPoint x="755" y="936" as="targetPoint"/></mxGeometry></mxCell><mxCell id="35" value="deposit Forfeited; crabs to the invoiced sale &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="551" y="1004" as="sourcePoint"/><mxPoint x="755" y="1004" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="scan the order QR (UC33) &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="1056" as="sourcePoint"/><mxPoint x="539" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="37" value="farm, batch and harvest record" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539" y="1094" as="sourcePoint"/><mxPoint x="125" y="1094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="&lt;b&gt;Legend&lt;/b&gt; — filled arrow: request · open arrow: asynchronous message · dashed: reply · narrow bar: activation of the API or library while it handles the messages · dashed participant or «planned»: not on develop yet. Participants are grouped (one box for the whole API); the detailed diagrams show controllers, services and ports: Figures 4.52–4.53, 4.55–4.58.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1178" width="1220" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O26 Sequence – Evidence" id="O26_Sequence___Evidence"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.26 – Sequence Diagram: device data, live evidence capture and review (UC52, UC45, UC47, UC48)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI