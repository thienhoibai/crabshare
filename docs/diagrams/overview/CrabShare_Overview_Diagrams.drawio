olor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c27" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="58" value="[more]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="59" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c28" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="1058.2"/></Array></mxGeometry></mxCell><mxCell id="60" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="61" value="[fail]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="62" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="63" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c29" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="64" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="65" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;WF-03 · owner Khôi&lt;/b&gt; — UC17, UC52, UC19, UC20, UC45, UC47, UC48, UC21, UC53 (stocking from WF-02; the milestone tranches of Figure 4.33 are summarised in Figure O.13).&lt;br&gt;Each day's data comes either from the Operator in the app or, planned, from the simulated farm devices and cameras through one common data channel (a decision with a merge, not a fork). Alerts in v1.4: Mortality, MilestoneDelay, DataSilence and EvidenceFlag. A background job issues one random capture request per batch and day. The detection module only says whether a crab is present and adds to the risk score; a person decides: the Platform Administrator holding the Evidence Reviewer permission, never on a batch they invested in. An Investor viewing the box details of own rows is a separate flow with its own start.&lt;br&gt;Exception branches: alert; flagged evidence with the explanation loop (the merge before the review takes both the first review and the review after an explanation); rejected evidence.&lt;br&gt;States: evidence Accepted / Watch / Flagged / Rejected; capture request Open → Fulfilled / Expired; alert Open → Acknowledged / Escalated → Resolved.&lt;br&gt;Overview of all five: Figure O.17 · detailed: Figure 4.33 (3 parts).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="66" width="450" height="274" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;Register v1.4 vs code&lt;/b&gt; — planned: the common data channel and the simulator (no ingestion endpoint on develop), a real detection module (develop has a no-op detector behind the detection port), row-scoped box details for investors (develop shows a batch timeline to every investor of the batch). Removed in v1.4 (still in code, not drawn): WaterQuality alerts, the water thresholds (ProductionThresholdVersion) and the temperature, salinity and pH readings of daily logs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="356" width="450" height="109" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Legend&lt;/b&gt; — green: human action · blue: system action · yellow: external system · diamond: decision with guards, or merge · bar: fork / join · orange box: object with state · hourglass (collate) shape: time event · ◉ activity final · ⊗ flow final · dashed grey with «planned»: Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="481" width="450" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O21 Activity – WF-04" id="O21_Activity___WF_04"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.21 – Activity Diagram: WF-04 Bulk pre-order, weighed delivery, invoiced and final orders (Customer, Operator, Platform Administrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="240" height="1404.4" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="66" width="240" height="1404.4" as="geometry"/></mxCell><mxCell id="c5" value="Platform Administrator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="66" width="240" height="1404.4" as="geometry"/></mxCell><mxCell id="c6" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="760" y="66" width="240" height="1404.4" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="147" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c8" value="Find farms that deliver to the address; open a funding batch &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="168" width="200" height="48" as="geometry"/></mxCell><mxCell id="c9" value="Pre-order by crab count (or kg) from the minimum quantity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="224" width="200" height="48" as="geometry"/></mxCell><mxCell id="c10" value="Hold the crabs (no overselling); issue the VietQR deposit (15 min)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="200" height="48" as="geometry"/></mxCell><mxCell id="c11" value="pays the deposit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="332" width="160" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Pay the deposit by VietQR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="417.2" width="200" height="48" as="geometry"/></mxCell><mxCell id="c13" value="Cancelled: hold released, nothing lost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="297" y="416.2" width="150" height="50" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="475" y="428.2" width="26" height="26" as="geometry"/></mxCell><mxCell id="c15" value="Deposit confirmed; crabs held until funding close" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="473.2" width="200" height="48" as="geometry"/></mxCell><mxCell id="c16" value="batch opens?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="550.4" width="160" height="56" as="geometry"/></mxCell><mxCell id="c17" value="Send the deposit refund &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="537" y="554.4" width="150" height="48" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="711" y="565.4" width="26" height="26" as="geometry"/></mxCell><mxCell id="c19" value="cancelled after&lt;br&gt;paying (UC55)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="631.6" width="160" height="56" as="geometry"/></mxCell><mxCell id="c20" value="Forfeit the deposit (ForfeitedDeposit) &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="297" y="715.8" width="150" height="50" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="475" y="727.8" width="26" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Prepare the delivery note; the order QR code is issued &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="780" y="716.8" width="200" height="48" as="geometry"/></mxCell><mxCell id="c23" value="Deliver and weigh the crabs at the door" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="780" y="772.8" width="200" height="48" as="geometry"/></mxCell><mxCell id="c24" value="accept and pay&lt;br&gt;the balance?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="824.8" width="160" height="56" as="geometry"/></mxCell><mxCell id="c25" value="Pay the balance = weighed kg × price − deposit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="200" height="48" as="geometry"/></mxCell><mxCell id="c26" value="Forfeit the deposit; crabs back to stock &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="297" y="906" width="150" height="56" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="475" y="921" width="26" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Scan the QR: farm, batch, harvest record &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="966" width="200" height="48" as="geometry"/></mxCell><mxCell id="c29" value="problem in the&lt;br&gt;return window?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="1018" width="160" height="56" as="geometry"/></mxCell><mxCell id="c30" value="Return or complain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="130" y="1103.2" width="140" height="48" as="geometry"/></mxCell><mxCell id="c31" value="request type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="320" y="1099.2" width="160" height="56" as="geometry"/></mxCell><mxCell id="c32" value="Resolve the complaint with the Operator's answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="555" y="1103.2" width="170" height="48" as="geometry"/></mxCell><mxCell id="c33" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="385" y="1193.4" width="30" height="30" as="geometry"/></mxCell><mxCell id="c34" value="outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="1180.4" width="160" height="56" as="geometry"/></mxCell><mxCell id="c35" value="Order Returned; create the refund instruction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="1240.4" width="200" height="48" as="geometry"/></mxCell><mxCell id="c36" value="Send the refund instruction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="537" y="1240.4" width="150" height="48" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="711" y="1251.4" width="26" height="26" as="geometry"/></mxCell><mxCell id="c38" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="385" y="1305.4" width="30" height="30" as="geometry"/></mxCell><mxCell id="c39" value="return window ends" style="shape=collate;whiteSpace=nowrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="387" y="1359.4" width="26" height="34" as="geometry"/></mxCell><mxCell id="c40" value="Order Completed: revenue counts for settlement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="297" y="1404.4" width="150" height="56" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=mxgraph.flowchart.or;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="475" y="1419.4" width="26" height="26" as="geometry"/></mxCell><mxCell id="c42" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="867" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c43" value="Record the harvest per box (weight, grade)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="780" y="168" width="200" height="48" as="geometry"/></mxCell><mxCell id="c44" value="sales window closed" style="shape=collate;whiteSpace=nowrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="867" y="231" width="26" height="34" as="geometry"/></mxCell><mxCell id="c45" value="Record invoiced sales (InvoicedSale): low-grade crabs and crabs of forfeited orders &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="780" y="272" width="200" height="64" as="geometry"/></mxCell><mxCell id="c46" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="865" y="345" width="30" height="30" as="geometry"/></mxCell><mxCell id="c47" value="Record the final order of the leftover crabs to the committed buyer &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="785" y="413.2" width="190" height="56" as="geometry"/></mxCell><mxCell id="c48" value="price ≥&lt;br&gt;floor price?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="800" y="473.2" width="160" height="48" as="geometry"/></mxCell><mxC