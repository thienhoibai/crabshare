dashed=1;strokeColor=#64748b;fontColor=#64748b;align=left;spacingLeft=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="38" value="HTTPS GET" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;align=left;spacingLeft=6;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="39" value="HTTPS POST · HMAC-SHA256" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.85;exitY=0;" edge="1" parent="1" source="c30" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1584" y="150"/></Array></mxGeometry></mxCell><mxCell id="40" value="calls" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="41" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=0;entryX=0.35;entryY=1;" edge="1" parent="1" source="c23" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.95;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="use ports" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.03;exitY=1;entryX=0.019;entryY=0;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="TDS 1433 · TLS · Managed Identity" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.1667;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell><mxCell id="46" value="file I/O" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5397;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell><mxCell id="47" value="HTTPS Upload API · signed URL" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.8952;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c26" target="c29"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell><mxCell id="48" value="REST/HTTPS (sandbox)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c30"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="49" value="REST/HTTPS (sandbox)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c31"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="50" value="REST/HTTPS (sandbox)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c32"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="51" value="loads in-process «planned»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c33"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="52" value="&lt;b&gt;Legend&lt;/b&gt; — blue: CrabShare component · yellow: external system · cylinder: data store · ○ provided interface on the API border · dashed grey or «planned»: Register v1.4, not in code yet. Solid arrow = communication path, labelled with its protocol; dashed arrow = dependency or use. &quot;Sandbox&quot;: the payment, signing and eKYC adapters run in-process as Fake adapters today. Codes are those of Figure 4.1 (1/2, 2/2) and Table 4.1; the Farm Management System is no longer drawn (farm systems are represented by the simulator through the one Ingestion API)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="450" height="120" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;C1 Web App&lt;/b&gt; — React 19 + Vite single-page app on Vercel for all four roles; calls the API only through the shared HTTP client with the JWT.&lt;br&gt;&lt;b&gt;C1.3 Farm map&lt;/b&gt; — planned: the Customer picks on a map a farm whose delivery radius covers the address (UC25).&lt;br&gt;&lt;b&gt;C2 Mobile App&lt;/b&gt; — Flutter app for Investor and Operator: camera-only evidence with GPS, harvest per box, QR scan.&lt;br&gt;&lt;b&gt;X5 Device &amp;amp; Camera Simulator&lt;/b&gt; — planned: posts photos, feeding, box events and logs through the Ingestion API in place of hardware (UC52).&lt;br&gt;&lt;b&gt;X6 Map tile service&lt;/b&gt; — planned: base map tiles for the farm map, loaded by the browser; provider not chosen.&lt;br&gt;&lt;b&gt;X7 Static web resources&lt;/b&gt; — Google Fonts and landing-page photos loaded directly by the browser; no user data is sent.&lt;br&gt;&lt;b&gt;I1 REST API&lt;/b&gt; — HTTPS, JSON, Bearer JWT with role policies; trace and health endpoints are anonymous.&lt;br&gt;&lt;b&gt;I2 Ingestion API&lt;/b&gt; — planned: POST /api/ingest/v1/* with an API key, idempotent by message id (IngestionMessage).&lt;br&gt;&lt;b&gt;I3 Payment webhook&lt;/b&gt; — signed (HMAC) transaction notice from the intermediary; each bank transaction is recorded once.&lt;br&gt;&lt;b&gt;C3.1 REST controllers&lt;/b&gt; — 51 controller classes in 49 files: input validation, role and Batch-scoped checks, errors as ProblemDetails.&lt;br&gt;&lt;b&gt;C3.2 Feature modules&lt;/b&gt; — vertical slices kept by v1.4; Price Module (range by season and holidays, MAPE, never a return), Ingestion and Farm Map query are planned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="780" height="187" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;C3.3 Background jobs&lt;/b&gt; — eight hosted jobs kept by v1.4: reservation expiry, funding close with refunds, tranche schedule, order completion, complaint escalation, capture requests, alerts, audit-chain check; the final-order reminder is planned. The pre-order balance job is removed in v1.4 (still in code).&lt;br&gt;&lt;b&gt;C3.4 Common&lt;/b&gt; — JWT auth and policies, current user, append-only hash-chained audit log, alert port, errors, paging, exports.&lt;br&gt;&lt;b&gt;C3.5 Settlement engine&lt;/b&gt; — pure library: Revenue Pool, remuneration, largest-remainder payouts, loss cap; the tier cut is planned.&lt;br&gt;&lt;b&gt;C3.6 Infrastructure&lt;/b&gt; — ports and adapters: EF Core persistence, storage, payment, signing, eKYC, crab detection (no-op until the model exists), security.&lt;br&gt;&lt;b&gt;C3.7 Dev-only endpoints&lt;/b&gt; — simulated bank transfer, demo pre-orders and settlement helpers, OpenAPI; 404 outside Development.&lt;br&gt;&lt;b&gt;D1 SQL Server&lt;/b&gt; — Azure SQL in production, LocalDB in development; schema V001–V017 by DbMigrator.&lt;br&gt;&lt;b&gt;D2 File storage&lt;/b&gt; — App Service disk for contract PDFs and older uploads.&lt;br&gt;&lt;b&gt;X1 Payment intermediary&lt;/b&gt; — holds each Batch's account, VietQR collection, refunds and payouts; CrabShare never holds money; simulated.&lt;br&gt;&lt;b&gt;X2, X3 Viettel signing, eKYC&lt;/b&gt; — sequential contract signing and identity check (only the result is kept); both simulated.&lt;br&gt;&lt;b&gt;X4 Cloudinary&lt;/b&gt; — real image storage account for evidence photos, read back through short-lived signed URLs.&lt;br&gt;&lt;b&gt;M1 Crab detection model&lt;/b&gt; — planned: trained on labelled box photos, loaded in-process; it only says whether a crab is present and never rejects evidence alone." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="856" width="790" height="201" as="geometry"/></mxCell><mxCell id="55" value="&lt;b&gt;What each block does (codes as in Figure 4.1 (1/2, 2/2) and Table 4.1)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1580" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O6 Logical ERD" id="O6_Logical_ERD"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.6 – Logical ERD: Register v1.4 entities by data area, keys, n–n links resolved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;A1 · Identity, accounts, farm &amp;amp; boxes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="520" height="470" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#eef2ff;strokeColor=#3730a3;swimlaneFillColor=#ffffff;fontSize=12;fontFamily=Segoe UI;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="106" width="230" height="82" as="geometry"/></mxCell><mxCell id="5" value="PK UserId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c4"><mxGeometry x="0" y="24" width="230" height="18" as="geometry"/></mx