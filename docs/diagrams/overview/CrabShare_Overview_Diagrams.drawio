tion&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=66;fontSize=12;fillColor=#ede9fe;dashed=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="170" height="722" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=66;fontSize=12;fillColor=#f1f5f9;" vertex="1" parent="1"><mxGeometry x="1180" y="80" width="170" height="722" as="geometry"/></mxCell><mxCell id="c10" value="Platform Administrator&lt;br&gt;(Evidence Reviewer)" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="1435" y="80" width="40" height="722" as="geometry"/></mxCell><mxCell id="11" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="689" y="200" width="12" height="488" as="geometry"/></mxCell><mxCell id="12" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1069" y="404" width="12" height="22" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;opt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="46" y="172" width="1470" height="108" as="geometry"/></mxCell><mxCell id="14" value="&lt;font style=&quot;font-size:11px&quot;&gt;[device and camera data &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="112" y="172" width="480" height="24" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;opt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="46" y="524" width="1470" height="184" as="geometry"/></mxCell><mxCell id="16" value="&lt;font style=&quot;font-size:11px&quot;&gt;[Watch or Flagged]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="112" y="524" width="480" height="24" as="geometry"/></mxCell><mxCell id="17" value="feeding, box events, photos (API key)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="210" as="sourcePoint"/><mxPoint x="689" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="store on the box timeline" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="701" y="248" as="sourcePoint"/><mxPoint x="1265" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="take a live photo of a box" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="300" as="sourcePoint"/><mxPoint x="315" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="photo, server time, location, box no." style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="338" as="sourcePoint"/><mxPoint x="689" y="338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="store the image; SHA-256" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="701" y="376" as="sourcePoint"/><mxPoint x="885" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="is a crab present? &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="701" y="414" as="sourcePoint"/><mxPoint x="1069" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="save evidence + risk score" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="701" y="452" as="sourcePoint"/><mxPoint x="1265" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="Accepted, Watch or Flagged" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="689" y="490" as="sourcePoint"/><mxPoint x="315" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="open the review queue" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1455" y="562" as="sourcePoint"/><mxPoint x="701" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" value="verdict: Pass, Fail or more" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1455" y="600" as="sourcePoint"/><mxPoint x="701" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="update status; notify Operator" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="701" y="638" as="sourcePoint"/><mxPoint x="1265" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="send an explanation (if asked)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="676" as="sourcePoint"/><mxPoint x="689" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="Camera-only capture in the app; random capture requests come from a background job. The detection module only says whether a crab is present and adds to the risk score; it never rejects a photo alone, and reviewers never judge their own investments." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="722" width="1350" height="32" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Legend&lt;/b&gt; — filled arrow: request · open arrow: asynchronous message · dashed: reply · narrow bar: activation of the API or library while it handles the messages · dashed participant or «planned»: not on develop yet. Participants are grouped (one box for the whole API); the detailed diagrams show controllers, services and ports: Figures 4.49, 4.66–4.67." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="1480" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O27 Class – Slice pattern" id="O27_Class___Slice_pattern"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.27 – Class Diagram: the pattern every backend module follows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/>