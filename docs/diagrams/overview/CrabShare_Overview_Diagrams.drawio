><mxPoint x="925" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="Pool, remuneration, largest remainder" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="274" as="sourcePoint"/><mxPoint x="719" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="save settlement Draft + lines" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="312" as="sourcePoint"/><mxPoint x="925" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="publish the proposal, 7–14 days (UC37)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="350" as="sourcePoint"/><mxPoint x="519" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="review the statement; optional feedback" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="388" as="sourcePoint"/><mxPoint x="531" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="approve after the window (UC39)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="426" as="sourcePoint"/><mxPoint x="519" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="lock the settlement (trigger)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="464" as="sourcePoint"/><mxPoint x="925" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="payout instruction per investor" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="502" as="sourcePoint"/><mxPoint x="1325" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="payout results" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325" y="540" as="sourcePoint"/><mxPoint x="531" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="PaidOut, Closed; batch Closed" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="531" y="578" as="sourcePoint"/><mxPoint x="925" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="Register v1.4 (planned): revenue lines DeliveredOrder (past the return window), InvoicedSale (low-grade or resold crabs), ForfeitedDeposit and FinalOrder (≥ floor price); the locked Standard Cost of the funded boxes only; a remuneration rate cut by tier when survival (1 − deaths ÷ crabs stocked in the funded boxes) is below the threshold. Develop reads completed orders, forfeited offtake deposits and refunds, with a fixed rate. Money is integer VND; payouts plus remuneration equal the revenue." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="610" width="1230" height="60" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;Legend&lt;/b&gt; — filled arrow: request · open arrow: asynchronous message · dashed: reply · narrow bar: activation of the API or library while it handles the messages · dashed participant or «planned»: not on develop yet. Participants are grouped (one box for the whole API); the detailed diagrams show controllers, services and ports: Figures 4.39–4.42.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="1360" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O25 Sequence – Bulk pre-order" id="O25_Sequence___Bulk_pre_order"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.25 – Sequence Diagram: bulk pre-order, weighed delivery and balance (UC25, UC27, UC29, UC30, UC54, UC33)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="105" y="80" width="40" height="1082" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web app&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="170" height="1082" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;CrabShare API&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#e0f2fe;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="170" height="1082" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#f1f5f9;" vertex="1" parent="1"><mxGeometry x="670" y="80" width="170" height="1082" as="geometry"/></mxCell><mxCell id="c7" value="«external»&lt;br&gt;&lt;b&gt;Payment provider&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#fef3c7;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="170" height="1082" as="geometry"/></mxCell><mxCell id="c8" value="Operator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="1155" y="80" width="40" height="1082" as="geometry"/></mxCell><mxCell id="9" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="539" y="188" width="12" height="326" as="geometry"/></mxCell><mxCell id="10" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="539" y="588" width="12" height="518" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;alt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="46" y="784" width="1210" height="252" as="geometry"/></mxCell><mxCell id="12" value="&lt;font style=&quot;font-size:11px&quot;&gt;[Customer accepts the crabs]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="112" y="784" width="480" height="24" as="geometry"/></mxCell><mxCell id="13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#1e293b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="966" as="sourcePoint"/><mxPoint x="1256" y="966" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="&lt;font style=&quot;font-size:11px&quot;&gt;[refuses delivery or does not pay]&lt;/font&gt;" style="text;html