rent="1" source="c22" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="692"/><mxPoint x="460" y="263.2"/></Array></mxGeometry></mxCell><mxCell id="32" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="362"/><mxPoint x="480" y="422"/></Array></mxGeometry></mxCell><mxCell id="33" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c21" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="642"/><mxPoint x="480" y="422"/></Array></mxGeometry></mxCell><mxCell id="34" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="312"/><mxPoint x="500" y="656"/></Array></mxGeometry></mxCell><mxCell id="35" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c19" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="542"/><mxPoint x="500" y="656"/></Array></mxGeometry></mxCell><mxCell id="36" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c20" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="592"/><mxPoint x="500" y="656"/></Array></mxGeometry></mxCell><mxCell id="37" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c23" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="742"/><mxPoint x="500" y="656"/></Array></mxGeometry></mxCell><mxCell id="38" value="VietQR" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="39" value="payouts" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="40" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="41" value="dispatch by&lt;br&gt;purpose" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="late payment" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c25" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="Calculate()" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="&lt;b&gt;Payments is the hub&lt;/b&gt; — modules ask PaymentRequestService for a VietQR code on the batch account; the provider webhook (PaymentWebhookService) is dispatched back to the owning module through IPaymentPurposeHandler, one handler per purpose (contribution, pre-order deposit, pre-order balance). Refunds, tranche releases (DisbursementService) and payouts leave as payment instructions. Names are the real classes on develop; the retail OrderPaymentHandler and the Offtake module remain in the code but are removed from the v1.4 design; InvoicedSaleService (invoiced sales of low-grade or resold crabs and the final order) and InvoicedSalePaymentHandler (purpose OrderPayment) are planned. Funding also calls Contracts directly (voiding unsigned contracts). Details: Figures 4.71, 4.73–4.74, 4.81, 4.83.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="750" width="1020" height="101" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>