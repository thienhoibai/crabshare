itX=0.8176;exitY=0.1138;entryX=0;entryY=0.6842;verticalAlign=top;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Digital Signature Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Viettel&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1384" y="314" width="230" height="76" as="geometry"/></mxCell><mxCell id="20" value="Signed Contract" style="html=1;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=11;edgeStyle=none;labelBackgroundColor=none;fontFamily=Segoe UI;exitX=0;exitY=0.3158;entryX=0.9742;entryY=0.3414;verticalAlign=bottom;" edge="1" parent="1" source="c19" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="Contract Document" style="html=1;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=11;edgeStyle=none;labelBackgroundColor=none;fontFamily=Segoe UI;exitX=0.9877;exitY=0.3897;entryX=0;entryY=0.6842;verticalAlign=top;" edge="1" parent="1" source="c3" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Payment Service Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;payment intermediary, batch accounts&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1384" y="474" width="230" height="76" as="geometry"/></mxCell><mxCell id="23" value="Transaction &amp;amp; Payout Results" style="html=1;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=11;edgeStyle=none;labelBackgroundColor=none;fontFamily=Segoe UI;exitX=0;exitY=0.3158;entryX=0.9861;entryY=0.6172;verticalAlign=bottom;" edge="1" parent="1" source="c22" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="Batch Account &amp;amp; Payment Requests,&lt;br&gt;Disbursement, Payout &amp;amp; Refund&lt;br&gt;Instructions" style="html=1;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=11;edgeStyle=none;labelBackgroundColor=none;fontFamily=Segoe UI;exitX=0.9718;exitY=0.6655;entryX=0;entryY=0.6842;verticalAlign=top;" edge="1" parent="1" source="c3" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Farm Devices &amp;amp; Cameras (simulated)&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1384" y="634" width="230" height="76" as="geometry"/></mxCell><mxCell id="26" value="Box Photos, Feeding &amp;amp; Box Events &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=11;edgeStyle=none;labelBackgroundColor=none;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=0;exitY=0.3158;entryX=0.8090;entryY=0.8931;verticalAlign=bottom;" edge="1" parent="1" source="c25" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;Legend&lt;/b&gt; — circle: CrabShare System as one process (black box) · rectangle: external entity, human role on the left, external system on the right (sandbox or simulated in the demo) · dashed grey or «planned»: in Register v1.4, not built yet. Upper arrow of a pair = information into the system, lower arrow = information out. Each label groups the information packages of Figure 1.1 under the same Title Case names; the parts of a package that are planned are marked there. Money moves only between payers, the batch account at the payment provider and payees. Farmers, carriers, the committed buyer of the final order and the banks behind the provider exchange nothing with the system directly, so they are not drawn. Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1574" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O2 Use Case" id="O2_Use_Case"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.2 – Use Case Diagram: system overview, 5 subsystems with representative use cases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="CrabShare System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="616" height="1022" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SD1 · Identity &amp;amp; Onboarding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;UC01–UC06 · Figure 2.2&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;fontSize=13;fillColor=#f8fafc;spaci