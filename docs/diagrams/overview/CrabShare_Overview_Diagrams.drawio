r=#ffffff;fontFamily=Segoe UI;exitX=0.15;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="c19" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="38" value="P2 «planned»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=0.7;exitY=1;entryX=0.7;entryY=0;align=left;spacingLeft=6;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="39" value="13" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeColor=#b91c1c;fontColor=#b91c1c;exitX=0.9;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="40" value="14" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeColor=#b91c1c;fontColor=#b91c1c;exitX=0.1;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="41" value="15" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="c21" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="15" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="«import»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c23" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c23" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="&lt;b&gt;Reading the figure&lt;/b&gt; — folder = package; dashed arrow = dependency; number = row of Table 4.5 (2/2), part (b), as on the arrows of Figure 4.5; red = cycle (Payments ⇄ Settlement, 11 and 12) or layer breach (Common → Alerts 13, Infrastructure → Alerts and Evidence 14); Common ⇄ Infrastructure (15) is mutual; dashed grey folder or «planned» = Register v1.4, not in code yet. Features do call each other's services: FundingService, OrderService and PreorderService call PaymentRequestService; SettlementPayoutService calls PayoutSendService. Payment confirmations come back through IPaymentPurposeHandler, so Payments does not depend on its callers. Web and mobile features also import each other (Figures 4.5–4.7). Planned dependencies (grey dashed): P1 Ingestion → Production, P2 Orders → Alerts (final-order reminder). &lt;b&gt;Removed in v1.4, still in code (not drawn)&lt;/b&gt;: the Catalog module (listings, price history, cart, checkout, retail orders) and the Offtake module (commitments, priority window) with their dependencies (Orders ⇄ Catalog, Catalog → Alerts, Offtake → Payments, Orders and Funding, Harvest → Catalog); tags in Harvest; PreorderBalanceJob and PreorderBalanceService in Orders.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="820" width="1260" height="101" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O10 State – Batch" id="O10_State___Batch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.10 – State Machine Diagram: Batch lifecycle (batch.status)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c4" value="PendingApproval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Funding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="InProduction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="190" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Cancelled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="190" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Harvesting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1160" y="500" width="190" height="56" as="geometry"/></mxCell><mxCell id="c10" value="Settlement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="190" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="440" y="500" width="190" height="56" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="162" y="170" width="26" height="26" as="geometry"/></mxCell><mxCell id="13" value="/ create batch" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="submit" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="return for revision" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="410"/><mxPoint x="175" y="410"/></Array></mxGeometry></mxCell><mxCell id="16" value="reject" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="approve / lock cost,&lt;br&gt;price, floor price" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="funding close [min viable capital&lt;br&gt;not reached or pre-order ratio&lt;br&gt;below the minimum ²] / refund&lt;br&gt;contributions and every deposit" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="stocking&lt;br&gt;recorded ¹" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="start harvest" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="run settlement&lt;br&gt;calculation&lt;br&gt;[sales closed] ²" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="all payouts&lt;br&gt;done" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="144" width="26" height="26" as="geometry"/></mxCell><mxCell id="24" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="144" width="26" height="26" as="geometry"/></mxCell><mxCell id="26" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="514" width="26" height="26" as="geometry"/></mxCell><mxCell id="28" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="Creation (UC07): an Approved Operator creates the batch on its boxes, grouped into box rows of the batch by their row code (box rows «planned»), with a Standard Cost. ¹ Stocked is transient: recording stocking moves Funding → Stocked → InProduction in one transaction; it needs capital closed and every contract fully signed, and only the boxes of funded rows are stocked (planned). ² Funding close (job): the batch opens when the confirmed capital reaches the minimum viable capital (as in code) and the pre-order ratio reaches the minimum set by the Administrator (planned); otherwise it is cancelled and contributions and every customer deposit are refunded (deposits planned). If capital closes between the minimum and the target, capital that cannot become boxes is refunded and settlement deducts the locked Standard Cost of the funded boxes only. Price per kg, floor price, survival threshold, remuneration tiers, delivery radius and sales window are approved and locked with the Standard Cost (planned); settlement starts after the sales window closes and the final order. Code today: capital closes at min_viable_capital with no pre-order check; pre-orders are taken only in InProduction. Rules live in the services; the database checks only the value list. Guards and effects: Figure 4.8.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1300" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O11 State – Contribution" id="O11_State___Contribution"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.11 – State Machine Diagram: capital contribution and reservation (contribution.status) + RowAllocation «planned»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="RowAllocation «planned» — one per picked box row" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;fillColor=none;arcSize=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="120" width="490" height="440" as="geometry"/></mxCell><mxCell id="c4" value="Reserved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Confirmed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Refunded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="190" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Held&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1305" y="220" width="140" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Allocated&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="140" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Released&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1460" y="400" width="140" height="50" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="382" y="130" width="26" height="26" as="geometry"/></mxCell><mxCell id="12" value="/ reserve" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="payment matched&lt;br&gt;(webhook)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="30-min hold ends&lt;br&gt;or cancel" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="batch does not&lt;br&gt;open / refund" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="274" width="26" height="26" as="geometry"/></mxCell><mxCell id="17" value="batch&lt;br&gt;closed" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="382" y="600" width="26" height="26" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="802" y="600" width="26" height="26" as="geometry"/></mxCell><mxCell id="21" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1362" y="158" width="26" height="26" as="geometry"/></mxCell><mxCell id="23" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c22" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="«planned» contribution&lt;br&gt;Confirmed" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="«planned» contribution&lt;br&gt;Expired" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="«planned» batch not&lt;br&gt;opened / refund&lt;br&gt;created" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1207" y="506" width="26" height="26" as="geometry"/></mxCell><mxCell id="28" value="«planned» batch Closed" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;align=left;spacingLeft=6;" edge="1" parent="1" source="c9" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1517" y="506" width="26" height="26" as="geometry"/></mxCell><mxCell id="30" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="31" value="Creation (UC10): a reservation is made only by an eKYC-verified investor who has acknowledged the risk disclosure (UC11), within the batch limits. Order in the code (web wizard): read the risk disclosure → amount and reserve → contract → VietQR → done; contract and payment do not block each other. The hold lasts 30 minutes (Funding:ReservationMinutes), capped at the funding deadline, one open hold per investor and batch, checked under a row lock so the cap is never exceeded. A payment that arrives after expiry is booked as a late payment and refunded automatically. Confirmed contributions are snapshotted into capital shares when capital closes. Box rows (planned): a BoxRow belongs to the batch (its boxes grouped by row code); the investor picks free rows, the amount is their capital (boxes × Standard Cost per box) and the minimum contribution is one row. RowAllocation, drawn on the right as in Figure 4.9: each picked row is Held during the reservation, Allocated when the contribution is Confirmed (a confirmed row belongs to exactly one investor, at most one active allocation per row) and Released when the contribution expires or the batch does not open; today a reservation holds only an amount and there is no table.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1560" height="119" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O12 State – Contract" id="O12_State___Contract"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.12 – State Machine Diagram: investment contract (investment_contract.status)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c4" value="OperatorSigned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="FullySigned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Void" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="314" width="26" height="26" as="geometry"/></mxCell><mxCell id="8" value="/ create ¹" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="Operator signs&lt;br&gt;(Viettel)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="Investor signs" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="offline upload (Admin)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="210"/><mxPoint x="1115" y="210"/></Array></mxGeometry></mxCell><mxCell id="12" value="voided ²" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="voided ²" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1102" y="440" width="26" height="26" as="geometry"/></mxCell><mxCell id="15" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="514" width="26" height="26" as="geometry"/></mxCell><mxCell id="17" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="¹ Created from the active template when the investor reaches the contract step, while the hold is valid or after payment (contribution Reserved or Confirmed); signing does not block payment. ² Voided when the hold expires or is cancelled, or when the batch is cancelled; a FullySigned contract is kept as a record. Signing order is fixed: Operator first, then Investor (wrong order → 422). Stocking needs every Confirmed contribution FullySigned. Register v1.4: the loss rule, floor price and remuneration tiers go into the template before funding opens (planned). Details: Figure 4.10.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1100" height="91" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O13 State – DisbursementTranche" id="O13_State___DisbursementTranche"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.13 – State Machine Diagram: milestone disbursement tranche (disbursement_tranche.status)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Requested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Released" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="NeedsExplanation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="520" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Blocked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1240" y="520" width="190" height="56" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="182" y="170" width="26" height="26" as="geometry"/></mxCell><mxCell id="9" value="/ created on batch approval,&lt;br&gt;one per planned tranche" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="request (Operator)&lt;br&gt;[milestone gate passes]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="release (Admin)&lt;br&gt;[gate re-checked]&lt;br&gt;/ disbursement instruction" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="need explanation (Admin)&lt;br&gt;[reason] / deadline +72 h" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.3;exitY=1;entryX=0.3;entryY=0;align=right;spacingRight=6;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="request again (Operator)&lt;br&gt;[gate passes]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.7;exitY=0;entryX=0.7;entryY=1;align=left;spacingLeft=6;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="block (Admin) [reason]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="230"/><mxPoint x="1335" y="230"/></Array></mxGeometry></mxCell><mxCell id="15" value="block (Admin) [reason]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="315" width="26" height="26" as="geometry"/></mxCell><mxCell id="17" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1500" y="535" width="26" height="26" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="Gate for a request: the previous tranche is Released and its planned date is reached; tranche 1 needs capital closed and contracts signed; later tranches need stocking, Accepted or Watch evidence since the last tranche and nothing Flagged; tranche 3 onwards needs the harvest date declared. Release needs Requested: after an explanation the Operator requests again; there is no direct NeedsExplanation → Released. The 72-hour deadline is informational: no job blocks a tranche automatically. Release creates a disbursement payment instruction within the confirmed capital. A Blocked tranche stops the later ones; unblocking has no API. TrancheScheduleJob resolves the planned date from anchors (funding ready, stocked + offset days) without changing the status. Unchanged by Register v1.4. Details: Figure 4.13; sequence Figure 4.39.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1440" height="77" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O14 State – Settlement" id="O14_State___Settlement"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.14 – State Machine Diagram: settlement (settlement.status)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Proposed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Approved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c6" value="PaidOut" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1400" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Disputed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="170" height="56" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="314" width="26" height="26" as="geometry"/></mxCell><mxCell id="10" value="/ run&lt;br&gt;calculation" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c9" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="recalculate" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="c3" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="251" y="260"/><mxPoint x="319" y="260"/></Array></mxGeometry></mxCell><mxCell id="12" value="publish&lt;br&gt;(7–14 days)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="investor&lt;br&gt;feedback" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="420"/></Array></mxGeometry></mxCell><mxCell id="14" value="Admin&lt;br&gt;answers" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="420"/></Array></mxGeometry></mxCell><mxCell id="15" value="approve after&lt;br&gt;window ends" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="all payouts&lt;br&gt;succeeded" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="/ batch&lt;br&gt;Closed" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1472" y="440" width="26" height="26" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="Creation (UC38 Run Settlement Calculation): the Administrator runs the calculation once the sales window has closed; the settlement engine computes the Pool and the lines. Revenue (Register v1.4) = revenue lines DeliveredOrder (past the return window), InvoicedSale (low-grade or resold crabs), ForfeitedDeposit (counted once) and FinalOrder (≥ floor price); the code counts completed orders + forfeited offtake deposits − refunds, so the new revenue types are planned. Revenue Pool = revenue − locked Standard Cost of the funded boxes; savings, including an unused mortality reserve, stay with the Operator and never enter the Pool. Survival rate = 1 − deaths during farming ÷ crabs first stocked in the funded boxes (restocked crabs that die count; deaths in transit only lower revenue). Operator remuneration = floor(Pool × rate) only when Pool &gt; 0, cut by tier when survival falls below the threshold (tiers planned; the code uses a fixed %). The rest is split pro rata to capital with largest-remainder rounding; a negative Pool is shared pro rata, each loss capped at the capital. Approval locks the statement (database trigger) and creates the payout instructions; closing also closes the batch. Details: Figure 4.14.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="1300" height="119" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O15 State – BulkPreOrder" id="O15_State___BulkPreOrder"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.15 – State Machine Diagram: bulk pre-order (sales_order.status, order type BulkPreOrder)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="PendingPayment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c4" value="DepositPaid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Confirmed&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="610" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Packed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="890" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Shipping" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Delivered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1450" y="300" width="170" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Cancelled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="170" height="56" as="geometry"/></mxCell><mxCell id="c10" value