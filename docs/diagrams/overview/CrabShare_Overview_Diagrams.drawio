th="190" height="48" as="geometry"/></mxCell><mxCell id="c16" value="Find a farm on the map; pre-order by crab count" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1110" y="504" width="190" height="48" as="geometry"/></mxCell><mxCell id="c17" value="Sign the contract and pay by VietQR (either order)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="190" height="48" as="geometry"/></mxCell><mxCell id="c18" value="Pay the deposit by VietQR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1110" y="560" width="190" height="48" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=0;html=1;fillColor=#1e293b;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="685" y="637" width="580" height="6" as="geometry"/></mxCell><mxCell id="c20" value="min viable capital&lt;br&gt;and pre-order&lt;br&gt;ratio ≥ min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="645" y="661" width="200" height="70" as="geometry"/></mxCell><mxCell id="c21" value="Stock the funded boxes; daily logs; live evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="190" y="753.2" width="190" height="48" as="geometry"/></mxCell><mxCell id="c22" value="Cancel; refund contributions and every deposit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="650" y="753.2" width="190" height="48" as="geometry"/></mxCell><mxCell id="c