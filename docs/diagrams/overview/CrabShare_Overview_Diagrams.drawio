dge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="39" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="40" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="41" value="throws" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="" style="endArrow=block;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=none;endSize=12;fontFamily=Segoe UI;" edge="1" parent="1" source="c30" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="&lt;b&gt;Vertical slice&lt;/b&gt; — each module in Features/ has its own Controller, Service and Dtos; services use AppDbContext directly (no repository layer). Program.cs only wires things together; services are registered in FeatureRegistry. Concrete examples: FundingController → FundingService, PreordersController → PreorderService. The v1.4 parts still to come (price suggestion, ingestion, InvoicedSale and the final order, box rows with RowAllocation, pre-order quota and holds, remuneration tiers) follow the same pattern; Catalog and Offtake stay in the code but are removed from the v1.4 design. ICrabDetector is the port of the planned detection module (no-op on develop). Detailed class diagrams per module: Figures 4.71–4.87.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1440" height="73" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O28 Class – Collaboration" id="O28_Class___Collaboration"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.28 – Class Diagram: how modules collaborate through Payments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Infrastructure (ports and adapters)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="560" height="106" as="geometry"/></mxCell><mxCell id="c4" value="«interface»&lt;br&gt;&lt;b&gt;IPaymentGateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;fillColor=#fef3c7;" vertex="1" parent="1"><mxGeometry x="540" y="108" width="230" height="52" as="geometry"/></mxCell><mxCell id="c5" value="«adapter»&lt;br&gt;&lt;b&gt;FakePaymentGateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="830" y="108" width="230" height="52" as="geometry"/></mxCell><mxCell 