tFamily=Segoe UI;" edge="1" parent="1" source="c15" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="issues" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="is paid by" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="is paid by" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c20" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="is paid by" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="600"/><mxPoint x="470" y="600"/></Array></mxGeometry></mxCell><mxCell id="47" value="counts revenue of" style="edgeStyle=none;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="630"/><mxPoint x="850" y="630"/></Array></mxGeometry></mxCell><mxCell id="48" value="places" style="edgeStyle=none;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c21" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="49" value="is invoiced by" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="50" value="carries" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="51" value="is delivered in" style="edgeStyle=none;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="52" value="&lt;b&gt;Simplified view&lt;/b&gt; — crow's foot notation, attributes omitted; dashed grey or «planned» = in Register v1.4, no table on develop. A BoxRow belongs to the Batch: it groups the boxes allocated to the Batch by their row code, and once confirmed it belongs to exactly one investor (one active RowAllocation: Held → Allocated → Released); a contribution's amount is the capital of its rows. SalesOrder.orderType is BulkPreOrder, InvoicedSale (saleReason LowGrade or ForfeitResale) or FinalOrder; every delivered order carries one Invoice; an invoiced order may go to an outside buyer, so Customer is optional. Payment groups PaymentRequest (VietQR money in: capital, deposit, balance, invoiced orders) and PaymentInstruction (refunds, tranche releases, payouts). StandardCost = locked cost version with line items and tranche plan. ProductionLog belongs to the Batch. Supporting v1.4 entities in the logical overview (Figure O.6): BoxAllocation, RowAllocation, BoxEvent, PreOrderQuota, PreOrderHold, RevenueLine, PriceObservation, PriceSuggestion, IngestionMessage. Removed in v1.4 (still in code, not drawn): ProductListing, Cart, OfftakeCommitment, CrabTag, water-quality thresholds. Full model: Figure 3.3 (areas 3.3.1–3.3.6).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1560" height="101" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O4 Screen Flow" id="O4_Screen_Flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.4 – Screen Flow: main navigation per role, web and mobile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Public&lt;/b&gt; — no login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="1240" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Landing&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;fontFamily=Segoe UI;fontSize=11;" vertex="1" 