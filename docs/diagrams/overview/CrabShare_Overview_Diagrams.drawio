 as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;[D2]&lt;/b&gt; &lt;b&gt;File storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;/home/data/storage&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1f5f9;strokeColor=#1e293b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="220" height="84" as="geometry"/></mxCell><mxCell id="c29" value="«external system» &lt;b&gt;[X4]&lt;/b&gt; &lt;b&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;evidence images&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="994" y="726" width="200" height="70" as="geometry"/></mxCell><mxCell id="c30" value="«external system» &lt;b&gt;[X1]&lt;/b&gt; &lt;b&gt;Payment intermediary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;VietQR · batch accounts · payouts · refunds (simulated)&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1380" y="430" width="240" height="76" as="geometry"/></mxCell><mxCell id="c31" value="«external system» &lt;b&gt;[X2]&lt;/b&gt; &lt;b&gt;Viettel digital signing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;simulated&lt;/font&gt;" style="shape=component;jettyWidth=10;jettyHeight=5;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1380" y="522" width="240" height="56" as="geometry"/></mxCell><mxCell id="c32" value="«external system» &lt;b&gt;[X3]&lt;/b&gt; &lt;b&gt;eKYC provider&lt;/b&gt;&lt;br&gt;&lt;font