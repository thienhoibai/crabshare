l=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c144"><mxGeometry x="0" y="24" width="220" height="18" as="geometry"/></mxCell><mxCell id="146" value="FK ContributionId | OrderId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c144"><mxGeometry x="0" y="42" width="220" height="18" as="geometry"/></mxCell><mxCell id="c147" value="&lt;b&gt;PaymentInstruction&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#eef2ff;strokeColor=#3730a3;swimlaneFillColor=#ffffff;fontSize=12;fontFamily=Segoe UI;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="746" width="220" height="64" as="geometry"/></mxCell><mxCell id="148" value="Type · AmountVnd · Status" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c147"><mxGeometry x="0" y="24" width="220" height="18" as="geometry"/></mxCell><mxCell id="149" value="FK TrancheId | LineId" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="c147"><mxGeometry x="0" y="42" width="220" height="18" as="geometry"/></mxCell><mxCell id="150" value="" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c133" target="c137"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="151" value="" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;" edge="1" parent="1" source="c133" target="c141"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="152" value="" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#334155;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c137" target="c147"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="153" value="&lt;b&gt;Reading the figure&lt;/b&gt; — the Register v1.4 logical model, independent of SQL Server: one card per entity with its key and main business attributes in PascalCase as in Figure 4.2 (areas 4.2.1–4.2.6); crow's foot lines inside an area, cross-area links written as FK → parent. Dashed grey card or * = planned (no table or column in V001–V017 yet); / = derived. Box rows: a BoxRow belongs to the Batch (unique BatchId + RowCode) and groups the boxes allocated to it; at most one Held or Allocated RowAllocation per BoxRow, so a confirmed row has one investor, and Contribution.AmountVnd is the capital of its rows. Many-to-many links are resolved by RowAllocation (Contribution ⟷ BoxRow), BoxAllocation (Batch ⟷ Box) and SettlementLine (Settlement ⟷ Investor). SalesOrder.OrderType ∈ BulkPreOrder, InvoicedSale (SaleReason LowGrade or ForfeitResale), FinalOrder; every delivered order has one Invoice; BalanceVnd = WeighedKg × price per kg − DepositAmount; RevenueLine.LineType ∈ DeliveredOrder, InvoicedSale, ForfeitedDeposit, FinalOrder; PreOrderQuota and PreOrderHold (15 minutes) keep a batch from being oversold. The order QR code traces an order back through Crab.OrderId* (the crabs delivered in it) and HarvestRecord.CrabId to its box and Batch. Production logs, box events and evidence may come from an IngestionMessage*. Money is integer VND. Removed in v1.4 and kept only in the physical model (Figure O.7), not drawn: ProductListing, cart lines, OfftakeCommitment, CrabTag, water-quality thresholds and readings. Full model: Figure 4.2 and Table 4.2.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="936" width="1590" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O7 Physical Data Areas" id="O7_Physical_Data_Areas"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.7 – Physical Data Model: 6 data areas of migrations V001–V017 and the foreign keys between them&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;A1 · Identity, accounts &amp; farm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;11 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;app_user · investor · customer · operator · physical_slot (row_code) · payout_account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbeafe;strokeColor=#1d4ed8;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1510" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;A2 · Batch, Standard Cost, funding &amp; contracts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;16 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;batch · standard_cost_version · contribution · investment_contract · disbursement_tranche · batch_account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#b45309;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="230" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;A3 · Production, evidence &amp; alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;12 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;production_log · slot_event · crab_item · evidence · capture_request · alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="230" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;A4 · Harvest, tags, catalogue &amp; traceability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;9 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;harvest · harvest_record · product_grade&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="230" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;A5 · Orders, complaints &amp; ratings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;5 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;sales_order · complaint · product_rating&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="230" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;A6 · Payments, settlement &amp; audit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;7 tables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;payment_request · provider_transaction · payment_instruction · settlement · settlement_line · audit_log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=13;verticalAlign=top;spacingTop=8;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="230" height="170" as="geometry"/></mxCell><mxCell id="9" value="8 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.0762;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="12 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2881;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="7 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="2 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7119;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="5 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9238;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="9 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="8 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="3 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="2 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="4 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.750;exitY=1;entryX=0.500;entryY=1;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.5" y="610"/><mxPoint x="815" y="610"/></Array></mxGeometry></mxCell><mxCell id="19" value="1 FK" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1;entryX=0.333;entryY=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="652"/><mxPoint x="1096.6666666666667" y="652"/></Array></mxGeometry></mxCell><mxCell id="20" value="3 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1;entryX=0.667;entryY=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="694"/><mxPoint x="1173.3333333333333" y="694"/></Array></mxGeometry></mxCell><mxCell id="21" value="10 FKs" style="endArrow=none;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.250;exitY=1;entryX=0.500;entryY=1;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="117.5" y="736"/><mxPoint x="1455" y="736"/></Array></mxGeometry></mxCell><mxCell id="22" value="&lt;b&gt;Reading the figure&lt;/b&gt; — the database as built: 60 tables of migrations V001–V017 grouped in 6 areas, with the main tables of each area; a line carries the number of foreign keys between two areas (74 of 131 FKs cross an area boundary). Batch (A2) is the hub every other area refers to. Tables of features removed in Register v1.4 (catalogue listing, retail cart, offtake window, per-crab tag, water-quality thresholds) are counted above and stay in the database script until the code changes, but are not listed: offtake_commitment, batch_offtake_price (A2); production_threshold_version (A3); crab_tag, tag_scan, product_listing, price_history, price_check (A4); order_line, stock_reservation (A5). v1.4 entities with no table yet (BoxRow, RowAllocation, RemunerationTier, Invoice, OrderQrCode, RevenueLine, PriceObservation, PriceSuggestion, IngestionMessage) appear only in the logical overview, Figure O.6. Full detail: Figure 4.3 and Table 4.3 (physical), Figure 4.2 and Table 4.2 (logical)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="798" width="1520" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O8 Deployment" id="O8_Deployment"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.8 – Deployment Diagram: local, preview (develop) and production environments with CI/CD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;[N1]&lt;/b&gt; «device» &lt;b&gt;User PC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;browser runs the web SPA&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;[N14]&lt;/b&gt; &lt;b&gt;Map tile service&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;fillColor=#fef3c7;strokeColor=#b45309;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="260" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;[N2]&lt;/b&gt; «device» &lt;b&gt;Android phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;CrabShare APK · camera · GPS&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;[N3]&lt;/b&gt; «device» &lt;b&gt;demo machine&lt;/b&gt; &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Device &amp;amp; Camera Simulator&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="260" height="88" as="geometry"/></mxCell><mxCell id="c7" value="Preview / staging (develop) — web only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="420" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;[N8]&lt;/b&gt; «cloud» &lt;b&gt;Vercel Preview&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;develop alias · one URL per pull request&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="132" width="380" height="72" as="geometry"/></mxCell><mxCell id="c9" value="Production — Azure East Asia, crabshare-rg" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="420" height="380" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;[N4]&lt;/b&gt; «cloud» &lt;b&gt;Vercel Production&lt;/b&gt; — crabshare.vercel.app&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;built from main&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="282" width="380" height="72" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;[N5]&lt;/b&gt; «cloud» &lt;b&gt;App Service crabshare-api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Linux B1 · .NET 10 · HTTPS only · deployed from develop&lt;br&gt;API + jobs · /home/data (PDFs, keys) · Fake providers&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="378" width="380" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;[N6]&lt;/b&gt; «cloud» &lt;b&gt;Azure SQL crabshare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Basic · V001–V017&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="528" width="380" height="72" as="geometry"/></mxCell><mxCell id="c13" value="External services" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="420" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;[N7]&lt;/b&gt; «cloud» &lt;b&gt;Cloudinary&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="540" y="682" width="150" height="88" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;[N13]&lt;/b&gt; &lt;b&gt;Sandbox providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;VietQR · Viettel · eKYC, simulated inside N5&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="710" y="682" width="210" height="88" as="geometry"/></mxCell><mxCell id="c16" value="CI/CD — GitHub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="420" height="440" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;[N9]&lt;/b&gt; «cloud» &lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;main · develop · feature branches → pull request&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140" y="132" width="380" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;[N10]&lt;/b&gt; «executionEnvironment» &lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;ci.yml · deploy-backend.yml · deploy-web.yml (Vercel CLI) · release-mobile.yml · acceptance-tools.yml&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="380" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;[N11]&lt;/b&gt; «cloud» &lt;b&gt;GitHub Releases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;draft demo APK&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="380" height="72" as="geometry"/></mxCell><mxCell id="c20" value="Local development — each member's PC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1500" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;[N12]&lt;/b&gt; «device» &lt;b&gt;Developer PC&lt;/b&gt; — &lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Vite :5173 · dotnet run :5233 (Development: demo seed, Fake providers) · LocalDB · Flutter emulator · optional Docker SQL · User Secrets&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#f8fafc;strokeColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacingLeft=18;spacingTop=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="852" width="1460" height="60" as="geometry"/></mxCell><mxCell id="22" value="HTTPS GET (preview)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="HTTPS GET static · CDN" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.55;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="HTTPS · JSON · Bearer JWT (CORS)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.85;entryX=0;entryY=0.2;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="HTTPS tiles «planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;align=left;spacingLeft=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="HTTPS · JSON · Bearer JWT" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="HTTPS POST /api/ingest/v1&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="TDS 1433 · TLS · Managed Identity" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="HTTPS Upload API · signed URL" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;align=right;spacingRight=6;exitX=0;exitY=0.92;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c14"><mxGeometry x="0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="488.4"/><mxPoint x="505" y="726"/></Array></mxGeometry></mxCell><mxCell id="30" value="push / pull_request triggers" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="31" value="Vercel CLI preview · alias" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.12;entryX=1;entryY=0.5;" edge="1" parent="1" source="c18" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" value="Vercel CLI --prod" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.38;entryX=1;entryY=0.5;" edge="1" parent="1" source="c18" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="33" value="OIDC · zip deploy · smoke test" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.65;entryX=1;entryY=0.3;" edge="1" parent="1" source="c18" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="34" value="DbMigrator · TDS/TLS" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0;exitY=0.9;entryX=1;entryY=0.5;" edge="1" parent="1" source="c18" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="35" value="gh release create --draft" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="36" value="git push · pull request" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=none;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c21" target="c17"><mxGeometry x="-0.44" relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="882"/><mxPoint x="1560" y="167"/></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Local / development&lt;/b&gt; — N12 on each PC: Vite dev server, the API in Development (demo seed, Fake providers, /scalar, /api/dev), LocalDB (DbMigrator --reset allowed only there), Flutter emulator. Deployed manually.&lt;br&gt;&lt;b&gt;Preview / staging (develop)&lt;/b&gt; — N8 only: deploy-web.yml on push to develop (fixed alias crabshare-develop-nguyn1hien.vercel.app) and on pull requests touching web/ (link in a PR comment). No separate staging API or database: previews call the production API N5.&lt;br&gt;&lt;b&gt;Production&lt;/b&gt; — N4 web from main (deploy-web.yml --prod); N5 API and N6 database from develop (deploy-backend.yml). Vercel's own Git integration is off (web/vercel.json).&lt;br&gt;&lt;b&gt;N1 User PC&lt;/b&gt; — downloads the SPA from Vercel, calls the API directly (CORS: production site and the preview pattern); planned map tiles from N14.&lt;br&gt;&lt;b&gt;N2 Android phone&lt;/b&gt; — release APK from N11 with API_URL and WEB_URL; camera and GPS for live evidence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="780" height="132" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;N3 demo machine&lt;/b&gt; — planned: runs the Device &amp;amp; Camera Simulator that posts to the Ingestion API of N5.&lt;br&gt;&lt;b&gt;N5 App Service&lt;/b&gt; — single API instance for production and previews; Always On for jobs; persistent /home/data; managed identity for SQL; payment, signing and eKYC are in-process Fake adapters (N13).&lt;br&gt;&lt;b&gt;N6 Azure SQL&lt;/b&gt; — Basic tier; the API reads and writes as [crabshare-api]; migrations only move forward, never --reset.&lt;br&gt;&lt;b&gt;N7, N13&lt;/b&gt; — Cloudinary stores evidence images (signed URLs); sandbox providers have no production accounts and are simulated inside N5.&lt;br&gt;&lt;b&gt;N9–N11 GitHub&lt;/b&gt; — PRs into develop must pass ci.yml; deploy-backend.yml logs in by OIDC, stops the app, runs DbMigrator, deploys, smoke-tests; release-mobile.yml makes a draft prerelease with the APK." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="966" width="790" height="119" as="geometry"/></mxCell><mxCell id="39" value="&lt;b&gt;Environments and nodes (codes as in Figure 4.4 and Table 4.4)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1580" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O9 Package" id="O9_Package"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.9 – Package Diagram: sub-systems, v1.4 feature groups and the real dependencies between them&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="«subsystem» &lt;b&gt;Web app&lt;/b&gt; — web/src" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="300" as="geometry"/></mxCell><mxCell id="c4" value="app&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;router, role guards&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="120" height="70" as="geometry"/></mxCell><mxCell id="c5" value="shared&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;api client, ui kit&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="120" height="70" as="geometry"/></mxCell><mxCell id="c6" value="features&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;investor · operator · admin · orders · trace · accounts · farm map «planned»&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="260" height="120" as="geometry"/></mxCell><mxCell id="c7" value="«subsystem» &lt;b&gt;Mobile app&lt;/b&gt; — mobile/lib" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="250" as="geometry"/></mxCell><mxCell id="c8" value="app · core · shared&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;router, API client, widgets&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="260" height="64" as="geometry"/></mxCell><mxCell id="c9" value="features&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;investor · operator · trace · delivery «planned» (repository + mock / API)&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="260" height