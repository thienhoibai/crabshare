 parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="Fail" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="Fail" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="Pass" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="490"/><mxPoint x="820" y="158"/></Array></mxGeometry></mxCell><mxCell id="18" value="Operator explains" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.3;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="617" y="558"/><mxPoint x="693" y="558"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="642" y="40" width="26" height="26" as="geometry"/></mxCell><mxCell id="20" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c4" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1250" y="395" width="26" height="26" as="geometry"/></mxCell><mxCell id="22" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="Creation (UC45): a live photo taken in the app (server time, place, box number), or sent by the simulated farm devices and cameras through the common data channel (planned). Risk score from an exact or similar reused photo (perceptual hash), a stale capture time and the crab detection module (planned; it only says whether a crab is present and never rejects a photo on its own). Watch and Flagged go to a person, the Platform Administrator with the Evidence Reviewer permission, never on a batch they invested in. Accepted evidence feeds the box timeline and the tranche gate; Flagged evidence blocks tranche release. Details: Figure 4.28.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1100" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O17 Activity – End to end" id="O17_Activity___End_to_end"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.17 – Activity Diagram: one batch from proposal to close (WF-01 … WF-05)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="170" y="66" width="230" height="1365.2" as="geometry"/></mxCell><mxCell id="c4" value="Platform Administrator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="66" width="230" height="1365.2" as="geometry"/></mxCell><mxCell id="c5" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="630" y="66" width="230" height="1365.2" as="geometry"/></mxCell><mxCell id="c6" value="Investor" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="860" y="66" width="230" height="1365.2" as="geometry"/></mxCell><mxCell id="c7" value="Customer" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1090" y="66" width="230" height="1365.2" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillCo