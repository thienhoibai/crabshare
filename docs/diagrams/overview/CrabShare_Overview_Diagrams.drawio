c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="after(15 min) or cancel&lt;br&gt;/ hold released" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="«planned» &lt;br&gt;batch opens" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="«planned» cancel [batch still&lt;br&gt;Funding] / deposit kept" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c4" target="c9"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell><mxCell id="20" value="«planned» batch Cancelled&lt;br&gt;/ deposit refunded" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="«planned» batch Cancelled&lt;br&gt;[deposit paid]&lt;br&gt;/ refunded" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="«planned» batch opens [deposit paid] / deposit forfeited" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=1;exitY=0.85;entryX=0.25;entryY=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="587.6"/><mxPoint x="250" y="632"/><mxPoint x="932.5" y="632"/></Array></mxGeometry></mxCell><mxCell id="c23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="122" y="680" width="26" height="26" as="geometry"/></mxCell><mxCell id="24" value="[no deposit paid] «planned»" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;fontColor=#64748b;align=left;spacingLeft=6;" edge="1" parent="1" source="c9" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="«planned» prepare&lt;br&gt;delivery note&lt;br&gt;/ order QR" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="«planned» cancel&lt;br&gt;[batch opened]&lt;br&gt;/ deposit forfeited" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="ship [ETA&lt;br&gt;within 7 days]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="«planned» record weighedKg / balance QR" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="c7" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1221" y="260"/><mxPoint x="1289" y="260"/></Array></mxGeometry></mxCell><mxCell id="29" value="deliver or&lt;br&gt;receive" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" value="«planned» refuse delivery&lt;br&gt;or no balance&lt;br&gt;/ deposit forfeited" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="31" value="after(return window)&lt;br&gt;[no active complaint]" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" value="return in window or full&lt;br&gt;complaint refund / refund" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="555" width="26" height="26" as="geometry"/></mxCell><mxCell id="34" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=1;exitY=0.5;" edge="1" parent="1" source="c10" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="962" y="680" width="26" height="26" as="geometry"/></mxCell><mxCell id="36" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1242" y="680" width="26" height="26" as="geometry"/></mxCell><mxCell id="38" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1522" y="680" width="26" height="26" as="geometry"/></mxCell><mxCell id="40" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=11;edgeStyle=none;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c13" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="41" value="Same state names as Figure 4.17 (sales_order.status, order type BulkPreOrder); there is no CancelRequested state. Creation (UC27): a Customer, or an Investor who is not the batch's Operator or one of its members, places the order while enough crabs are left on the batch capacity, so the batch is never oversold (PendingPayment holds the crabs, PreOrderHold planned); Register v1.4 adds (planned): only while the batch is funding, by crab count (or kg) from the minimum quantity, with an address within the farm's delivery radius. Deposit rules (UC55, UC54, Figure 4.58): (a) a Customer who cancels after paying while the batch is Funding goes to Cancelled and the deposit is kept; it is forfeited when the batch opens, and a cancel after the batch opened forfeits it at once; (b) if the batch does not open, every paid deposit is refunded, cancelled orders included; (c) refusing the delivery or not paying the balance forfeits the deposit and the crabs are resold through an InvoicedSale (saleReason ForfeitResale, Figure 4.18); (d) cancelling before the deposit is paid costs nothing. A forfeited deposit counts once as batch revenue (ForfeitedDeposit). The order QR code is issued when the Operator prepares the delivery note. Balance = weighedKg × price per kg − deposit; weighedKg counts the live crabs the Customer accepts, transitLossKg is only recorded, and a negative balance is refunded. InvoicedSale and FinalOrder orders go PendingPayment → Completed (Figure 4.18). A complaint is a separate record (Figure 4.19); an active complaint blocks completion and returns. Removed in v1.4 (still in code, not drawn): order type PreOrder on a listing while the batch is InProduction, the Paid value (DepositPaid → Paid → Packed, balance asked for when harvesting starts) and tag-scan packing.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead.&lt;br&gt;&lt;i&gt;Legend&lt;/i&gt; — rounded box: state (grey fill: final-like state) · ● initial · ◉ final · label: trigger [guard] / effect · dashed grey with «planned»: Register v1.4, not in code yet. An initial transition carries only its effect; the creation conditions are written above." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="730" width="1570" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O16 State – Evidence" id="O16_State___Evidence"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.16 – State Machine Diagram: production evidence review (evidence.review_status)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="risk score" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="250" y="288" width="130" height="72" as="geometry"/></mxCell><mxCell id="c4" value="Accepted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Watch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="296" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Flagged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="462" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Rejected" style=