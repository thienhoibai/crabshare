"832"/></Array></mxGeometry></mxCell><mxCell id="45" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;WF-01 · owner Viên&lt;/b&gt; — UC44, UC07, UC49, UC08 (UC04/UC05 before: operator approved).&lt;br&gt;Precondition: operator Approved, boxes registered.&lt;br&gt;Exception branches: dossier incomplete; Admin returns the batch for revision; Admin rejects.&lt;br&gt;States: batch Draft → PendingApproval → Draft / Rejected / Funding; Standard Cost version Draft → Submitted → Locked.&lt;br&gt;Overview of all five: Figure O.17 · detailed: Figure 4.31 (2 parts).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="66" width="640" height="109" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Register v1.4 vs code&lt;/b&gt; — planned: box rows of the batch, formed from the boxes' row codes, one investor per row, each row's capital at least the platform minimum contribution (today only a row code on each box); the price suggestion module, price per kg, floor price, survival threshold and remuneration tiers, delivery radius, minimum pre-order ratio and sales window. Code today asks for a capital range, an offtake price per grade and a fixed remuneration %, and locks the Standard Cost on approval." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="191" width="640" height="95" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Legend&lt;/b&gt; — green: human action · blue: system action · yellow: external system · diamond: decision with guards, or merge · bar: fork / join · orange box: object with state · hourglass (collate) shape: time event · ◉ activity final · ⊗ flow final · dashed grey with «planned»: Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="302" width="640" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O19 Activity – WF-02" id="O19_Activity___WF_02"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.19 – Activity Diagram: WF-02 Pick box rows, pay, sign and close funding (Investor, Operator, Payment Service Provider, Platform Administrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Investor" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="240" height="1296.1" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="66" width="240" height="1296.1" as="geometry"/></mxCell><mxCell id="c5" value="Payment Service Provider" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="66" width="240" height="1296.1" as="geometry"/></mxCell><mxCell id="c6" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="760" y="66" width="240" height="1296.1" as="geometry"/></mxCell><mxCell id="c7" value="Platform Administrator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1000" y="66" width="200" height="1296.1" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="147" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c9" value="Complete eKYC (only the result is kept)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="200" height="48" as="geometry"/></mxCell><mxCell id="c10" value="Explore the batch: Batch-level figures, locked cost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="200" height="48" as="geometry"/></mxCell><mxCell id="c11" value="Read and acknowledge the risk disclosure" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="200" height="48" as="geometry"/></mxCell><mxCell id="c12" value="Pick free box rows &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;; reserve their capital" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="344" width="220" height="48" as="geometry"/></mxCell><mxCell id="c13" value="Check limits; hold the rows 30 min (≤ funding deadline)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="402" width="220" height="48" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=0;html=1;fillColor=#1e293b;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="100" y="481" width="840" height="6" as="geometry"/></mxCell><mxCell id="c15" value="Pay by VietQR within the hold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="518" width="200" height="48" as="geometry"/></mxCell><mxCell id="c16" value="Draft the contract from the active template" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="518" width="200" height="48" as="geometry"/></mxCell><mxCell id="c17" value="Sign first (Operator owner, Viettel)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="780" y="576" width="200" height="48" as="geometry"/></mxCell><mxCell id="c18" value="Credit the batch account; send the notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="634" width="200" height="48" as="geometry"/></mxCell><mxCell id="c19" value="Match the payment once; confirm the contribution" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="692" width="200" height="48" as="geometry"/></mxCell><mxCell id="c20" value="Sign second (Investor)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="200" height="48" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=0;html=1;fillColor=#1e293b;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="100" y="829" width="360" height="6" as="geometry"/></mxCell><mxCell id="c22" value="deadline or cap reached" style="shape=collate;whiteSpace=nowrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="387" y="873" width="26" height="34" as="geometry"/></mxCell><mxCell id="c23" value="min viable capital&lt;br&gt;and pre-order&lt;br&gt;ratio ≥ min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="913" width="200" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Close capital; snapshot shares (funded boxes only &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="1004.0999999999999" width="200" height="56" as="geometry"/></mxCell><mxCell id="c25" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="387" y="1077.1" width="26" height="26" as="geometry"/></mxCell><mxCell id="c26" value="Cancel the batch; void contracts; create refunds for contributions and every deposit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="1120.1" width="200" height="56" as="geometry"/></mxCell><mxCell id="c27" value="Send the refund instructions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1010" y="1182.1" width="180" height="48" as="geometry"/></mxCell><mxCell id="c28" value="Execute the refunds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="1240.1" width="200" height="48" as="geometry"/></mxCell><mxCell id="c29" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="627" y="1309.1" width="26" height="26" as="geometry"/></mxCell><mxCell id="30" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="31" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="33" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="34" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="368"/></Array></mxGeometry></mxCell><mxCell id="35" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.3571;entryY=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="36" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.0714;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="37" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.3571;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="38" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="542"/></Array></mxGeometry></mxCell><mxCell id="39" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="658"/></Array></mxGeometry></mxCell><mxCell id="40" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="716"/></Array></mxGeometry></mxCell><mxCell id="41" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="774"/></Array></mxGeometry></mxCell><mxCell id="42" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.1667;entryY=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.8333;entryY=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.8333;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="[yes]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="47" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="48" value="[no]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c23" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="948"/><mxPoint x="640" y="1148.1"/></Array></mxGeometry></mxCell><mxCell id="49" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="1206.1"/></Array></mxGeometry></mxCell><mxCell id="50" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1264.1"/></Array></mxGeometry></mxCell><mxCell id="51" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;WF-02 · owner Thiện&lt;/b&gt; — UC02, UC09, UC10, UC11, UC14, UC12; funding close.&lt;br&gt;Order taken from the code: risk disclosure → amount and reservation → contract → VietQR → done (web wizard steps). The contract may be drafted while the hold is valid; the Operator signs first, then the Investor; signing does not block payment, so the two run in parallel and both must finish before stocking.&lt;br&gt;Exception branches: minimum viable capital not reached or pre-order ratio below the minimum → batch cancelled, contracts voided and refunds created for contributions and every customer deposit; the Platform Administrator sends the refund instructions and the payment provider executes them; hold expiry → reservation Expired, rows Released, unsigned contract Void.&lt;br&gt;States: contribution Reserved → Confirmed / Expired / Refunded; row allocation Held → Allocated / Released «planned»; contract Draft → OperatorSigned → FullySigned / Void; payment request Pending → Paid.&lt;br&gt;Overview of all five: Figure O.17 · detailed: Figure 4.32 (3 parts).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="66" width="390" height="274" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Register v1.4 vs code&lt;/b&gt; — the register lists &quot;reserve, pay by VietQR and sign the contract&quot;; the code's wizard puts the contract step before the payment step but does not enforce either order. The batch opens when the minimum viable capital is reached (as in code) and the pre-order ratio reaches the minimum set by the Administrator; between the minimum and the target only the boxes of funded rows are stocked and capital that cannot become boxes is refunded. Planned: picking box rows (one investor per row, the amount is their capital), the pre-order ratio and refunds of customer deposits. Code today closes capital at min_viable_capital with no pre-order check and refunds only investors." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="356" width="390" height="164" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Legend&lt;/b&gt; — green: human action · blue: system action · yellow: external system · diamond: decision with guards, or merge · bar: fork / join · orange box: object with state · hourglass (collate) shape: time event · ◉ activity final · ⊗ flow final · dashed grey with «planned»: Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="536" width="390" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O20 Activity – WF-03" id="O20_Activity___WF_03"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.20 – Activity Diagram: WF-03 Production data, alerts and evidence review (Operator, farm devices, Platform Administrator, Investor)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Farm Devices &amp;amp; Cameras (simulated) &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="220" height="1290.3" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="260" y="66" width="220" height="1290.3" as="geometry"/></mxCell><mxCell id="c5" value="Platform Administrator&lt;br&gt;(Evidence Reviewer)" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="66" width="220" height="1290.3" as="geometry"/></mxCell><mxCell id="c6" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="700" y="66" width="220" height="1290.3" as="geometry"/></mxCell><mxCell id="c7" value="Investor" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="920" y="66" width="220" height="1290.3" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="797" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c9" value="Stock crabs in the funded box rows" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="180" height="48" as="geometry"/></mxCell><mxCell id="c10" value="Batch InProduction; box timelines open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="270" y="228" width="200" height="48" as="geometry"/></mxCell><mxCell id="c11" value="data source?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="282" width="160" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Post box photos, feeding records, box events and logs through the common data channel &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#fef3c7;strokeColor=#b45309;fontSize=12;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="50" y="334" width="200" height="68" as="geometry"/></mxCell><mxCell id="c13" value="Record daily logs and box events in the app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="344" width="180" height="48" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="355" y="411" width="30" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Record the data per box; check mortality against the policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="460" width="180" height="48" as="geometry"/></mxCell><mxCell id="c16" value="mortality over&lt;br&gt;the limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="514" width="160" height="56" as="geometry"/></mxCell><mxCell id="c17" value="Raise an alert with a deadline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="602.1" width="180" height="48" as="geometry"/></mxCell><mxCell id="c18" value="Acknowledge the alert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="660.1" width="180" height="48" as="geometry"/></mxCell><mxCell id="c19" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="355" y="727.1" width="30" height="30" as="geometry"/></mxCell><mxCell id="c20" value="Random capture request: one box, 2 hours" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="776.1" width="180" height="48" as="geometry"/></mxCell><mxCell id="c21" value="Capture a live photo in the app (server time, place, box)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="720" y="834.1" width="180" height="48" as="geometry"/></mxCell><mxCell id="c22" value="Hash, reuse check, crab detection, risk score" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="892.1" width="180" heig