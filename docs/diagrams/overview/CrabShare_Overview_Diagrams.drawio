;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c29" target="c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="52" y="1046"/><mxPoint x="52" y="1320.4"/></Array></mxGeometry></mxCell><mxCell id="75" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="76" value="[complaint]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="77" value="[return in window]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="78" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="79" value="[full refund]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c34" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="80" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="81" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="82" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="83" value="[else]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c34" target="c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="1208.4"/><mxPoint x="748" y="1320.4"/></Array></mxGeometry></mxCell><mxCell id="84" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="85" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.6867;entryY=0;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="86" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="87" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="88" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="89" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="90" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="91" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="92" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="93" value="[yes]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;exitX=0.5;exitY=1;entryX=0.6000;entryY=0;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="94" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;dashed=1;strokeColor=#64748b;fontColor=#64748b;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="95" value="[no: revise]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c48" target="c46"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="497.2"/><mxPoint x="988" y="360"/></Array></mxGeometry></mxCell><mxCell id="c96" value="&lt;b&gt;WF-04 · owner Nhân&lt;/b&gt; — UC25, UC27, UC55, UC12, UC40, UC22, UC29, UC30, UC54, UC33, UC31, UC32, UC50, UC51.&lt;br&gt;Two flows. Each pre-order (from the start on the left) ends at its own flow final. The Batch flow (top of the Operator lane) runs once per Batch: the harvest per box, then, after the sales window closes, the invoiced sales of low-grade crabs and of crabs from forfeited orders (saleReason LowGrade, ForfeitResale) and one final order to the committed buyer, never below the floor price.&lt;br&gt;Deposit (UC55 Cancel Bulk Pre-order; UC54 Forfeit Deposit «extend» UC55 and UC30): (a) cancelled after paying and the batch opens → forfeited (ForfeitedDeposit, counted once); (b) the batch does not open → every deposit refunded, cancelled orders included; (c) delivery refused or balance not paid → forfeited, the crabs go back to stock for the Batch's invoiced sale; (d) cancelled or unpaid before the deposit (15-minute hold) → nothing lost.&lt;br&gt;Balance = weighed kg × price per kg locked before funding − deposit; weighed kg counts the live crabs received, transit loss is only recorded, a negative balance is refunded; delivery within the farm's radius is included. The order QR code is issued when the Operator prepares the delivery note; every delivered order has an invoice. A return in the window returns the order; a complaint is resolved by the Administrator with the Operator's answer: a full refund returns it, otherwise the order completes after the return window. Every refund: the system creates the instruction, the Administrator sends it and the payment provider executes it.&lt;br&gt;States: BulkPreOrder PendingPayment → DepositPaid → Confirmed «planned» → Packed → Shipping → Delivered → Completed, or Cancelled, Refunded «planned», Forfeited «planned», Returned (Figure O.15); InvoicedSale and FinalOrder PendingPayment → Completed (Figure 4.18).&lt;br&gt;Overview of all five: Figure O.17 · detailed: Figure 4.34 (5 parts).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="66" width="590" height="315" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Register v1.4 vs code&lt;/b&gt; — develop still sells through listings: pre-orders on a listing only while the batch is InProduction, the balance asked for when harvesting starts, packing by scanning per-crab tags, retail cart and checkout, and the offtake window (all removed in v1.4, still in code). Planned for v1.4: farm map and delivery radius, ordering by crab count with a minimum while funding, the forfeit rule on cancellation, refunds and forfeits of Customer deposits, the delivery note with the order QR code, weighing at the door and the balance on weighed kg, invoiced sales of low-grade or resold crabs and the final order at the floor price." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="397" width="590" height="109" as="geometry"/></mxCell><mxCell id="c98" value="&lt;b&gt;Legend&lt;/b&gt; — green: human action · blue: system action · yellow: external system · diamond: decision with guards, or merge · bar: fork / join · orange box: object with state · hourglass (collate) shape: time event · ◉ activity final · ⊗ flow final · dashed grey with «planned»: Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="522" width="590" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O22 Activity – WF-05" id="O22_Activity___WF_05"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.22 – Activity Diagram: WF-05 Settlement, feedback and payout (Platform Administrator, Investor, Operator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Platform Administrator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="230" height="1406.3" as="geometry"/></mxCell><mxCell id="c4" value="CrabShare System" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="270" y="66" width="440" height="1406.3" as="geometry"/></mxCell><mxCell id="c5" value="Investor" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="710" y="66" width="230" height="1406.3" as="geometry"/></mxCell><mxCell id="c6" value="Operator" style="swimlane;html=1;whiteSpace=wrap;startSize=36;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="940" y="66" width="230" height="1406.3" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="142" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="c8" value="Start the settlement calculation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="196.1" width="190" height="48" as="geometry"/></mxCell><mxCell id="c9" value="Actual revenue = delivered orders + invoiced sales + forfeited deposits + final order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="252.10000000000002" width="400" height="52" as="geometry"/></mxCell><mxCell id="c10" value="Revenue Pool = actual revenue − locked Standard Cost of the funded boxes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="310.1" width="400" height="52" as="geometry"/></mxCell><mxCell id="c11" value="Pool &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="410" y="366.1" width="160" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Remuneration = floor(Pool × rate), cut by tier below the survival threshold; rest pro rata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="280" y="424.1" width="204" height="56" as="geometry"/></mxCell><mxCell id="c13" value="No remuneration; loss pro rata, capped at capital; overrun with the Operator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="496" y="424.1" width="204" height="56" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="475" y="495.1" width="30" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Settlement [Draft], one line per investor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="340" y="548.1" width="300" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Publish the proposal (7–14-day window)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="602.1" width="190" height="48" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=0;html=1;fillColor=#1e293b;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="95" y="681.1" width="1020" height="6" as="geometry"/></mxCell><mxCell id="c18" value="Review own statement line" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="730" y="718.1" width="190" height="48" as="geometry"/></mxCell><mxCell id="c19" value="Review the full statement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="960" y="718.1" width="190" height="48" as="geometry"/></mxCell><mxCell id="c20" value="feedback?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="745" y="772.1" width="160" height="56" as="geometry"/></mxCell><mxCell id="c21" value="Submit feedback with grounds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="730" y="860.2" width="190" height="48" as="geometry"/></mxCell><mxCell id="c22" value="Answer the feedback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="918.2" width="190" height="48" as="geometry"/></mxCell><mxCell id="c23" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="810" y="985.2" width="30" height="30" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;html=1;fillColor=#1e293b;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="95" y="1055.2" width="1020" height="6" as="geometry"/></mxCell><mxCell id="c25" value="feedback window ends" style="shape=collate;whiteSpace=nowrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="102" y="1099.2" width="26" height="34" as="geometry"/></mxCell><mxCell id="c26" value="Approve the settlement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="1176.3" width="190" height="48" as="geometry"/></mxCell><mxCell id="c27" value="Lock the statement; create payout and remuneration instructions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="1234.3" width="400" height="48" as="geometry"/></mxCell><mxCell id="c28" value="Send the instructions via the payment intermediary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#ecfdf5;strokeColor=#047857;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="1292.3" width="190" height="48" as="geometry"/></mxCell><mxCell id="c29" value="All payouts succeeded: close the settlement and the batch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="290" y="1350.3" width="400" height="48" as="geometry"/></mxCell><mxCell id="c30" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="1419.3" width="26" height="26" as="geometry"/></mxCell><mxCell id="31" value="[sales closed, return windows over]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="220.1"/></Array></mxGeometry></mxCell><mxCell id="33" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="34" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="35" value="[yes]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="382" y="394.1"/></Array></mxGeometry></mxCell><mxCell id="36" value="[no: loss]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="598" y="394.1"/></Array></mxGeometry></mxCell><mxCell id="37" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="382" y="510.1"/></Array></mxGeometry></mxCell><mxCell id="38" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="598" y="510.1"/></Array></mxGeometry></mxCell><mxCell id="39" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="40" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="568.1"/></Array></mxGeometry></mxCell><mxCell id="41" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.0588;entryY=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="42" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.7157;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.9412;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="[yes]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="884.2"/></Array></mxGeometry></mxCell><mxCell id="47" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="1000.2"/></Array></mxGeometry></mxCell><mxCell id="48" value="[no]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="928" y="800.1"/><mxPoint x="928" y="1000.2"/></Array></mxGeometry></mxCell><mxCell id="49" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.7157;entryY=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="50" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.9412;entryY=0;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="51" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.0196;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="52" value="[no open feedback]" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;exitX=0.5;exitY=1;entryX=0.2895;entryY=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="53" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="1200.3"/></Array></mxGeometry></mxCell><mxCell id="54" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="1258.3"/></Array></mxGeometry></mxCell><mxCell id="55" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="1316.3"/></Array></mxGeometry></mxCell><mxCell id="56" value="" style="html=1;endArrow=open;endFill=0;strokeColor=#334155;fontSize=11;edgeStyle=none;rounded=0;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;WF-05 · owner Thiện&lt;/b&gt; — UC38, UC37, UC35, UC36, UC39, UC40 (UC43 for the audit anchors).&lt;br&gt;The calculation starts once sales have closed and the return windows are over; approval waits until the feedback window ends with no open feedback.&lt;br&gt;Revenue Pool and payouts in integer VND; payouts plus remuneration equal the revenue; largest-remainder rounding. Worked example (Register v1.4): Standard Cost 100,000,000 VND, revenue 300,000,000 VND, Pool 200,000,000 VND; at 90 % survival (threshold 85 %) the 10 % remuneration is 20,000,000 VND; at 80 % survival it is halved.&lt;br&gt;Survival rate = 1 − deaths during farming ÷ crabs first stocked in the funded boxes (restocked crabs that die count; deaths in transit only lower revenue). Unused Standard Cost, including an unused mortality reserve, stays with the Operator; only an early liquidation returns unspent capital.&lt;br&gt;Exception branches: negative Pool (loss capped at capital); unresolved feedback; failed payout resent with the same reference.&lt;br&gt;States: settlement Draft → Proposed ⇄ Disputed → Approved → PaidOut → Closed; payment instruction Created → Succeeded / Failed, a failed one resent (the Sent value is allowed by the database but never written by code).&lt;br&gt;Overview of all five: Figure O.17 · detailed: Figure 4.35 (3 parts).&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="66" width="420" height="301" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Register v1.4 vs code&lt;/b&gt; — the settlement engine and approval flow exist; remuneration on develop is a fixed operator_share_pct, so the tier cut by survival rate is planned, as are the revenue lines InvoicedSale (low-grade or resold crabs), ForfeitedDeposit of pre-orders and FinalOrder. Develop's revenue = completed orders + forfeited offtake deposits − refunds." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="383" width="420" height="95" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Legend&lt;/b&gt; — green: human action · blue: system action · yellow: external system · diamond: decision with guards, or merge · bar: fork / join · orange box: object with state · hourglass (collate) shape: time event · ◉ activity final · ⊗ flow final · dashed grey with «planned»: Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="494" width="420" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O23 Sequence – Contribute" id="O23_Sequence___Contribute"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.23 – Sequence Diagram: reserve, sign and pay a contribution (UC11, UC10, UC14, UC12)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Investor" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="105" y="80" width="40" height="1012" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web app&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="170" height="1012" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;CrabShare API&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#e0f2fe;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="170" height="1012" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#f1f5f9;" vertex="1" parent="1"><mxGeometry x="610" y="80" width="170" height="1012" as="geometry"/></mxCell><mxCell id="c7" value="«external»&lt;br&gt;&lt;b&gt;Viettel signing&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#fef3c7;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="170" height="1012" as="geometry"/></mxCell><mxCell id="c8" value="«external»&lt;br&gt;&lt;b&gt;Payment provider&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#fef3c7;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="170" height="1012" as="geometry"/></mxCell><mxCell id="c9" value="Operator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="1245" y="80" width="40" height="1012" as="geometry"/></mxCell><mxCell id="10" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="499" y="188" width="12" height="288" as="geometry"/></mxCell><mxCell id="11" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#e2e8f0;strokeColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="499" y="570" width="12" height="394" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;par&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;width=60;height=24;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontFamily=Segoe UI;fillColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="46" y="542" width="1280" height="442" as="geometry"/></mxCell><mxCell id="13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#1e293b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="46" y="724" as="sourcePoint"/><mxPoint x="1326" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="read the risk disclosure to the end" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="160" as="sourcePoint"/><mxPoint x="315" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="save the risk acknowledgement (UC11)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="198" as="sourcePoint"/><mxPoint x="499" y="198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="pick free box rows &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt; (amount = their capital)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="236" as="sourcePoint"/><mxPoint x="315" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="reserve the contribution (UC10)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="274" as="sourcePoint"/><mxPoint x="499" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="check eKYC, risk ack., limits (row lock)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="312" as="sourcePoint"/><mxPoint x="695" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="Reserved, rows Held &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;; 30-min hold" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="350" as="sourcePoint"/><mxPoint x="695" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="reservation and countdown" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="499" y="388" as="sourcePoint"/><mxPoint x="315" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="open the contract step (UC14)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="426" as="sourcePoint"/><mxPoint x="499" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="contract Draft from the template" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="464" as="sourcePoint"/><mxPoint x="695" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="The two operands below run in parallel: signing does not block payment and payment does not block signing; stocking needs both." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="496" width="1160" height="32" as="geometry"/></mxCell><mxCell id="24" value="Operator (owner) signs first" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1265" y="580" as="sourcePoint"/><mxPoint x="511" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="sign the current file (sandbox)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="618" as="sourcePoint"/><mxPoint x="885" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" value="Investor signs second" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="656" as="sourcePoint"/><mxPoint x="499" y="656" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="FullySigned + final hash" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="694" as="sourcePoint"/><mxPoint x="695" y="694" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="request the VietQR code (UC12)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="762" as="sourcePoint"/><mxPoint x="499" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="payment request on the batch account" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="800" as="sourcePoint"/><mxPoint x="1075" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="VietQR code, expires with the hold" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#475569;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="499" y="838" as="sourcePoint"/><mxPoint x="315" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="transfer with a banking app" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="876" as="sourcePoint"/><mxPoint x="1075" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="payment webhook (signed)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="914" as="sourcePoint"/><mxPoint x="511" y="914" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="match once; Confirmed; rows Allocated &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#1e293b;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511" y="952" as="sourcePoint"/><mxPoint x="695" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="Order taken from the code: Features/Funding and the web wizard (risk → amount → contract → VietQR → done). The Register lists &quot;reserve, pay by VietQR and sign&quot;; the code allows either order, and stocking needs every Confirmed contribution with a FullySigned contract. If the hold expires unpaid, the reservation expires and the unsigned contract is voided; a late payment is refunded automatically. CrabShare never holds the money." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="998" width="1160" height="46" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;Legend&lt;/b&gt; — filled arrow: request · open arrow: asynchronous message · dashed: reply · narrow bar: activation of the API or library while it handles the messages · dashed participant or «planned»: not on develop yet. Participants are grouped (one box for the whole API); the detailed diagrams show controllers, services and ports: Figures 4.36–4.38.&lt;br&gt;Design decisions of 05/11/2026 applied here were confirmed by the lead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1108" width="1290" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="O24 Sequence – Settlement" id="O24_Sequence___Settlement"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure O.24 – Sequence Diagram: settle a batch and pay out (UC38, UC37, UC35, UC39, UC40)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="42" as="geometry"/></mxCell><mxCell id="c3" value="Platform Administrator" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="105" y="80" width="40" height="638" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web app&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="170" height="638" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;CrabShare API&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#e0f2fe;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="170" height="638" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Settlement engine&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#ede9fe;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="170" height="638" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#1e293b;size=40;fontSize=11;fontFamily=Segoe UI;size=50;fontSize=12;fillColor=#f1f5f9;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="170" height="638" as="geometry"/></mxCell><mxCell id="c8" value="Investor" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=11;fontFamily=Segoe UI;fontSize=13;fontStyle=1;whiteSpace=nowrap;size=46;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="1105" y="80" width="40" height="638" as="geometry"/></mxCell><mx