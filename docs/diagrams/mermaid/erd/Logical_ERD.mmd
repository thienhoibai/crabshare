    InvestmentContract {
        Integer ContractId PK
        Text ContractNo UK
        Integer ContributionId FK, UK
        Integer TemplateId FK
        Text Status
        Text SigningMethod
        Text DraftHash
        Text FinalFileUri "optional"
        Text FinalHash "optional"
        DateTime FullySignedAt "optional"
    }
    RiskAcknowledgement {
        Integer InvestorId PK, FK
        Integer RiskDisclosureId PK, FK
        DateTime AcknowledgedAt
        Boolean ScrolledToEnd
    }
    RiskDisclosure {
        Integer RiskDisclosureId PK
        Text VersionCode UK
        Text ContentHash
        DateTime EffectiveFrom
        Text Status
    }
    StandardCostItem {
        Integer CostItemId PK
        Integer CostVersionId FK
        Text Category
        Text Description
        Decimal Quantity
        Text Unit
        Money UnitPrice
        Integer TrancheNo "optional"
    }
    TranchePlan {
        Integer CostVersionId PK, FK
        Integer TrancheNo PK
        Date PlannedDate "optional"
        Text UnlockCondition
        Text AnchorCode "optional"
        Integer OffsetDays "optional"
    }
    StandardCostVersion {
        Integer CostVersionId PK
        Integer BatchId FK
        Integer VersionNo
        Text Status
        DateTime SubmittedAt "optional"
        Integer ApprovedBy FK "optional"
        DateTime ApprovedAt "optional"
        DateTime LockedAt "optional"
    }
    %% BK StandardCostVersion (BatchId, VersionNo)
    %% «planned» entity RowAllocation: no table yet
    RowAllocation {
        Integer RowAllocationId PK "planned"
        Integer ContributionId FK "planned"
        Integer BoxRowId FK "planned"
        Text Status "planned"
    }
    %% rule RowAllocation: at most one Held or Allocated allocation per BoxRow (confirmed by the lead)
    %% «planned» entity RemunerationTier: no table yet
    RemunerationTier {
        Integer RemunerationTierId PK "planned"
        Integer BatchId FK "planned"
        Integer TierNo "planned"
        Decimal MinSurvivalPct "planned"
        Decimal MaxSurvivalPct "planned, optional"
        Decimal RemunerationPct "planned"
    }
    %% BK RemunerationTier (BatchId, TierNo)
    %% ===== A3 · Production, evidence and alerts
    Alert {
        Integer AlertId PK
        Integer BatchId FK
        Text AlertType
