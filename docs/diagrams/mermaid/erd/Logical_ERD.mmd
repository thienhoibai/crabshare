%% CrabShare – Logical ERD (Figure 4.2) · v3.2 · 05/11/2026 · Register v1.4
%% Built from database/migrations V001–V017 (develop @ 420a379) plus the Register v1.4 changes.
%% Types are DBMS-independent: Integer, Money (integer VND), Decimal, Text, Date, DateTime, Boolean, UUID.
%% "planned" = in Register v1.4 but not in code yet; "changed" = meaning or values change in v1.4; "derived" = derived value or snapshot stored once; "composite FK" = BatchId is also part of a composite foreign key that keeps both rows in the same Batch.
%% Removed from the v1.4 model (kept only in the Physical ERD): ProductListing, PriceHistory, PriceCheck, OrderLine, StockReservation, OfftakeCommitment, BatchOfftakePrice, CrabTag, TagScan, ProductionThreshold.
%% Design decisions of 05/11/2026 applied here were confirmed by the lead (Batch opening condition, box rows, forfeited deposits, survival rate, weighed-kg balance, unused Standard Cost, InvoicedSale); the affected rules end with (confirmed by the lead).
erDiagram
    %% ===== A1 · Identity, accounts, farm and boxes
    User {
        Integer UserId PK
        Text Email UK
        Text Phone UK "optional"
        Text FullName
        Text PasswordHash
        Text Status
        DateTime LastLoginAt "optional"
    }
    UserRole {
        Integer UserId PK, FK
        Text RoleCode PK
        DateTime GrantedAt
    }
    Customer {
        Integer UserId PK, FK
        Text DisplayName "optional"
    }
    DeliveryAddress {
        Integer AddressId PK
        Integer CustomerId FK
        Text RecipientName
        Text RecipientPhone
        Text AddressLine
        Text Province
        Boolean IsDefault
        Decimal Latitude "planned, optional"
        Decimal Longitude "planned, optional"
    }
    Investor {
        Integer UserId PK, FK
        Text InvestorKind
        Text OrganizationName "optional"
        Text TaxCode "optional"
        Text VerificationStatus
        DateTime VerifiedAt "optional"
    }
    IdentityCheck {
        Integer KycCheckId PK
        Integer UserId FK
        Text CheckType
        Text ProviderRef "optional"
        DateTime ConsentAt "optional"
        Text Result
        Text FailureReason "optional"
        Integer ReviewedBy FK "optional"
        DateTime CheckedAt
    }
    Operator {
        Integer OperatorId PK
        Text LegalName
        Text TaxCode UK
        Text BusinessRegNo
        Text FarmAddress
        Integer ApprovedBoxCapacity
        Text Status
        DateTime SubmittedAt "optional"
        DateTime ApprovedAt "optional"
        Integer ApprovedBy FK "optional"
        Decimal FarmLatitude "planned, optional"
        Decimal FarmLongitude "planned, optional"
    }
    OperatorMember {
        Integer UserId PK, FK
        Integer OperatorId FK
        Text MemberRole
        DateTime JoinedAt
    }
    PayoutAccount {
        Integer PayoutAccountId PK
        Integer OwnerUserId FK "optional"
        Integer OwnerOperatorId FK "optional"
        Text BankCode
        Text AccountNo
        Text AccountHolderName
        Text NameMatchStatus
        Text Status
        Text AccountNoDigest UK "optional"
    }
    Box {
        Integer BoxId PK
        Integer OperatorId FK
        Text BoxCode
        Text RowCode "optional"
        Integer RackNo "optional"
        Integer TierNo "optional"
        Integer ColumnNo "optional"
        Text Status
    }
    %% BK Box (OperatorId, BoxCode)
    BoxAllocation {
        Integer BoxAllocationId PK
        Integer BatchId FK
        Integer BoxId FK
        DateTime AllocatedAt
        DateTime ReleasedAt "optional"
        Integer BoxRowId FK "planned"
    }
    %% «planned» entity BoxRow: no table yet
    BoxRow {
        Integer BoxRowId PK "planned"
        Integer BatchId FK "planned"
        Text RowCode "planned"
        Integer BoxCount "planned, derived"
        Money CapitalVnd "planned, derived"
    }
    %% BK BoxRow (BatchId, RowCode)
    %% rule BoxRow: groups allocated boxes by Box.RowCode; CapitalVnd = BoxCount × cost per box, not below the platform minimum (confirmed by the lead)
    %% ===== A2 · Batch, Standard Cost, funding and contracts
    Batch {
        Integer BatchId PK
        Text BatchCode UK
        Integer OperatorId FK
        Text CrabType
        Text Title
        Integer SeedQuantity
        Decimal ExpectedOutputKg
        Integer CycleDays
        Integer RestockCutoffDays
        Money MinViableCapital
        Money TargetCapital
        Money MaxCapital
        Money MinContribution "changed, derived"
        Decimal OperatorSharePct
        Integer FrozenStockCapMonths
        Decimal PreOrderCapPct "changed"
        Decimal DepositPct "changed"
        Integer FeeTierId FK "optional"
        Money PlatformFeeAmount "derived, optional"
        Text Status
        DateTime FundingOpenAt "optional"
        DateTime FundingDeadline "optional"
        DateTime CapitalClosedAt "optional"
        Money TotalConfirmedCapital "derived, optional"
        DateTime StockedAt "optional"
        Date ExpectedHarvestDate "optional"
        DateTime HarvestStartedAt "optional"
        DateTime EarlyLiquidationAt "optional"
        DateTime ClosedAt "optional"
        Integer ApprovedBy FK "optional"
        DateTime ApprovedAt "optional"
        Text RejectionReason "optional"
        Money PricePerKgVnd "planned"
        Money FloorPriceVnd "planned"
        Decimal SurvivalThresholdPct "planned"
        Decimal DeliveryRadiusKm "planned"
        Decimal MinPreOrderRatioPct "planned"
        Integer SalesWindowDays "planned"
    }
    %% rule Batch: opens when confirmed capital ≥ MinViableCapital and pre-order ratio ≥ MinPreOrderRatioPct; else refund all (confirmed by the lead)
    BatchAccount {
        Integer BatchAccountId PK
        Integer BatchId FK, UK
        Text ProviderName
        Text ProviderAccountNo UK
        Text Status
        DateTime OpenedAt "optional"
        DateTime ClosedAt "optional"
    }
    CapitalShare {
        Integer BatchId PK, FK
        Integer InvestorId PK, FK
        Money ConfirmedAmount
        DateTime SnapshottedAt
    }
    ContractSignature {
        Integer SignatureId PK
        Integer ContractId FK
        Text SignerRole
        Integer SigningOrder
        Integer SignerUserId FK
        Text ProviderRequestId "optional"
        Text SignedHash
        DateTime SignedAt
    }
    %% BK ContractSignature (ContractId, SignerRole)
    %% BK ContractSignature (ContractId, SigningOrder)
    ContractTemplate {
        Integer TemplateId PK
        Text VersionCode UK
        Text ContentHash
        Text Status
        DateTime EffectiveFrom "optional"
    }
    Contribution {
        Integer ContributionId PK
        Integer BatchId FK
        Integer InvestorId FK
        Money Amount "changed"
        Text Status
        DateTime ReservedAt
        DateTime ExpiresAt
        DateTime ConfirmedAt "optional"
        DateTime RefundedAt "optional"
    }
    %% rule Contribution: Amount = Σ CapitalVnd of its BoxRows (confirmed by the lead)
    DisbursementTranche {
        Integer TrancheId PK
        Integer BatchId FK
        Integer TrancheNo
        Money PlannedAmount
        Date PlannedDate "optional"
        Text UnlockCondition
        Text Status
        DateTime RequestedAt "optional"
        DateTime ExplanationDeadline "optional"
        DateTime ReleasedAt "optional"
        Text AnchorCode "optional"
        Integer OffsetDays "optional"
    }
    %% BK DisbursementTranche (BatchId, TrancheNo)
    FeeTier {
        Integer FeeTierId PK
        Text TierCode UK
        Money MinCapital
