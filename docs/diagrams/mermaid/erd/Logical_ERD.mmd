        Text OperatorResponse "optional"
        Text OperatorEvidenceUri "optional"
        DateTime RespondedAt "optional"
        DateTime EscalatedAt "optional"
        Text AdminNotes "optional"
    }
    ProductRating {
        Integer RatingId PK
        Integer OrderId FK, UK
        Integer Stars
        Text Comment "optional"
    }
    SalesOrder {
        Integer OrderId PK
        Text OrderNo UK
        Integer CustomerId FK "changed, optional"
        Integer BatchId FK
        Text OrderType "changed"
        Text Status "changed"
        Money TotalAmount
        Money DepositAmount "optional"
        DateTime BalanceDueAt "optional"
        Text RecipientName "derived"
        Text RecipientPhone "derived"
        Text ShippingAddress "derived"
        DateTime PlacedAt
        DateTime PaidAt "optional"
        DateTime ShippedAt "optional"
        DateTime DeliveredAt "optional"
        DateTime ReturnWindowEndsAt "optional"
        DateTime CompletedAt "optional"
        DateTime CancelledAt "optional"
        Text CancelReason "optional"
        Text CarrierName "optional"
        Text VehiclePlate "optional"
        Text DriverPhone "optional"
        DateTime ExpectedArrivalAt "optional"
        Text ShippingNote "optional"
        DateTime ReceivedAt "optional"
        Integer CrabCount "planned, optional"
        Decimal EstimatedKg "planned, optional"
        Decimal WeighedKg "planned, optional"
        Decimal TransitLossKg "planned, optional"
        Money BalanceVnd "planned, derived, optional"
        DateTime ForfeitedAt "planned, optional"
        Text SaleReason "planned, optional"
    }
    %% rule SalesOrder: SaleReason only for InvoicedSale (confirmed by the lead)
    %% «planned» entity Invoice: no table yet
    Invoice {
        Integer InvoiceId PK "planned"
        Integer OrderId FK, UK "planned"
        Text InvoiceNo UK "planned"
        Text BuyerName "planned"
        Text BuyerTaxCode "planned, optional"
        Money AmountVnd "planned"
        DateTime IssuedAt "planned"
    }
    %% rule Invoice: one per delivered order (BulkPreOrder, InvoicedSale or FinalOrder) (confirmed by the lead)
    %% «planned» entity PreOrderQuota: no table yet
    PreOrderQuota {
        Integer BatchId PK, FK "planned"
        Integer MaxCrabCount "planned"
        Integer HeldCrabCount "planned, derived"
        Integer DepositedCrabCount "planned, derived"
    }
    %% rule PreOrderQuota: HeldCrabCount + DepositedCrabCount ≤ MaxCrabCount (no overselling)
    %% «planned» entity PreOrderHold: no table yet
    PreOrderHold {
        Integer PreOrderHoldId PK "planned"
        Integer BatchId FK "planned"
        Integer OrderId FK, UK "planned"
        Integer CrabCount "planned"
        Text Status "planned"
        DateTime ExpiresAt "planned"
    }
    %% rule PreOrderHold: one per order; Active until ExpiresAt (Orders:ReservationMinutes = 15)
    %% «planned» entity OrderQrCode: no table yet
    OrderQrCode {
        Integer OrderQrCodeId PK "planned"
        Integer OrderId FK, UK "planned"
        Text QrToken UK "planned"
        DateTime IssuedAt "planned"
        DateTime RevokedAt "planned, optional"
    }
