    }
    CaptureRequest {
        Integer CaptureRequestId PK
        Integer BatchId FK
        Integer BoxId FK
        DateTime RequestedAt
        DateTime DueAt
        Text Status
        DateTime FulfilledAt "optional"
    }
    Crab {
        Integer CrabId PK
        UUID CrabUuid UK
        Integer BatchId FK "composite FK"
        Integer BoxAllocationId FK
        DateTime StockedAt
        Integer ReplacesCrabId FK "optional"
        Integer HarvestId FK "optional"
        Integer GradeId FK "optional"
        Integer WeightG "optional"
        Text Status
        Integer OrderId FK "planned, optional"
    }
    CrabHistory {
        Integer CrabEventId PK
        Integer CrabId FK
