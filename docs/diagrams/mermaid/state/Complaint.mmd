%% Figure 4.19 – State Machine Diagram: complaint.status (Order complaint) · v3.2 · 05/11/2026 · Register v1.4
%% Same content as CrabShare_State_Machines.drawio, page "complaint.status" (generated by gen-state.js, do not edit by hand).
%% «planned» = Register v1.4, not in code (class planned, grey dashed) · (not written by code) = CHECK value never written (class notwritten, orange dashed).
%% Labels are short (trigger [guard] / effect); the full label of each transition is in the %% line under it.
stateDiagram-v2
  state Active {
    [*] --> Open
    Open --> OperatorResponded : respond (Operator) · UC32
    %% respond (Operator) / operator_response, evidence · UC32
    Open --> Escalated : after(24 h) / escalated_at · UC32
    %% after(24 h) (escalation job) / escalated_at · UC32
    Escalated --> OperatorResponded : respond (Operator) · UC32
  }
  [*] --> Active : / submit complaint · UC31
  %% / created by submit return or complaint (Customer) · UC31
  Active --> Resolved : resolve [Refund, Compensation, Replacement] · UC32
  %% resolve (Admin) [Refund, Compensation or Replacement] / Refund instruction; refund = total → order Returned · UC32
  Active --> Rejected : resolve [Rejected or NoAction] · UC32
  %% resolve (Admin) [Rejected or NoAction] · UC32
  Resolved --> [*]
  Rejected --> [*]
  %% Created by submit return or complaint (Customer) only if: order Shipping, Delivered or Completed within the return window, no active complaint on the order (UC31).
  %% Active groups Open, OperatorResponded and Escalated: an active complaint blocks automatic order completion and customer returns; resolve applies from any of them.
  %% Resolved refunds are deducted from the batch's actual revenue before the Revenue Pool is computed. Kept in Register v1.4 (complaints on delivered BulkPreOrders within the return window).
  classDef planned stroke-dasharray:5 5,stroke:#64748b,color:#64748b,fill:#f8fafc
  classDef notwritten stroke-dasharray:5 5,stroke:#9a3412,fill:#f1f5f9
  classDef terminal fill:#f1f5f9,stroke:#64748b
  class Resolved, Rejected terminal
