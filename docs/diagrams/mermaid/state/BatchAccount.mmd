%% Figure 4.16 – State Machine Diagram: batch_account.status (dedicated batch account) · v3.2 · 05/11/2026 · Register v1.4
%% Same content as CrabShare_State_Machines.drawio, page "batch_account.status" (generated by gen-state.js, do not edit by hand).
%% «planned» = Register v1.4, not in code (class planned, grey dashed) · (not written by code) = CHECK value never written (class notwritten, orange dashed).
%% Labels are short (trigger [guard] / effect); the full label of each transition is in the %% line under it.
stateDiagram-v2
  state provider <<choice>>
  state "Requested (not written by code)" as Requested
  state "Frozen (not written by code)" as Frozen
  state "Closed (not written by code)" as Closed
  [*] --> provider : / batch approved · UC08
  %% / created on batch approval (Admin) · UC08
  provider --> Open : [sandbox] / opened at once
  %% [sandbox intermediary] / account opened at once: provider_account_no, opened_at
  provider --> Requested : [real intermediary] / requested (not written by code)
  %% [real intermediary] / account requested (not written by code)
  Requested --> Open : provider confirms (not written by code)
  %% provider confirms the account / opened_at (not written by code)
  Open --> Frozen : freeze [dispute] (not written by code)
  %% freeze (provider or Admin) [dispute] (not written by code)
  Frozen --> Open : lift freeze (not written by code)
  %% lift the freeze (not written by code)
  Open --> Closed : close [batch Closed, balance zero] (not written by code)
  %% close [batch Closed, balance zero] / closed_at (not written by code)
  Closed --> [*]
  note right of Requested
    Requested - CHECK value (not written by code)
  end note
  note right of Frozen
    Frozen - CHECK value (not written by code)
  end note
  note right of Closed
    Closed - CHECK value (not written by code)
  end note
  %% Code inserts the row directly as Open on approval (sandbox provisioner); Requested is only the column default, and Frozen and Closed have no code path.
  %% Every payment_request, provider_transaction and payment_instruction references this account; VietQR collection, deposits, disbursements, refunds and payouts require Open. The platform holds no money: the account sits at the payment intermediary (Register v1.4).
  classDef planned stroke-dasharray:5 5,stroke:#64748b,color:#64748b,fill:#f8fafc
  classDef notwritten stroke-dasharray:5 5,stroke:#9a3412,fill:#f1f5f9
  classDef terminal fill:#f1f5f9,stroke:#64748b
  class Requested, Frozen, Closed notwritten
