%% Figure 4.27 – State Machine Diagram: payout_account.status (+ name_match_status) · v3.2 · 05/11/2026 · Register v1.4
%% Same content as CrabShare_State_Machines.drawio, page "payout_account.status" (generated by gen-state.js, do not edit by hand).
%% «planned» = Register v1.4, not in code (class planned, grey dashed) · (not written by code) = CHECK value never written (class notwritten, orange dashed).
%% Labels are short (trigger [guard] / effect); the full label of each transition is in the %% line under it.
stateDiagram-v2
  state nameMatch <<choice>>
  [*] --> nameMatch : / save account · UC03
  %% / created by save account (Investor or Operator Owner): bank name match against the verified name; other accounts Closed · UC03
  nameMatch --> Active : [name matches] · UC03
  %% [holder name matches] / kyc_check BankNameMatch Passed · UC03
  nameMatch --> Locked : [name does not match] · UC03
  %% [name does not match] / BankNameMatch Failed (HTTP 200) · UC03
  Active --> nameMatch : re-save same account · UC03
  %% re-save the same bank and number [if the name changes: no payment instruction yet, else 409 payout.holder_immutable] · UC03
  Locked --> nameMatch : re-save corrected name · UC03
  %% re-save with the corrected holder name · UC03
  Closed --> nameMatch : save same account again · UC03
  %% save the same bank and number again (row reused) · UC03
  Active --> Closed : different account saved · UC03
  %% owner saves a different account · UC03
  Locked --> Closed : different account saved · UC03
  %% owner saves a different account · UC03
  %% Created by save account (Investor or Operator Owner) only if: the bank account number is not registered to another owner and there is no admin lock (UC03).
  %% No final state by design: a Closed account can be reused when the same bank and number are saved again. Only Active accounts receive instructions (PayoutSendService, DisbursementService, SettlementPayoutService resolve the active account at send time).
  %% Locked + Matched (an admin lock) blocks every save (403 payout.locked) but no endpoint produces it. Unchanged by Register v1.4.
  classDef planned stroke-dasharray:5 5,stroke:#64748b,color:#64748b,fill:#f8fafc
  classDef notwritten stroke-dasharray:5 5,stroke:#9a3412,fill:#f1f5f9
  classDef terminal fill:#f1f5f9,stroke:#64748b
