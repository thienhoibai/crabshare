%% Figure 4.25 – State Machine Diagram: app_user.status (User account) · v3.2 · 05/11/2026 · Register v1.4
%% Same content as CrabShare_State_Machines.drawio, page "app_user.status" (generated by gen-state.js, do not edit by hand).
%% «planned» = Register v1.4, not in code (class planned, grey dashed) · (not written by code) = CHECK value never written (class notwritten, orange dashed).
%% Labels are short (trigger [guard] / effect); the full label of each transition is in the %% line under it.
stateDiagram-v2
  state "PendingVerification (column default, not created by code)" as PendingVerification
  [*] --> Active : / register · UC01
  %% / created by register (anonymous): roles Customer (+ Investor), JWT issued · UC01
  Active --> Locked : lock [not self, reason]
  %% lock (Admin) [not self, reason] / existing JWTs rejected (401), login 403 auth.locked
  Locked --> Active : unlock [reason]
  %% unlock (Admin) [reason]
  PendingVerification --> Locked : lock (not written by code)
  %% lock (Admin) [not self, reason] (not written by code)
  Locked --> PendingVerification : unlock [was PendingVerification] (not written by code)
  %% unlock (Admin) [locked from PendingVerification] (not written by code)
  note right of PendingVerification
    PendingVerification - CHECK value (column default, not created by code)
  end note
  %% Created by register (anonymous) only if: email not taken (UC01).
  %% No final state by design: accounts are never deleted and a lock is reversible. Every service re-checks status = Active in the database, not only in the JWT. Lock and unlock belong to admin user management (no UC code).
  %% PendingVerification is the column default only: the lock and unlock code would handle such a user, but no code creates one. Unchanged by Register v1.4.
  classDef planned stroke-dasharray:5 5,stroke:#64748b,color:#64748b,fill:#f8fafc
  classDef notwritten stroke-dasharray:5 5,stroke:#9a3412,fill:#f1f5f9
  classDef terminal fill:#f1f5f9,stroke:#64748b
  class PendingVerification notwritten
