="182" height="62" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;pre-orders · invoiced sales, QR «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="992" y="494" width="182" height="62" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;dashboards · audit log · exports&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1182" y="494" width="182" height="62" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Health&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;live · ready · version&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="612" y="564" width="182" height="62" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Price Module&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;price range + MAPE (UC49)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="802" y="564" width="182" height="62" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Ingestion&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;simulator messages (UC52)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="992" y="564" width="182" height="62" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;[C3.3] Background jobs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;hosted, every 1 min to 6 h: FundingClose · ReservationExpiry · TrancheSchedule · OrderCompletion · ComplaintEscalation · AlertJob · CaptureRequest · AuditChainCheck · final-order reminder «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="190" height="154" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;[C3.4] Common&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;JWT auth and role policies · ICurrentUser · IAuditLog (hash chain) · IAlertRaiser · AppException → ProblemDetails · paging · CSV export · demo clock «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="800" y="680" width="190" height="154" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;[C3.5] «library» SettlementEngine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;used by Settlement · pure, no database: SettlementCalculator · LargestRemainderAllocator · remuneration tier cut «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1000" y="680" width="190" height="154" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;[C3.6] Infrastructure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;ports and adapters: persistence (EF Core 10), storage, payments, signing, eKYC (in-process Fake adapters), crab detection, security · detail: Figure 4.1 (2/2)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1200" y="680" width="180" height="154" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;[C3.7] Development-only endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;/api/dev/payments (simulated transfer through the webhook path) · /api/dev/preorders · /api/dev/settlements · OpenAPI + /scalar — 404 outside Development&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="600" y="852" width="780" height="66" as="geometry"/></mxCell><mxCell id="50" value="HTTPS · JSON · Bearer JWT" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=1;exitY=0.5;" edge="1" parent="1" source="c12" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="51" value="HTTPS · JSON · Bearer JWT" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=1;exitY=0.5;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="52" value="HTTPS POST · X-Api-Key&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.5;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="53" value="HTTPS&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=0.977;exitY=0;entryX=0.9368;entryY=1;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="54" value="HTTPS GET" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.97;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="55" value="calls" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="56" value="invoke" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.5;exitY=0;entryX=0.1218;entryY=1;" edge="1" parent="1" source="c45" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="57" value="use" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.3782;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c25" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="58" value="use" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.6346;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c25" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="59" value="use ports" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.8846;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c25" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="60" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = CrabShare component · amber = external system (outside the team boundary).&lt;br&gt;○ on the API border = provided interface; the arrow comes from the component that requires it.&lt;br&gt;Solid arrow = communication path with its protocol · dashed arrow = dependency / use.&lt;br&gt;Grey dashed outline or line, labelled «planned» = in Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="960" width="400" height="150" as="geometry"/></mxCell><mxCell id="61" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Register v1.4 (section 3.2c) lists &quot;farm systems&quot; as external; they are represented by the Device &amp;amp; Camera Simulator [X5] through the one common Ingestion API [I2]. Per-farm integration is out of scope, so no Farm Management System is drawn.&lt;br&gt;• Removed in v1.4, still in code, not drawn: Catalog (listings, price history, store, cart, checkout, retail orders), Offtake (commitments, priority window), per-crab tags (tag printing, packing and trace by tag code) and the PreorderBalance job.&lt;br&gt;• Design decisions of 05/11/2026 applied here were confirmed by the lead (box rows, forfeited deposits, weighed-kg balance, InvoicedSale)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="960" width="400" height="196" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Component Diagram (2 of 2) – data and external services" id="Component_Diagram__2_of_2____data_and_external_services"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.1 (2/2) – Component Diagram: System overview – infrastructure adapters, data stores and external services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · code: develop @ 420a379 · [C…], [S…], [X…], [I…], [M…] = row of Table 4.1 (2/2) · clients and feature modules: Figure 4.1 (1/2)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1390" height="46" as="geometry"/></mxCell><mxCell id="c3" value="«subsystem» [C3] CrabShare API (continued)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#1e293b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=0;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="560" height="760" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;[C3.2] Feature modules&lt;/b&gt; — &lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;19 modules, Figure 4.1 (1/2)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="520" height="56" as="geometry"/></mxCell><mxCell id="c5" value="[C3.6] Infrastructure — ports and adapters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#1e293b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=0;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="520" height="612" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;EF Core 10 AppDbContext scaffolded from the database (database-first)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="236" width="488" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Storage&lt;/b&gt; — IFileStorage&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;LocalFileStorage: contract PDFs, older files&lt;br&gt;CloudinaryFileStorage when Storage:Provider = Cloudinary&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="300" width="488" height="122" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;IPaymentGateway · IBatchAccountProvisioner → FakePaymentGateway&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="440" width="488" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Signing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;IDigitalSigningService → FakeSigningService&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="536" width="488" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;eKYC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;IEkycProvider · IBankNameMatcher → Fake adapters&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="604" width="488" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Crab detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;ICrabDetector → NoopCrabDetector (&quot;unknown&quot;); checks only whether a crab is present&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="672" width="488" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;DataProtection keys · payout account protection · HTTPS and forwarded headers&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=11;align=center;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="56" y="740" width="488" height="56" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#1e293b;fontSize=9;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="573" y="499" width="14" height="14" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;[S1] SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;Azure SQL (production) · LocalDB (dev)&lt;br&gt;60 tables · migrations V001–V017 (DbUp)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1f5f9;strokeColor=#1e293b;fontSize=11;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="226" width="300" height="76" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;[S2] File storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;/home/data/storage (App Service disk)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1f5f9;strokeColor=#1e293b;fontSize=11;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="306" width="300" height="56" as="geometry"/></mxCell><mxCell id="c16" value="«external system» &lt;b&gt;[X4] Cloudinary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;authenticated image storage (evidence photos)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="800" y="372" width="300" height="56" as="geometry"/></mxCell><mxCell id="c17" value="«external system» &lt;b&gt;[X1] Payment intermediary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;VietQR collection · Batch accounts · payouts · refunds&lt;br&gt;in-process Fake today · sandbox «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="300" height="84" as="geometry"/></mxCell><mxCell id="c18" value="«external system» &lt;b&gt;[X2] Viettel digital signing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;sequential contract signing&lt;br&gt;in-process Fake today · sandbox «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="800" y="532" width="300" height="64" as="geometry"/></mxCell><mxCell id="c19" value="«external system» &lt;b&gt;[X3] eKYC provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;identity check, result only&lt;br&gt;in-process Fake today · sandbox «planned»&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontFamily=Segoe UI;fontSize=12;spacingLeft=14;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="300" height="64" as="geometry"/></mxCell><mxCell id="c20" value="«artifact» &lt;b&gt;[M1] Crab detection model&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;trained on labelled box photos, loaded in-process&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;fillColor=#f8fafc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="672" width="300" height="56" as="geometry"/></mxCell><mxCell id="21" value="use ports" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="TDS 1433 · TLS&lt;br&gt;Managed Identity" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="file I/O" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=1;exitY=0.2787;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="HTTPS Upload API&lt;br&gt;signed URL 120 s" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=1;exitY=0.8197;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="REST/HTTPS sandbox&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.3333;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="[I3] webhook «planned»&lt;br&gt;HTTPS POST · HMAC" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=0;exitY=0.7857;" edge="1" parent="1" source="c17" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="REST/HTTPS sandbox&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="REST/HTTPS sandbox&lt;br&gt;«planned»" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="loads in-process&lt;br&gt;«planned»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = CrabShare component · amber = external system (outside the team boundary) · cylinder = data store.&lt;br&gt;○ on the API border = provided interface; the arrow comes from the component that requires it.&lt;br&gt;Solid arrow = communication path with its protocol · dashed arrow = dependency / use.&lt;br&gt;Grey dashed outline or line, labelled «planned» = in Register v1.4, not in code yet.&lt;br&gt;&quot;Fake&quot; adapter = in-process simulation of a provider (no production accounts, Register v1.4, section 4)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="300" height="206" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Payment, signing and eKYC run today as in-process Fake adapters (code); calls to the providers' sandboxes and the provider webhook are «planned».&lt;br&gt;• The crab detection module only checks whether a crab is present; it never rejects evidence alone.&lt;br&gt;• Removed in v1.4, still in code, not drawn: listing images on Cloudinary." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="292" width="300" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Table 4.1 (1 of 2) – Component blocks, clients and API" id="Table_4_1__1_of_2____Component_blocks__clients_and_API"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Table 4.1 (1/2) – Component Diagram blocks of Figure 4.1 (1/2): clients, simulator and the API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · code: develop @ 420a379 · one row per block code&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="46" as="geometry"/></mxCell><mxCell id="3" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;line-height:1.3;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:56px;&quot;&gt;ID&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:190px;&quot;&gt;Block&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:884px;&quot;&gt;Explanation&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:150px;&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; style=&quot;border:1px solid #cbd5e1;background:#f1f5f9;padding:3px 5px;font-weight:bold;&quot;&gt;Clients and simulator&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Web App&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;React 19 + Vite + TypeScript single-page app on Vercel; browser client for all four roles (Customer, Investor, Operator, Platform Administrator). Calls the API only through shared/api/http.ts; role gating in app/router.tsx.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Auth and session&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Login and registration; Zustand session store; the axios interceptor attaches the JWT and logs out on HTTP 401.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Customer orders&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Bulk pre-order by number of crabs (or kg) from the minimum quantity, VietQR deposit, balance on the weighed kg, tracking, return, complaint, rating (UC27–UC34); cancel a bulk pre-order (UC55); a deposit is forfeited when the customer walks away (UC54). Ordering by crab count and the weighed balance are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Farm map&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Customer picks on a map a farm that delivers to the address: farms and Batches open for pre-order whose delivery radius covers it (UC25).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Investor portal&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Explore Batches, reserve box rows and commit capital (UC10), pay by VietQR, sign the contract, portfolio, box details of own rows only (UC53), settlement statement and feedback.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.5&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Operator workspace&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Create a Batch by box rows with Standard Cost, price per kg with the price suggestion (UC49), floor price, survival threshold and remuneration tiers, delivery radius, sales window (UC07); boxes, logs, evidence, harvest per box, delivery, invoiced sales (UC50 Record Invoiced Sale) and the final order (UC51).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Admin console&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Approve operators, Batches, cost versions, floor prices and tiers; KYC queue; finance and reconciliation; evidence review; alerts; disputes; platform parameters (UC41; only fee tiers are wired today); audit log.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C1.7&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Public trace page&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Anonymous page showing farm, Batch and harvest record; in v1.4 it is opened from the QR code of a delivered order (UC33).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Mobile App&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Flutter 3 + Riverpod + go_router + Dio app for Android, used by Investor and Operator. Each feature has a repository interface with a Mock and an Api implementation (one Riverpod provider line switches them).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C2.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Auth and session&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Dio interceptor attaches the JWT; token kept in flutter_secure_storage (Android Keystore).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C2.2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Investor tabs&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Home, Batches, portfolio, eKYC, notifications; box details of own rows (UC53) is planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C2.3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Operator tabs&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Daily logs, box events, live camera-only evidence with server time, GPS and visible box number, random capture requests, harvest per box; delivery with weighing (UC29) is planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C2.4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;QR scan&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Scans a QR code and opens the trace result through the REST API; the order QR code is planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X5&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Device &amp;amp; Camera Simulator&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;External tool in place of IoT hardware and cameras (out of scope). Posts only meaningful data — photos, feeding, box events, daily logs; no temperature or salinity — through the Ingestion API (UC52 Submit Farm Device and Camera Data).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Map tile service&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Base map tiles for the farm map, fetched by the browser over HTTPS. Provider not chosen yet.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X7&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Static web resources&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Third-party files the browser loads directly: Google Fonts (index.css, landing.css, UI kit) and stock photos from images.pexels.com on the landing page. No user data is sent.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; style=&quot;border:1px solid #cbd5e1;background:#f1f5f9;padding:3px 5px;font-weight:bold;&quot;&gt;API&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;I1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;REST API /api/*&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;HTTPS, JSON, Bearer JWT with role policies; /api/trace/{code} and /api/health/live, ready, version are anonymous. OpenAPI and Scalar only in Development.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;I2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Ingestion API&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;POST /api/ingest/v1/* over HTTPS: JSON (and the photo), X-Api-Key issued to the Operator, idempotent by (Operator, client message id); stored as IngestionMessage.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;CrabShare API&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;One ASP.NET Core (.NET 10) process: controllers, feature services, background jobs and adapters in one deployable (modular monolith).&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;REST controllers&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;51 controller classes in 49 files, all marked [ApiController] (DashboardControllers.cs holds two classes; PaymentWebhookController.cs also holds DevPaymentsController). DTO validation → 400; AppException → ProblemDetails {code, detail}; rate limiter on login; CORS for the Vercel origins.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Feature modules&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;17 modules kept by v1.4 plus two planned ones: Price Module (seasonal and holiday price range from 2–3 years of prices, backtest MAPE, shown as a range with a warning, never as a return) and Ingestion (simulator messages → logs, box events, photos). Planned parts: box rows and the farm map query in Batches, row allocation in Funding, pre-order quota and 15-minute holds, invoiced sales, the final order and the order QR in Orders, revenue lines and remuneration tiers in Settlement.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Background jobs&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Eight hosted jobs kept by v1.4 (six RecurringJob, two timer workers): reservation expiry, funding close with refunds, tranche schedule, order completion, complaint escalation (each 1 min), capture requests (5 min), alerts (15 min), audit hash-chain check (6 h). The final-order reminder when the sales window closes is planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Common&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Cross-cutting code: JWT auth and policies, ICurrentUser, IAuditLog with hash chain (append-only), IAlertRaiser, error handling, paging, CSV export. The simulated demo clock (Register v1.4, section 3.2e) is planned; code uses TimeProvider.System.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.5&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;SettlementEngine&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Pure library without database: Revenue Pool, operator remuneration, pro-rata payouts with largest-remainder rounding, loss cap; property-based tests (FsCheck). Remuneration cut by survival tier is planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#1d4ed8&quot;&gt;code + «planned» parts&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.7&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Development-only endpoints&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Simulated bank transfer through the real webhook path, demo pre-orders, ending the settlement feedback window, OpenAPI and Scalar; 404 outside Development.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1280" height="918" as="geometry"/></mxCell><mxCell id="4" value="Design decisions of 05/11/2026 applied here were confirmed by the lead (C1.2, C1.4, C1.5 and C3.2: box rows, forfeited deposits, weighed-kg balance, InvoicedSale)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="996" width="1280" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Table 4.1 (2 of 2) – Component blocks, data and external services" id="Table_4_1__2_of_2____Component_blocks__data_and_external_services"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Table 4.1 (2/2) – Component Diagram blocks of Figure 4.1 (2/2): adapters, data stores and external services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · code: develop @ 420a379 · one row per block code&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="46" as="geometry"/></mxCell><mxCell id="3" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;line-height:1.3;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:56px;&quot;&gt;ID&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:190px;&quot;&gt;Block&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:884px;&quot;&gt;Explanation&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:150px;&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;C3.6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Infrastructure&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Ports (interfaces) and adapters. External providers are registered as in-process Fake adapters in DependencyInjection.cs; storage is chosen by Storage:Provider. Persistence = EF Core 10, database-first.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;code · simulated&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;I3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Payment webhook&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;POST /api/webhooks/payment-provider: HMAC-SHA256 signature in X-Signature, idempotent by providerTxnId (a repeated webhook is recorded once). Today only the simulated transfer of the development endpoint calls it; calls from the provider are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;code · simulated&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;S1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;SQL Server&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Azure SQL (Basic) in production, LocalDB in development; 60 tables, 9 views, triggers for append-only and locked rows; migrations V001–V017 run by DbUp (DbMigrator). Money is DECIMAL(18,0) VND.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;S2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;File storage&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;App Service persistent disk /home/data/storage for contract PDFs and older uploads; storage/ folder in development.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Payment intermediary&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Holds each Batch's dedicated account, VietQR collection, payouts and refunds, transaction webhook. CrabShare never holds money. Today an in-process Fake adapter (FakePaymentGateway) stands in for it; calls to its sandbox are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt; · &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;sandbox «planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Viettel digital signing&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Sequential signing of investment contracts (Operator, then Investor). Today an in-process Fake adapter (FakeSigningService); calls to its sandbox are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt; · &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;sandbox «planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;eKYC provider&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Identity verification; only the result is stored. Today in-process Fake adapters (FakeEkycProvider, FakeBankNameMatcher); calls to its sandbox are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt; · &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;sandbox «planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;X4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Cloudinary&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Real account: authenticated upload of evidence photos over HTTPS, read back through signed URLs valid 120 s; used when Storage:Provider = Cloudinary.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;M1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Crab detection model&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Trained on labelled box photos; loaded in-process by the detection adapter. Precision ≥ 0.85 and recall ≥ 0.80 on a held-out set, otherwise only a weak signal in the risk score.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1280" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Deployment Diagram – Environments and CI-CD" id="Deployment_Diagram___Environments_and_CI_CD"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.4 – Deployment Diagram: Environments and CI/CD – local, preview (develop) and production&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · code: develop @ 420a379 · .github/workflows, docs/deploy.md · [N…] = row of Table 4.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1620" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;[N1] «device» User PC&lt;/b&gt;&lt;br&gt;«executionEnvironment» web browser" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="280" height="120" as="geometry"/></mxCell><mxCell id="c4" value="«artifact» web SPA bundle (index.html + assets/*.js) loaded from Vercel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="36" y="170" width="248" height="42" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;[N14] «external» Map tile service&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;farm map tiles · provider not chosen&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="280" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;[N2] «device» Android phone&lt;/b&gt;&lt;br&gt;«executionEnvironment» Flutter runtime · camera · GPS" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="280" height="150" as="geometry"/></mxCell><mxCell id="c7" value="«artifact» CrabShare APK (release, signed)&lt;br&gt;API_URL = https://crabshare-api.azurewebsites.net&lt;br&gt;installed from GitHub Releases [N11]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="36" y="544" width="248" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;[N3] «device» demo machine&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;«executionEnvironment» Device &amp;amp; Camera Simulator" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="280" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Preview / staging (develop) — web only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="640" height="160" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;[N8] «cloud» Vercel Preview deployments&lt;/b&gt;&lt;br&gt;push develop → alias https://crabshare-develop-nguyn1hien.vercel.app&lt;br&gt;pull request → one preview URL, posted as a PR comment" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="600" height="90" as="geometry"/></mxCell><mxCell id="11" value="&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#334155&quot;&gt;No separate staging API or database: previews call the production API [N5] (CORS pattern https://crabshare-*-nguyn1hien.vercel.app).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="194" width="600" height="34" as="geometry"/></mxCell><mxCell id="c12" value="Production — Azure region East Asia, resource group crabshare-rg (Azure for Students)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="640" height="520" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;[N4] «cloud» Vercel — project crabshare&lt;/b&gt;&lt;br&gt;Production: https://crabshare.vercel.app (from main)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="280" height="116" as="geometry"/></mxCell><mxCell id="c14" value="«artifact» web build (Vite dist/)&lt;br&gt;VITE_API_URL baked in at build time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="416" y="354" width="248" height="34" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;[N5] «cloud» App Service crabshare-api&lt;/b&gt;&lt;br&gt;Linux B1 · HTTPS only · Production&lt;br&gt;«executionEnvironment» .NET 10" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="410" width="280" height="330" as="geometry"/></mxCell><mxCell id="c16" value="«artifact» CrabShare.Api.dll + CrabShare.SettlementEngine.dll&lt;br&gt;dotnet publish, SourceRevisionId = SHA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="416" y="492" width="248" height="52" as="geometry"/></mxCell><mxCell id="c17" value="«artifact» /home/data/storage (uploads, contract PDFs) · /home/data/keys (DataProtection) — persistent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="416" y="550" width="248" height="50" as="geometry"/></mxCell><mxCell id="c18" value="«artifact» in-process Fake providers: payment / VietQR, Viettel signing, eKYC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;fillColor=#fffbeb;" vertex="1" parent="1"><mxGeometry x="416" y="606" width="248" height="34" as="geometry"/></mxCell><mxCell id="c19" value="App settings (names only): ConnectionStrings__Default, Jwt__SigningKey, Storage__RootPath, Cors__Origins / OriginPatterns, Security__DataProtectionKeyPath, Seed__Enabled=false" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="416" y="646" width="248" height="88" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;[N6] «cloud» Azure SQL&lt;/b&gt;&lt;br&gt;crabshare-sql / crabshare (Basic)&lt;br&gt;Entra sign-in, no SQL passwords" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="220" height="150" as="geometry"/></mxCell><mxCell id="c21" value="«artifact» schema V001–V017 + dbo.SchemaVersions (DbUp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="796" y="500" width="188" height="46" as="geometry"/></mxCell><mxCell id="c22" value="CI/CD — GitHub (thienhoibai/crabshare)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="580" height="640" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;[N9] «cloud» GitHub repository&lt;/b&gt;&lt;br&gt;main = production web · develop = integration (API + preview web) · feature branches → PR into develop" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="540" height="76" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;[N10] «executionEnvironment» GitHub Actions runner (ubuntu-latest)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="540" height="410" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;ci.yml&lt;/b&gt; — PR, push main/develop: API and migrator Docker images · dotnet build + test (Category!=Database) · web build + Playwright KYC test · flutter analyze + test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1116" y="252" width="508" height="44" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;deploy-backend.yml&lt;/b&gt; — push develop touching backend/, database/, deploy/: build + test → azure/login (OIDC, identity crabshare-github-deploy) → dotnet publish → check app settings without printing secrets → stop app → DbMigrator (new V*.sql only, never --reset) → azure/webapps-deploy → start → /api/health/ready → deploy/smoke.py → evidence artifact" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1116" y="302" width="508" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;deploy-web.yml&lt;/b&gt; — push main → production; push develop → preview + fixed alias (Vercel REST API); PR touching web/ → preview + PR comment: vercel pull → vercel build → vercel deploy --prebuilt (secret VERCEL_TOKEN). Vercel Git integration is off (web/vercel.json)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1116" y="398" width="508" height="76" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;release-mobile.yml&lt;/b&gt; — manual, develop only: signed release APK with API_URL and WEB_URL → draft GitHub prerelease" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1116" y="480" width="508" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;acceptance-tools.yml&lt;/b&gt; — PR touching tools/acceptance: safety tests of the acceptance scripts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontSize=10;fontFamily=Segoe UI;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1116" y="532" width="508" height="38" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;[N11] «cloud» GitHub Releases&lt;/b&gt; — draft prerelease with the signed demo APK (published after two-device acceptance)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="630" width="540" height="66" as="geometry"/></mxCell><mxCell id="c31" value="External services (outside the team boundary)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1080" y="740" width="580" height="190" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;[N7] «cloud» Cloudinary&lt;/b&gt;&lt;br&gt;authenticated images: crabshare/evidence/*&lt;br&gt;used when Storage__Provider = Cloudinary" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1100" y="776" width="270" height="130" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;[N13] «external» sandbox providers&lt;/b&gt;&lt;br&gt;payment intermediary (VietQR), Viettel signing, eKYC — no production accounts; in-process Fake adapters inside [N5] today, sandbox calls «planned»" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;fontFamily=Segoe UI;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1390" y="776" width="250" height="130" as="geometry"/></mxCell><mxCell id="c34" value="Local development — each member's PC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="1000" height="250" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;[N12] «device» Developer PC (Windows)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=16;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;s