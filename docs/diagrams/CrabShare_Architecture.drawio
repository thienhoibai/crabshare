Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=6 4;strokeColor=#64748b;fontColor=#475569;exitX=1;exitY=0.939;entryX=0.5;entryY=1;" edge="1" parent="1" source="c15" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="720"/><mxPoint x="1055" y="920"/><mxPoint x="1515" y="920"/></Array></mxGeometry></mxCell><mxCell id="51" value="push / pull_request triggers" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="52" value="Vercel CLI · alias&lt;br&gt;via REST API" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.0244;entryX=1;entryY=0.444;" edge="1" parent="1" source="c24" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="210"/><mxPoint x="1050" y="140"/></Array></mxGeometry></mxCell><mxCell id="53" value="Vercel CLI --prod (token)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0;exitY=0.2927;entryX=1;entryY=0.3448;" edge="1" parent="1" source="c24" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="54" value="DbMigrator&lt;br&gt;TDS/TLS&lt;br&gt;Entra token" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0;exitY=0.6098;entryX=1;entryY=0.2667;" edge="1" parent="1" source="c24" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="55" value="OIDC · zip deploy · stop/start · smoke HTTPS" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0;exitY=0.9512;entryX=1;entryY=0.5455;" edge="1" parent="1" source="c24" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="56" value="gh release create --draft" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c24" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="57" value="git push · pull request (HTTPS)" style="endArrow=open;endFill=0;html=1;strokeColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c35" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1050"/><mxPoint x="1680" y="1050"/><mxPoint x="1680" y="135"/></Array></mxGeometry></mxCell><mxCell id="58" value="&lt;b&gt;Legend&lt;/b&gt; — 3D box = node («device», «cloud» or «executionEnvironment») · white box = «artifact» deployed on the node · dashed rounded frame = environment · solid arrow = communication path labelled with its protocol · dashed arrow = dependency · amber = external service · grey dashed, labelled «planned» = in Register v1.4, not in code yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1072" width="1000" height="56" as="geometry"/></mxCell><mxCell id="59" value="&lt;b&gt;Notes&lt;/b&gt; — Payment, signing and eKYC run today as in-process Fake adapters inside [N5] (code); calls to the providers' sandboxes [N13] are «planned». App settings are shown by name only, never their values. Removed in v1.4, still in code, not drawn: listing images (crabshare/listings/*) on Cloudinary [N7]." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1072" width="580" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Table 4.4 – Environments and nodes" id="Table_4_4___Environments_and_nodes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Table 4.4 – Deployment Diagram environments and nodes (Figure 4.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · code: develop @ 420a379 · .github/workflows, docs/deploy.md&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="46" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;(a) Environments&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1280" height="20" as="geometry"/></mxCell><mxCell id="4" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;line-height:1.3;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:190px;&quot;&gt;Environment&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:280px;&quot;&gt;Web&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:330px;&quot;&gt;API&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:180px;&quot;&gt;Database&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:300px;&quot;&gt;Deployed by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;b&gt;Local / development&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Vite dev server on each PC&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;dotnet run, ASPNETCORE_ENVIRONMENT = Development (demo seed, Fake providers)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;LocalDB CrabShareDev&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;manual&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;b&gt;Preview / staging (develop)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Vercel Preview: fixed develop alias + one URL per pull request&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;shared with production (crabshare-api)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;shared with production&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;deploy-web.yml on push develop and on PRs touching web/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;b&gt;Production&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Vercel Production https://crabshare.vercel.app&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Azure App Service crabshare-api, deployed from develop&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Azure SQL crabshare&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;deploy-web.yml on push main; deploy-backend.yml on push develop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;b&gt;Optional container&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;backend/Dockerfile + deploy/compose.yml + Caddy (template only, never deployed)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;an existing SQL Server&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;manual (docs/deploy.md)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1280" height="170" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;(b) Nodes — one row per node code of Figure 4.4&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1280" height="20" as="geometry"/></mxCell><mxCell id="6" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;line-height:1.3;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:56px;&quot;&gt;ID&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:220px;&quot;&gt;Node&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:854px;&quot;&gt;Explanation&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:3px 5px;text-align:left;vertical-align:top;width:150px;&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;User PC (browser)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Any desktop browser of Customer, Investor, Operator or Administrator; downloads the SPA from Vercel, calls the API directly (CORS) and loads Google Fonts and the landing-page photos from their CDNs.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Android phone&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Investor and Operator app; release APK built with API_URL and WEB_URL; uses the camera and GPS for live evidence.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Demo machine with simulator&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Runs the Device &amp;amp; Camera Simulator that posts photos, feeding, box events and logs to the Ingestion API.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Vercel production&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Static hosting and CDN for the web build of main; VITE_API_URL is fixed at build time, so changing it needs a redeploy.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N5&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Azure App Service crabshare-api&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Single API instance for production and previews, deployed from develop. Persistent /home/data keeps uploads and DataProtection keys; system-assigned managed identity for SQL; external providers run as in-process Fake adapters; no demo seeding outside Development.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N6&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Azure SQL crabshare&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Basic tier database; the API logs in as [crabshare-api] (read/write only) and the deploy identity runs migrations; DbMigrator refuses --reset outside LocalDB.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N7&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Cloudinary&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Third-party storage for evidence photos, used through the Storage adapter. Whether Storage__Provider = Cloudinary is set on Azure cannot be verified from the repository.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N8&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Vercel Preview&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Preview builds of develop (fixed alias) and of each pull request; this is the only staging environment and it shares the production API and database.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N9&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;GitHub repository&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Source of truth; PRs into develop are reviewed and must pass CI; the leader merges develop into main.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N10&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;GitHub Actions&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Runs the five workflows shown; Azure login by OIDC (no stored password), Vercel by repository secrets; deploy-backend stops the app during migration and smoke-tests the deployed commit.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N11&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;GitHub Releases&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Draft prerelease that carries the signed demo APK and its release evidence.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N12&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Developer PC&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Each member runs web, API, LocalDB and Flutter locally; secrets stay in User Secrets.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#047857&quot;&gt;code&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N13&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Sandbox providers&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Payment intermediary, Viettel signing and eKYC; Register v1.4 keeps them in sandbox or simulated. Today in-process Fake adapters inside N5 (code) stand in for them, so no call leaves N5; calls to their sandboxes over REST/HTTPS are planned.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;external&lt;/font&gt; · &lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;sandbox «planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;N14&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Map tile service&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;Tiles for the farm map, loaded by the browser.&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:3px 5px;vertical-align:top;&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;&lt;i&gt;«planned»&lt;/i&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;spacing=0;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="314" width="