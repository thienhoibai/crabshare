e;strokeColor=#334155;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.086;entryDx=0;entryDy=0;" edge="1" parent="1" source="c64" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="849" y="886"/><mxPoint x="849" y="198"/></Array></mxGeometry></mxCell><mxCell id="135" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK primary key · FK foreign key (the line starts at this column) · U column in a unique index · NOT NULL as in the V001–V017 scripts. White box = parent table of another area or part, key only.&lt;br&gt;Crow's foot: child end O&amp;lt; or O| (unique FK = one-to-one); parent end | (NOT NULL FK) or O| (nullable FK). Audit columns pointing to app_user are not drawn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="1232" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Table 4.3 (1 of 2) Tables by area" id="Table_4_3__1_of_2__Tables_by_area"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Table 4.3 (1/2) – Physical Database Design: the 60 tables by area (Figure 4.3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · SQL Server, = code V001–V017 · areas A1, A2, A3&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="660" height="46" as="geometry"/></mxCell><mxCell id="3" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:44px;&quot;&gt;Area&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:230px;&quot;&gt;Table&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:640px;&quot;&gt;Role&lt;/th&gt;&lt;th style=&quot;border:1px solid #94a3b8;background:#e2e8f0;padding:2px 4px;text-align:left;width:230px;&quot;&gt;Logical entity (Figure 4.2)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;app_user&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Login account of every user (investor, customer, farm member, administrator)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;User&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;app_user_role&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Roles held by an account; one account can hold several&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;UserRole&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;investor&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Investor profile (subtype of app_user): kind and identity verification status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Investor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;customer&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Customer profile (subtype of app_user): bulk buyer such as a restaurant or trader&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Customer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;customer_address&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Delivery addresses of a customer&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;DeliveryAddress&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;kyc_check&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Each eKYC check of a user and its result&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;IdentityCheck&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;payout_account&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Bank account that receives payouts (user or farm); the account number is protected&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;PayoutAccount&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;operator&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Farm (Operator): legal data, approved box capacity, review status&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Operator&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;operator_member&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Users who work for a farm and their member role&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;OperatorMember&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;physical_slot&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Numbered box of a farm: box code, row code, rack, tier, column&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Box&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;slot_allocation&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A box assigned to a Batch (allocated, released)&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;BoxAllocation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;batch&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Batch: capital targets, operator share, platform fee, status and key dates&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Batch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;fee_tier&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Platform fee tiers by capital range&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;FeeTier&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;standard_cost_version&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;Versions of a Batch's Standard Cost; the approved one is locked&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;StandardCostVersion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:2px 4px;vertical-align:top;&quot;&gt;A2&lt;/td&gt;&lt;td style=&quot;border:1p