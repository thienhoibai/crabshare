4155;exitX=0;exitY=0.468;exitDx=0;exitDy=0;entryX=1;entryY=0.366;entryDx=0;entryDy=0;" edge="1" parent="1" source="c60" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="831" y="562.5"/><mxPoint x="831" y="749"/></Array></mxGeometry></mxCell><mxCell id="171" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=0;exitY=0.581;exitDx=0;exitDy=0;entryX=1;entryY=0.346;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="729" y="267"/><mxPoint x="729" y="381"/></Array></mxGeometry></mxCell><mxCell id="172" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToOne;endArrow=ERmandOne;strokeColor=#334155;exitX=0;exitY=0.355;exitDx=0;exitDy=0;entryX=1;entryY=0.346;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="260"/><mxPoint x="705" y="317"/></Array></mxGeometry></mxCell><mxCell id="173" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startFill=0;endFill=0;fontFamily=Segoe UI;startArrow=ERzeroToMany;endArrow=ERmandOne;strokeColor=#334155;exitX=0;exitY=0.467;exitDx=0;exitDy=0;entryX=1;entryY=0.289;entryDx=0;entryDy=0;" edge="1" parent="1" source="c62" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1221" y="217"/><mxPoint x="1221" y="210"/></Array></mxGeometry></mxCell><mxCell id="174" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Areas: &lt;font color=&quot;#1d4ed8&quot;&gt;■&lt;/font&gt; A1 Identity, accounts &amp; farm · &lt;font color=&quot;#b45309&quot;&gt;■&lt;/font&gt; A2 Batch, Standard Cost, funding &amp; contracts · &lt;font color=&quot;#0369a1&quot;&gt;■&lt;/font&gt; A3 Production, evidence &amp; alerts · &lt;font color=&quot;#0f766e&quot;&gt;■&lt;/font&gt; A4 Harvest, tags, catalogue &amp; traceability · &lt;font color=&quot;#c2410c&quot;&gt;■&lt;/font&gt; A5 Orders, complaints &amp; ratings · &lt;font color=&quot;#b91c1c&quot;&gt;■&lt;/font&gt; A6 Payments, settlement &amp; audit.&lt;br&gt;Each line is one foreign key; crow's foot: child end O&amp;lt; or O| (unique FK = one-to-one; a filtered unique index such as &quot;one active row&quot; does not make it one-to-one); parent end | (NOT NULL) or O| (nullable).&lt;br&gt;Audit columns pointing to app_user (approved_by, created_by, reviewed_by…) are not drawn here; they are listed with their FK flag on the area pages." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1188" width="1550" height="69" as="geometry"/></mxCell><mxCell id="175" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• This Physical ERD shows the database exactly as the code builds it on develop @ 420a379 (migrations V001–V017, 60 tables, 131 foreign keys). Register v1.4 changes are «planned» and drawn in the Logical ERD (Figure 4.2); traceability and code classes are in Table 4.2; the role of each table is in Table 4.3.&lt;br&gt;• Removed from the v1.4 business model but still used by code, so drawn here like every other table: product_listing, price_history, price_check, order_line, stock_reservation, offtake_commitment, batch_offtake_price, crab_tag, tag_scan, production_threshold_version.&lt;br&gt;• Not drawn: 9 views (v_batch_funding_progress, v_batch_actual_revenue, v_investor_portfolio, v_traceability, v_crab_count_reconciliation, v_batch_commitment_cap, v_settlement_reconciliation, v_operator_reputation, v_overdue_alerts) and the triggers that keep audit, price, cost-lock, harvest and settlement rows append-only or locked." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1269" width="1550" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A1 · Identity, accounts &amp; farm" id="A1___Identity__accounts__amp__farm"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.3.1 – Physical Database Design: Identity, accounts &amp; farm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4 · crow's foot · 11 tables + 1 parent tables of other areas or parts (white, key only) · lines start at the foreign-key column&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;overflow=visible;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="990" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;app_user&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;swimlaneFillColor=#ffffff;fontSize=12;fontFamily=Segoe UI;startSize=28;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="302" width="320" height="212" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font color=&quot;#b91c1c&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; user_id: bigint &lt;font color=&quot;#64748b&quot;&gt;NOT NULL&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fon