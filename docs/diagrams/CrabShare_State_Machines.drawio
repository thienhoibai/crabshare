rokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c8" value="PaidOut" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c9" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1440" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="145" width="24" height="24" as="geometry"/></mxCell><mxCell id="11" value="calculate (Admin) [batch&lt;br&gt;Harvesting | Settlement] /&lt;br&gt;SettlementCalculator: pool,&lt;br&gt;remuneration,&lt;br&gt;largest-remainder lines, loss&lt;br&gt;cap; batch → Settlement" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="recalculate (Admin) / revision_no++, lines&lt;br&gt;replaced" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;exitX=0.75;exitY=0;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="propose (Admin) [7 ≤ feedbackDays ≤ 14] /&lt;br&gt;proposed_at, feedback_deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="feedback (Investor) [now ≤&lt;br&gt;feedback_deadline] / settlement_feedback&lt;br&gt;Open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="answer (Admin) [no feedback left Open] /&lt;br&gt;Answered | Unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="170"/></Array></mxGeometry></mxCell><mxCell id="16" value="approve (Admin) [feedback_deadline passed,&lt;br&gt;no Open feedback] / lock (BR-30, trigger&lt;br&gt;trg_settlement_locked); instructions:&lt;br&gt;TaxPayment, operator Payout, investor&lt;br&gt;Payouts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="payout Succeeded [every investor line paid]&lt;br&gt;/ SettlementClosing.CloseIfPaidAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="/ batch → Closed, closed_at (same&lt;br&gt;transaction)" style="edgeStyle=orthogonalEdgeSty