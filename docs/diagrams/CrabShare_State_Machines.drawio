on.Allocated»&lt;/font&gt;, &lt;font color=&quot;#64748b&quot;&gt;«RowAllocation.Released»&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;modified + «planned» (box rows, RowAllocation)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;UC10, UC11, UC12, UC39, UC40&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;Contribution.mmd&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;Funding (Thiện)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;b&gt;4.10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;color:#64748b&quot;&gt;4.10&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;investment_contract.status (Contract)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;Draft, OperatorSigned, FullySigned, Void&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;kept (template content «planned»)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;UC10, UC14, UC15&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;InvestmentContract.mmd&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;Contracts (Thiện)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;b&gt;4.11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;color:#64748b&quot;&gt;4.11&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;payment_request.status (VietQR collection)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #e2e8f0;&quot;&gt;Pending, Paid, Expired, Cancelled&lt;/td&gt;&lt;td styl