vest the printed tag carries it (per-crab traceability, Register v1.3 §3.2b)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1200" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="crab_tag.status" id="crab_tag_status"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.27 – State Machine Diagram – crab_tag.status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 · states = CHECK constraint values · label = trigger [guard] / effect · module: Harvest (Viên)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#64748b&quot;&gt;&lt;b&gt;Source:&lt;/b&gt; HarvestService.RecordAsync (print) · TagsController.Activate/Void → TagsService.ActivateAsync/VoidAsync · TraceService (reads Active only)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Printed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillC