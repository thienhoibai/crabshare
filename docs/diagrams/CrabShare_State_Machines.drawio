5;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="resend (Admin) / same reference (idempotent&lt;br&gt;at gateway)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="150"/></Array></mxGeometry></mxCell><mxCell id="15" value="provider dispute notice — reserved, no code&lt;br&gt;path yet" style="dashed=1;strokeColor=#9a3412;fontColor=#9a3412;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="dispute closed — reserved" style="dashed=1;strokeColor=#9a3412;fontColor=#9a3412;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="150"/></Array></mxGeometry></mxCell><mxCell id="c17" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="833" y="244" width="24" height="24" as="geometry"/></mxCell><mxCell id="18" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The sandbox gateway answers synchronously, so Sent is transient in the demo; a real provider would hold Sent until its callback.&lt;br&gt;• Disputed is allowed by the CHECK constraint but not written by any code on develop (documented gap, CS-85 review)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1200" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="disbursement_tranche.status" id="disbursement_tranche_status"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 4.13 – State Machine Diagram – disbursement_tranche.status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;Version 2.0 · 22/10/2026 · UML 2.5 · states = CHECK constraint values · label = trigger [guard] / effect · module: Payments (Thiện) · created by Batches (Viên)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#64748b&quot;&gt;&lt;b&gt;Source:&lt;/b&gt; BatchReviewService.ApproveAsync (create) · DisbursementsController.RequestTranche/Release/NeedExplanation/Block → DisbursementService&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeC