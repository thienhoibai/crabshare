kgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="approve (Admin) / lock Standard Cost, fee&lt;br&gt;tier, batch account, tranches Planned,&lt;br&gt;funding_open_at &amp; deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="capital reaches max or deadline [confirmed ≥&lt;br&gt;min_viable_capital] / capital_share&lt;br&gt;snapshot, capital_closed_at&lt;br&gt;(FundingCloseService)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;exitX=0.75;exitY=0;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="funding deadline [confirmed &lt;&lt;br&gt;min_viable_capital] / refund every Confirmed&lt;br&gt;contribution, void unsigned contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="record stocking (Operator Owner)&lt;br&gt;[FundingReadiness: capital closed, confirmed&lt;br&gt;sum = total, every contract FullySigned,&lt;br&gt;count = seed_quantity, boxes Available] /&lt;br&gt;boxes Occupied, crab_item Growing per box,&lt;br&gt;stocked_at" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="/ same transaction (Stocked is transient);&lt;br&gt;audit batch/stocked then&lt;br&gt;batch/start_production" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="start harvest (Operator Owner) [no Open&lt;br&gt;harvest session] / harvest Open,&lt;br&gt;harvest_started_at, audit&lt;br&gt;batch/start_harvest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="calculate settlement (Admin) [capital shares&lt;br&gt;exist, Locked cost exists] / settlement&lt;br&gt;Draft rev 1, audit batch/start_settlement" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="every investor line paid (Succeeded) /&lt;br&gt;closed_at, settlement PaidOut → Closed&lt;br&gt;(SettlementClosing.CloseIfPaidAsync)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry 