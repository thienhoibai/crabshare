tockMonitor, CaptureRequestJob) · AlertsController.Acknowledge · AlertJobWorker (15 min) → AlertJob.RunAsync · AdminAlertsController.Resolve&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Acknowledged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c6" value="Escalated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="170" height="54" as="geometry"/></mxCell><mxCell id="c7" value="Resolved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="145" width="24" height="24" as="geometry"/></mxCell><mxCell id="9" value="raise [no Open/Escalated alert&lt;br&gt;of the same batch + type] /&lt;br&gt;ack_deadline = now +&lt;br&gt;ackWithin; types Mortality,&lt;br&gt;WaterQuality, MilestoneDelay,&lt;br&gt;LowStock, DataSilence,&lt;br&gt;EvidenceFlag" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" t