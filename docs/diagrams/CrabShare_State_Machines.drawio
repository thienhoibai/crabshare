it&lt;br&gt;CreateCaptureRequest" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="evidence upload with captureRequestId&lt;br&gt;(Operator) [captured_at within&lt;br&gt;[requested_at, due_at], result not Flagged]&lt;br&gt;/ fulfilled_at, audit FulfillCaptureRequest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="Flagged upload linked / request stays Open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;exitX=0.75;exitY=0;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="job [due_at &lt; now] / audit&lt;br&gt;ExpireCaptureRequest; alert EvidenceFlag&lt;br&gt;(Medium, ack 2 h)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="493" y="244" width="24" height="24" as="geometry"/></mxCell><mxCell id="13" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c12"><mxG