 label = trigger [guard] / effect · module: Payments (Thiện)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#64748b&quot;&gt;&lt;b&gt;Source:&lt;/b&gt; PaymentRequestService.CreateAsync · PaymentWebhookService.ProcessAsync · FundingCloseService / ReservationExpiryService · cancel paths&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Pending" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#eef2ff;strokeColor=#3730a3;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Paid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="170" height="54" as="geometry"/></mxCell><mxCell id="c6" value="Expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="170" height="54" as="geometry"/></mxCell><mxCell id="c7" value="Cancelled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="170" height="54" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="145" width="24" height="24" as="geometry"/></mxCell><mxCell id="9" value="create [purpose Contribution |&lt;br&gt;OrderPayment | PreOrderDeposit&lt;br&gt;| PreOrderBalance |&lt;br&gt;OfftakeDeposit |&lt;br&gt;OfftakePayment] / VietQR via&lt;br&gt;IPaymentGateway, reference&lt;br&gt;code, expires_at" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="webhook received [provider_txn_id new,&lt;br&gt;account &amp; amount match, before expires_at] /&lt;br&gt;provider_transaction Matched;&lt;br&gt;IPaymentPurposeHandler.OnPaidAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="after(expires_at) [job: FundingClose,&lt;br&gt;ReservationExpiry] / audit&lt;br&gt;payment_request/expire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="contribution cancelled or order cancelled /&lt;br&gt;audit payment_request/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="493" y="244" width="24" height="24" as="geometry"/></mxCell><mxCell id="14" value="" style="rounded=1;html=1;