ed_at — else 422&lt;br&gt;tranche.not_eligible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="release (Admin) [gate re-checked, released&lt;br&gt;total ≤ total_confirmed_capital] /&lt;br&gt;Disbursement instruction Created,&lt;br&gt;released_at" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="need-explanation (Admin) /&lt;br&gt;explanation_deadline = now + 72 h" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="release (Admin) [explanation accepted]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="block (Admin) / reason" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="block (Admin) [deadline passed or&lt;br&gt;explanation rejected] / reason" style="edgeStyle=orthogonalEdgeStyle;rou