;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="answer (Admin) [unresolved = false] /&lt;br&gt;response, responded_at" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="answer (Admin) [unresolved = true] /&lt;br&gt;response recorded, disagreement kept in&lt;br&gt;statement" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="withdraw (Investor) — reserved, no code path&lt;br&gt;yet" style="dashed=1;strokeColor=#9a3412;fontColor=#9a3412;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="493" y="244" width="24" height="24" as="geometry"/></mxCell><mxCell id="14" value="" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;edgeStyle=none;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" v