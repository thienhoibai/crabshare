" as="geometry"/></mxCell><mxCell id="15" value="verdict Fail (Reviewer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="verdict NeedMoreEvidence (Reviewer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="verdict Pass (Reviewer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="40"/><mxPoint x="160" y="40"/></Array></mxGeometry></mxCell><mxCell id="18" value="verdict Fail (Reviewer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="explanation (Operator) / explained_at&lt;br&gt;re-opens review for the reviewer who asked&lt;br&gt;for more" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=10;fontFamily=Segoe UI;exitX=0.75;exitY=0;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="ellipse;html=1;shape=endState;fillColor=#0