<mxfile host="CrabShare-generator" modified="2026-11-04T20:21:43.777Z" agent="crabshare-drawio-gen" version="24.7.17" type="device"><diagram name="LV0 – Overview" id="LV0___Overview"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Figure 2.1 – Use Case Diagram: LV0 system overview (50 use cases in 5 subsystems, Register v1.4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748b&quot;&gt;v3.2 · 05/11/2026 · Register v1.4&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="46" as="geometry"/></mxCell><mxCell id="c3" value="CrabShare System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e293b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="86" width="480" height="925" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SD1 · Identity &amp; Onboarding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UC01–UC06 · 6 UCs · Figure 2.2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UC01 · UC02 · UC03 · UC04 · UC05 · UC06&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=14;tabWidth=60;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="340" height="93" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;SD4 · Sales &amp; Orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UC25–UC34, UC50–UC51, UC54–UC55 · 13 UCs · F