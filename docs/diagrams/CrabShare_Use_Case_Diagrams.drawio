</mxCell><mxCell id="9" value="&lt;font style=&quot;font-size:9px&quot;&gt;UC44 Register Boxes&lt;br&gt;UC17 Record Production Logs and Box Events&lt;br&gt;UC21 View Production Timeline&lt;br&gt;UC45 Capture Production Evidence&lt;br&gt;UC47 Review Flagged Evidence&lt;br&gt;UC48 Submit Evidence Explanation&lt;br&gt;UC19 Acknowledge Operations Alert&lt;br&gt;UC20 Monitor Escalated Alerts&lt;br&gt;UC18 Request Milestone Disbursement&lt;br&gt;UC22 Declare Harvest&lt;br&gt;UC46 Print and Activate Crab Tag&lt;br&gt;UC23 Claim Priority Offtake Volume&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="896" y="170" width="225" height="160" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SD4 · Sales &amp; Orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC24–UC34 · 11 use cases&lt;/font&gt;" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=60;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="370" width="235" height="190" as="geometry"/></mxCell><mxCell id="11" value="&lt;font style=&quot;font-size:9px&quot;&gt;UC24 Publish Product Listings&lt;br&gt;UC25 Browse Product Catalogue&lt;br&gt;UC26 Place Order&lt;br&gt;UC27 Place Pre-order (deposit)&lt;br&gt;UC28 Track Order Status&lt;br&gt;UC29 Fulfil Order by Tag Scan&lt;br&gt;UC30 Confirm Order Receipt&lt;br&gt;UC31 Submit Order Complaint&lt;br&gt;UC32 Resolve Order Dispute&lt;br&gt;UC33 Trace Crab by Tag Scan&lt;br&gt;UC34 Rate Purchase&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="366" y="400" width="225" height="160" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SD5 · Settlement &amp; Oversight&lt;/b&g