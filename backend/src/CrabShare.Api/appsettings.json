{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "crabshare-api",
    "Audience": "crabshare-clients",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "Origins": []
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Alerts": {
    "Thresholds": {
      "PhMin": 7.5,
      "PhMax": 8.5,
      "WaterTempMinC": 25,
      "WaterTempMaxC": 32,
      "SalinityMinPpt": 10,
      "SalinityMaxPpt": 30,
      "MortalityPercent": 5,
      "LowStockKg": 10
    }
  },
  "Seed": {
    "Enabled": false
  }
}
